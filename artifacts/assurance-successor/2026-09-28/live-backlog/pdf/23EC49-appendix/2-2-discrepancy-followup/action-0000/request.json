  "response_contract": "Return only one JSON object conforming exactly to response_schema. Do not rename fields or add metadata keys. Retain substantive uncertainty using the permitted fields and enum values.",
  "response_schema": {
    "$defs": {
      "RegionJudgment": {
        "additionalProperties": false,
        "properties": {
          "affected_condition": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Affected Condition"
          },
          "disposition": {
            "enum": [
              "VISIBLE_TYPOGRAPHIC_DIFFERENCE",
              "VISIBLE_MISSING_OR_CHANGED_TEXT",
              "LAYOUT_RELATION_UNCERTAIN",
              "UNREADABLE_OR_UNCERTAIN"
            ],
            "title": "Disposition",
            "type": "string"
          },
          "explanation": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Explanation",
            "type": "string"
          },
          "issue_id": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "title": "Issue Id",
            "type": "string"
          },
          "printed_text": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Printed Text",
            "type": "string"
          }
        },
        "required": [
          "issue_id",
          "disposition",
          "printed_text",
          "explanation",
          "affected_condition"
        ],
        "title": "RegionJudgment",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "judgments": {
        "items": {
          "$ref": "#/$defs/RegionJudgment"
        },
        "maxItems": 12,
        "minItems": 1,
        "title": "Judgments",
        "type": "array"
      },
      "remaining_questions": {
        "items": {
          "maxLength": 20000,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 20,
        "title": "Remaining Questions",
        "type": "array"
      }
    },
    "required": [
      "judgments",
      "remaining_questions"
    ],
    "title": "RegionBatch",
    "type": "object"
  },
