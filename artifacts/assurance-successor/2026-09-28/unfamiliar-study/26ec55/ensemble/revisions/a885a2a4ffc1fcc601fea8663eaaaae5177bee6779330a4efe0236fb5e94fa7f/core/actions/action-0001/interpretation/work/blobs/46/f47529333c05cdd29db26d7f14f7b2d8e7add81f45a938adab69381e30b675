dd852cee.u39.5617"}],"exceptions":["Product risk rating is qualified by 'if applicable'."],"kind":"OBLIGATION","modality":"SHOULD","readers":[{"local_id":"c17","role":"qualification-reader"}],"relevance":"CONTROL","statement":"Managers should select appropriate distributors with knowledge of the Fund, including its complex-product status, and ability to assign an appropriate risk rating where applicable and advise investors accordingly.","temporal":[],"uncertainty":[]},{"action":"Review existing funds","actor":"Fund managers","claim_id":"claim.497fdb6622cd3d404911cd15","conditions":["Existing SFC-authorised funds may have direct or indirect private-market exposure."],"evidence":[{"quote":"For existing SFC-authorised funds that may have direct or indirect exposure to private market assets, fund managers are expected to undertake a review of their funds","unit_id":"d4148dd852cee.u49.6955"}],"exceptions":["LAF scope exclusion."],"kind":"OBLIGATION","modality":"SHOULD","readers":[{"local_id":"c18","role":"qualification-reader"}],"relevance":"CONTROL","statement":"Managers are expected to review existing covered funds that may have private-market exposure; existing authorisation does not establish an exemption from this guidance.","temporal":["Existing SFC-authorised funds."],"uncertainty":[]},{"action":"Take appropriate action and update offering documents","actor":"Fund managers of existing covered funds","claim_id":"claim.a1e997fc60c27a3a04976a4a","conditions":["Existing funds may have direct or indirect private-market exposure."],"evidence":[{"quote":"take appropriate actions including updating the Fund’s offering documents as soon as practicable","unit_id":"d4148dd852cee.u49.6955"}],"exceptions":[],"kind":"TIME","modality":"SHOULD","readers":[{"local_id":"c19","role":"qualification-reader"}],"relevance":"CONTROL","statement":"Managers are expected to take appropriate action, including updating offering documents as soon as practicable.","temporal":["As soon as practicable for updating offering documents."],"uncertainty":["This wording supplies no fixed implementation date or express classification grace period."]},{"action":"Communicate with distributors","actor":"Fund managers of existing covered funds","claim_id":"claim.33f9ccb3cfec53820965f722","conditions":["Existing funds may have direct or indirect private-market exposure."],"evidence":[{"quote":"ensure necessary and proper communications with the distributors in light of the guidance provided under this circular (in particular, with respect to paragraphs 9 and 10 above).","unit_id":"d4148dd852cee.u49.6955"}],"exceptions":[],"kind":"OBLIGATION","modality":"SHOULD","readers":[{"local_id":"c20","role":"qualification-reader"}],"relevance":"CONTROL","statement":"Managers are expected to ensure necessary and proper distributor communications in light of the circular, particularly its paragraphs 9 and 10.","temporal":[],"uncertainty":["The supplied units do not display paragraph numbering sufficient to verify the exact paragraph 9 and 10 mapping."]},{"action":"Consult SFC about classification doubt","actor":"Fund managers","claim_id":"claim.e97a5ab05dba08850901077d","conditions":["In doubt regarding their Funds' complex-product classification."],"evidence":[{"quote":"Fund managers are encouraged to consult the SFC at the earliest opportunity if they are in doubt regarding complex product classification of their Funds.","unit_id":"d4148dd852cee.u49.6955"}],"exceptions":[],"kind":"OBLIGATION","modality":"SHOULD","readers":[{"local_id":"c21","role":"qualification-reader"}],"relevance":"CONTROL","statement":"Managers are encouraged, rather than expressly required, to consult the SFC promptly when classification is uncertain.","temporal":["At the earliest opportunity."],"uncertainty":["No default classification for missing evidence or pending consultation is supplied."]},{"action":"Apply direct-investment limit","actor":"Covered Funds","claim_id":"claim.7d8dee41528186a056fb4c5f","conditions":["Direct investments in or exposures to private assets."],"evidence":[{"quote":"Direct investments in/exposures to private assets fall within the investment limit of 15% of a Fund’s total net asset value (NAV) under 7.3 of the Code on Unit Trusts and Mutual Funds (UT Code).","unit_id":"d4148dd852cee.u58.7778"}],"exceptions":[],"kind":"DEPENDENCY","modality":"MUST","readers":[{"local_id":"c22","role":"qualification-reader"}],"relevance":"CONTROL","statement":"Direct private-asset investments or exposures fall within the 15% NAV investment limit under UT Code section 7.3. This is distinct from the 50% combined-exposure classification threshold.","temporal":[],"uncertainty":["The full section 7.3 provision is not supplied."]},{"action":"Describe BDCs","actor":"Circular","claim_id":"claim.a7f7ba358f7b8f4aadc66d7f","conditions":[],"evidence":[{"quote":"BDCs are close-ended funds registered under the US Investment Company Act of 1940, which primarily invest in debt and equity of small and mid-sized companies in the US.","unit_id":"d4148dd852cee.u60.8163"}],"exceptions":[],"kind":"DEFINITION","modality":"DESCRIPTIVE","readers":[{"local_id":"c23","role":"qualification-reader"}],"relevance":"CONTROL","statement":"The circular describes BDCs as US Investment Company Act of 1940-registered close-ended funds primarily investing in debt and equity of small and mid-sized US companies.","temporal":[],"uncertainty":[]},{"action":"Describe CLOs","actor":"Circular","claim_id":"claim.01925f8d5a24687b8c662d14","conditions":[],"evidence":[{"quote":"CLOs are securities backed by a pool of debt, typically leveraged loans and broadly syndicated loans, or direct lending to unlisted companies.","unit_id":"d4148dd852cee.u61.8338"}],"exceptions":[],"kind":"DEFINITION","modality":"DESCRIPTIVE","readers":[{"local_id":"c24","role":"qualification-reader"}],"relevance":"CONTROL","statement":"CLOs are debt-pool-backed securities, typically involving leveraged loans, broadly syndicated loans or direct lending to unlisted companies.","temporal":[],"uncertainty":[]}],"missing_dependencies":["missing.7b393f53d503773a762cf757","missing.de6722b4a9f08d782e48c11a","missing.13ee048eabca24d91ac9305c"],"node_id":"node.65050459a1ce3ffe5cff6887","retained_uncited_units":[{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 5:555","normative":true,"span":{"end":555,"id":"s.d4148dd852cee.u1.5","page":1,"quote_sha256":"600cea5ef212760b364730a35d9eb64c2be1d600f487a2c0b24f24f18cc4a593","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":5,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"The Securities and Futures Commission (SFC) has observed that investment funds may, for asset allocation and yield enhancement purposes, gain exposure to private credit and private equity (collectively, private market assets) via: direct exposure through investments in bank or non-bank direct lending in the form of loans or equities to unlisted companies (direct exposure)1; or indirect exposures2 including through investments in business development companies (BDCs)3, collateralised loan obligations (CLOs)4 or financial derivative instruments5.","unit_id":"d4148dd852cee.u1.5"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 1028:1928","normative":true,"span":{"end":1928,"id":"s.d4148dd852cee.u7.1028","page":1,"quote_sha256":"000997a593b67d38bb2f0dfb4b6bcdad0ef8827778075d340c0a3765c22529e1","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":1028,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"Direct investment in private market assets generally carries higher inherent risks than publicly listed securities, as these assets are typically illiquid, hard to value, and subject to limited regulatory oversight; they also have higher credit risks and thus higher risk of default. While indirect exposures to the private market assets may not present the same level of risk as direct investments, recent market developments have raised concerns about these indirect exposures, such as the rising default risks of underlying investments for private credit funds, widening price-to-NAV discount for listed BDCs, etc. In addition, certain indirect exposures may lack transparency about the underlying private market assets, as they involve layered structures or complex financial instruments such that retail investors may not reasonably understand the features and risks of these indirect exposures.","unit_id":"d4148dd852cee.u7.1028"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 1937:2462","normative":true,"span":{"end":2462,"id":"s.d4148dd852cee.u10.1937","page":1,"quote_sha256":"df2d22253f1deca334f7e5b69cc7a760f91a8a3d81eccddb0e5c0552e60dd419","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":1937,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"Considering that retail investors in Hong Kong may have limited familiarity with private market assets and their associated risks, fund managers should ensure that investors are provided with a clear, sufficiently complete and balanced picture of the characteristics, nature and extent of risks associated with various types of exposures a Fund may have to private market assets. Fund managers should also, among other things, ensure that the distributors chosen are appropriate for covering the target market of their Funds.","unit_id":"d4148dd852cee.u10.1937"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 2466:2507","normative":true,"span":{"end":2507,"id":"s.d4148dd852cee.u11.2466","page":1,"quote_sha256":"65f873864351bcf02f5136beb2df8209fa98c7bfccfe72daf5638dc6af69a0b7","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":2466,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"Enhanced disclosure in offering documents","unit_id":"d4148dd852cee.u11.2466"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 2516:2714","normative":true,"span":{"end":2714,"id":"s.d4148dd852cee.u14.2516","page":1,"quote_sha256":"f87a7ece235ce425e7c34c4d7a445dffbb62055f27c0baa0df00db163562601a","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":2516,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"If a Fund may have direct or indirect exposure to private market assets, its fund manager should ensure that the Fund’s offering document (including the key facts statement (KFS)) clearly discloses:","unit_id":"d4148dd852cee.u14.2516"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 2718:2991","normative":true,"span":{"end":2991,"id":"s.d4148dd852cee.u15.2718","page":1,"quote_sha256":"e5bb6d2bff489439e3280e594b54a336d4935d5d62aecb4af87c36d390262f46","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":2718,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"(i)        the extent and the means of access of exposure (eg, up to [x]% of the Fund’s NAV is invested in listed BDCs which primarily invest in private market assets; [x – y%] of the Fund’s NAV will gain exposure to private loans via investment in senior tranche of CLOs);","unit_id":"d4148dd852cee.u15.2718"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 2995:3219","normative":true,"span":{"end":3219,"id":"s.d4148dd852cee.u16.2995","page":1,"quote_sha256":"b6757c15beaf52a4b636baecee09d63c2a5976eeafbdba8ebef1faa75349df6b","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":2995,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"(ii)       the nature and characteristics of the underlying private market assets (eg, the minimum credit rating of the CLOs in which the Fund invests, TRSs on an index comprising unsecuritised broadly syndicated loans); and","unit_id":"d4148dd852cee.u16.2995"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 3223:3739","normative":true,"span":{"end":3739,"id":"s.d4148dd852cee.u17.3223","page":1,"quote_sha256":"b26f3bd1a3c0b0d312b41595a8623ae8e35922c567b62c6a2ddc57d22b2cac37","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":3223,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"(iii)      in the offering documents (and where appropriate, the KFS), the key risks associated with the Fund’s exposure to the specific types of private market assets it directly or indirectly invests in, including the impact and implications to the Fund and its investors (e.g. the limited liquidity and lack of transparency of the underlying private market assets of the BDCs can make them more challenging to value, and these valuation uncertainties may negatively impact the BDC’s NAV and hence the Fund’s NAV).","unit_id":"d4148dd852cee.u17.3223"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 3743:3770","normative":true,"span":{"end":3770,"id":"s.d4148dd852cee.u18.3743","page":1,"quote_sha256":"e80c39d4959b49004ef67bfeb3140af9135d8d9ccd2257342f4ab21d91dee3f1","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":3743,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"Complex product designation","unit_id":"d4148dd852cee.u18.3743"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 4078:4168","normative":true,"span":{"end":4168,"id":"s.d4148dd852cee.u22.4078","page":1,"quote_sha256":"f3ee1d7dad8976179add372f55060c71c672821730cd896668e79ac4e929eb57","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":4078,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"•        the aggregate direct and indirect exposures to private market assets of the Fund;","unit_id":"d4148dd852cee.u22.4078"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 4176:4282","normative":true,"span":{"end":4282,"id":"s.d4148dd852cee.u24.4176","page":1,"quote_sha256":"0c86bbe0b11efe5d063e6dc17c53f5054bde551461a003cfb2dc2adff846bd4a","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":4176,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"•        the Fund's overall investment strategy, portfolio composition, and liquidity and/or risk profile;","unit_id":"d4148dd852cee.u24.4176"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 4290:4497","normative":true,"span":{"end":4497,"id":"s.d4148dd852cee.u26.4290","page":1,"quote_sha256":"5eea0abb21a5d844ab60a8b304614d332db25e752047b4186b0b9073d03ce0dc","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":4290,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"•        the extent, nature and characteristics of the specific asset types in which the Fund invests (eg, the tranches and credit ratings of CLOs; the structure, tranches and underlying assets of SRTs); and","unit_id":"d4148dd852cee.u26.4290"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 4505:4626","normative":true,"span":{"end":4626,"id":"s.d4148dd852cee.u28.4505","page":1,"quote_sha256":"5edeccb1cc1260c4fe7d1d44de66a3e3fbd0989d9ef1e659040f4ac002edafb8","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":4505,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"•        any distribution restrictions, requirements or other conditions as may be imposed by the Fund’s home regulators.","unit_id":"d4148dd852cee.u28.4505"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 5086:5140","normative":true,"span":{"end":5140,"id":"s.d4148dd852cee.u33.5086","page":1,"quote_sha256":"aab84c0f20b4eceaf839f4bd5d1b1a00b2d45b22cca13d57457d866ba0c28195","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":5086,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"Target market identification and distributor selection","unit_id":"d4148dd852cee.u33.5086"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 5149:5608","normative":true,"span":{"end":5608,"id":"s.d4148dd852cee.u36.5149","page":1,"quote_sha256":"7263549aa53fca0b8b899875aa0722676e3d45a3b1908862aef9c6ca2dadb596","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":5149,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"The SFC wishes to remind fund managers to observe the requirements set out in the “Circular to Product Providers of SFC-authorized unit trusts and mutual funds, SFC-authorized investment-linked assurance schemes and SFC-authorized unlisted structured investment products – Guidance on Internal Product Approval Process”9, which outlines, among others, the requirements regarding target market identification and distributor selection for SFC-authorised funds.","unit_id":"d4148dd852cee.u36.5149"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 5617:6266","normative":true,"span":{"end":6266,"id":"s.d4148dd852cee.u39.5617","page":1,"quote_sha256":"f679bbe91887d2e0b555b914a90df586476ef45b143d90d4876785a343e90af5","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":5617,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"Fund managers should carefully identify the target market to ensure that the Fund, including its underlying investments and associated risks, would be generally understood by the target market and that the Fund’s investment objectives and risk/return profile match the needs and risk appetite of the target market. They should also ensure that the distributors chosen are appropriate for covering the target market identified, have the necessary product knowledge to understand the Fund (including whether the Fund is a complex product) and to assign an appropriate product risk rating (if applicable) for the Fund, and advise investors accordingly.","unit_id":"d4148dd852cee.u39.5617"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 6275:6649","normative":true,"span":{"end":6649,"id":"s.d4148dd852cee.u42.6275","page":1,"quote_sha256":"c887c86d7a6cc82b4d90c5ba1bbeab5feca238c9b7095a020cb07b2ee186a2be","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":6275,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"Fund managers are further reminded that the marketing materials of SFC-authorised funds must comply with the Advertising Guidelines Applicable to Collective Investment Schemes Authorized under the Product Codes10, which provide, among other requirements, that advertisements of a Fund should be fair and present a balanced picture of the Fund with adequate risk disclosures.","unit_id":"d4148dd852cee.u42.6275"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 6653:6659","normative":true,"span":{"end":6659,"id":"s.d4148dd852cee.u43.6653","page":1,"quote_sha256":"ebdad9ba4c5e3ce0078ad8e8fb31e4c76176834cd2370f05bd043e4baf8d6c5a","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":6653,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"Others","unit_id":"d4148dd852cee.u43.6653"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 6668:6946","normative":true,"span":{"end":6946,"id":"s.d4148dd852cee.u46.6668","page":1,"quote_sha256":"3ddbf442e621eca7c09269930570d6668627239fdc599650d3a93df4c17e9b58","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":6668,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"When seeking the SFC’s authorisation for any new funds that may have direct or indirect exposure to private market assets, the fund may be subject to the SFC’s closer scrutiny. In some cases, the SFC may not process the fund under the Fund Authorisation Simple Track (FASTrack).","unit_id":"d4148dd852cee.u46.6668"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 7565:7684","normative":true,"span":{"end":7684,"id":"s.d4148dd852cee.u52.7565","page":1,"quote_sha256":"a205fa8df5df9862415ad1d62500908b42d886948b0fc55672aa9cac780fbd46","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":7565,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"If you wish to seek clarification of any aspects of this circular, please contact the relevant case officers in charge.","unit_id":"d4148dd852cee.u52.7565"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 7698:7726","normative":true,"span":{"end":7726,"id":"s.d4148dd852cee.u55.7698","page":1,"quote_sha256":"2262a17aa8ece28244aedc22e1f37fce7075bbeb018d04e4b3b36c1c9d0199ce","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":7698,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"Investment Products Division","unit_id":"d4148dd852cee.u55.7698"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 7736:7769","normative":true,"span":{"end":7769,"id":"s.d4148dd852cee.u56.7736","page":1,"quote_sha256":"88e2bc94e9edc39f2ac1cdaaea86b44ab5ea59b31c446f69591f21bf460b005e","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":7736,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"Securities and Futures Commission","unit_id":"d4148dd852cee.u56.7736"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 7778:7974","normative":true,"span":{"end":7974,"id":"s.d4148dd852cee.u58.7778","page":1,"quote_sha256":"993e920b4fdde484f5649bf5273324d9a3d0a19c54930505af8bf6b2de5b1fa4","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":7778,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"1 Direct investments in/exposures to private assets fall within the investment limit of 15% of a Fund’s total net asset value (NAV) under 7.3 of the Code on Unit Trusts and Mutual Funds (UT Code).","unit_id":"d4148dd852cee.u58.7778"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 7979:8158","normative":true,"span":{"end":8158,"id":"s.d4148dd852cee.u59.7979","page":1,"quote_sha256":"f2072cfba660bad4786ea8d85d5156b5ec263cd4739922b716a6c13008f29643","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":7979,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"2 The examples of indirect exposures set out in paragraph 1 above are non-exhaustive, and subject to review and update by the SFC from time to time in view of market developments.","unit_id":"d4148dd852cee.u59.7979"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 8163:8333","normative":true,"span":{"end":8333,"id":"s.d4148dd852cee.u60.8163","page":1,"quote_sha256":"8b6da1bcb3c06ea3c272d9e9638cb59b5d2839f45558a34a90a8da3bc00b3b97","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":8163,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"3 BDCs are close-ended funds registered under the US Investment Company Act of 1940, which primarily invest in debt and equity of small and mid-sized companies in the US.","unit_id":"d4148dd852cee.u60.8163"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 8338:8482","normative":true,"span":{"end":8482,"id":"s.d4148dd852cee.u61.8338","page":1,"quote_sha256":"3a213d70edb471ba138127b02b6e5d8002511224948fbbc1bb81d1bad8c3b5f2","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":8338,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"4 CLOs are securities backed by a pool of debt, typically leveraged loans and broadly syndicated loans, or direct lending to unlisted companies.","unit_id":"d4148dd852cee.u61.8338"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 8487:8686","normative":true,"span":{"end":8686,"id":"s.d4148dd852cee.u62.8487","page":1,"quote_sha256":"b27e41864de598834dd1ec89777e83e73906a395dea432fb5a2456b6f952e467","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":8487,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"5 For example, Total Return Swaps on indices with exposure to leveraged loans or broadly syndicated loans (TRSs), or Significant Risk Transfers with underlying assets that are corporate loans (SRTs).","unit_id":"d4148dd852cee.u62.8487"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 9044:9299","normative":true,"span":{"end":9299,"id":"s.d4148dd852cee.u65.9044","page":1,"quote_sha256":"9ca08a544160df2030cf1e630fd6126d41f6da848ca7f8e70b81dd1330f4fae8","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":9044,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"8 Paragraph 5.5 of the SFC’s Code of Conduct for Persons Licensed by or Registered with the Securities and Futures Commission and Chapter 6 of the SFC’s Guidelines on Online Distribution and Advisory Platforms, and the relevant Frequently Asked Questions.","unit_id":"d4148dd852cee.u65.9044"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC55 chars 9304:9504","normative":true,"span":{"end":9504,"id":"s.d4148dd852cee.u66.9304","page":1,"quote_sha256":"317064812f348e9ab6464a050589a01364293a4172c91fd379ed15af4397dd8b","raw_sha256":"7bb927fa9442eaaf0f98d0e236c3899b86db10cfcd635879bbccf8bd45a20d1c","source_id":"d4148dd852cee","start":9304,"text_sha256":"cff1139c8cfb97e3e6b3e59caae8de37328dd835dc65a207afbd6b6dbe01ffc6"},"text":"9 Issued by the SFC on 30 April 2014 and