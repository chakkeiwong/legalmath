    "actions": [
      {
        "sequence": 0,
        "spec": {
          "stage": "judgment",
          "inputs": {
            "request": {
              "task": "SOURCE_AUTHORITY_ARGUMENTS",
              "source_packet": {
                "authority": "RETAINED_SOURCE",
                "dependencies": [
                  {
                    "dependency_id": "missing.1c25ffdf5c1e10e0297748d5",
                    "source_hash": null
