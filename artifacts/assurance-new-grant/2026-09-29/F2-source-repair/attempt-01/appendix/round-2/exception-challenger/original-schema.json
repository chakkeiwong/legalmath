{
  "$defs": {
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Unit Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "quote"
      ],
      "title": "Quote",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "question_id": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Question Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "EXPLICIT_SOURCE_ANSWER_PROPOSED",
        "PARTIAL_SOURCE_SUPPORT",
        "NOT_ESTABLISHED"
      ],
      "title": "Status",
      "type": "string"
    },
    "proposition": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Proposition",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Quote"
      },
      "maxItems": 12,
      "title": "Evidence",
      "type": "array"
    },
    "missing_premises": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Missing Premises",
      "type": "array"
    },
    "alternative_readings": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Alternative Readings",
      "type": "array"
    },
    "next_source_questions": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Next Source Questions",
      "type": "array"
    }
  },
  "required": [
    "question_id",
    "status",
    "proposition",
    "evidence",
    "missing_premises",
    "alternative_readings",
    "next_source_questions"
  ],
  "title": "RevisionAnswer",
  "type": "object"
}
