          "title": "Status",
          "type": "string"
        },
        "question_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Question Hash",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Quote"
