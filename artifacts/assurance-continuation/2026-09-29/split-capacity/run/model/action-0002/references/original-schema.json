{
  "$defs": {
    "Concern": {
      "additionalProperties": false,
      "properties": {
        "concern_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Concern Id",
          "type": "string"
        },
        "question_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Question Ids",
          "type": "array"
        },
        "related_unit_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Related Unit Ids",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "explanation": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "concern_id",
        "question_ids",
        "related_unit_ids",
        "evidence",
        "explanation"
      ],
      "title": "Concern",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Unit Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "quote"
      ],
      "title": "Quote",
      "type": "object"
    },
    "UnitCoverage": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Unit Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "QUESTIONS",
            "CONTEXT",
            "UNRESOLVED"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "question_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Question Ids",
          "type": "array"
        },
        "related_unit_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Related Unit Ids",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "disposition",
        "question_ids",
        "related_unit_ids",
        "evidence",
        "rationale"
      ],
      "title": "UnitCoverage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "packet_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Packet Hash",
      "type": "string"
    },
    "interpretation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Interpretation Hash",
      "type": "string"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/UnitCoverage"
      },
      "maxItems": 40,
      "minItems": 1,
      "title": "Units",
      "type": "array"
    },
    "concerns": {
      "items": {
        "$ref": "#/$defs/Concern"
      },
      "maxItems": 40,
      "title": "Concerns",
      "type": "array"
    }
  },
  "required": [
    "packet_hash",
    "interpretation_hash",
    "units",
    "concerns"
  ],
  "title": "Coverage",
  "type": "object"
}
