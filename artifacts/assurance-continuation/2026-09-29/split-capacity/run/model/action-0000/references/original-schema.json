        "control_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "question": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "unit_of_assessment": {
          "maxLength": 20000,
          "minLength": 1,
