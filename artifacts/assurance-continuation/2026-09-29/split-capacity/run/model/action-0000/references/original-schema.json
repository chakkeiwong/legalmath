          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "temporal_basis": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Temporal Basis",
          "type": "string"
        },
        "result_kind": {
          "enum": [
            "REQUIREMENT_APPLIES",
            "REQUIREMENT_SATISFIED",
            "PROHIBITED",
            "COMPLIANT",
            "DUTY_TRIGGER",
            "DUTY_STATE",
            "CLASSIFICATION"
