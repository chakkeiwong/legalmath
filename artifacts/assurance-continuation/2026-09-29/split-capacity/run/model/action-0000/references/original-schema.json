          "maxItems": 12,
          "minItems": 1,
          "title": "Source Evidence",
          "type": "array"
        }
      },
      "required": [
        "control_id",
        "question",
        "unit_of_assessment",
        "actor",
        "temporal_basis",
        "result_kind",
        "true_means",
        "false_means",
        "source_evidence"
