# Declared factual interface
> Using Integer_en as Integer
> Using Decimal_en as Decimal
> Using Date_en as Date
> Using List_en as List
```catala
declaration structure Meta:
  data s content integer
  data c content integer
  data refs content list of integer

declaration structure B0:
  data s content integer
  data c content integer
  data refs content list of integer
  data v content boolean

declaration structure B1:
  data s content integer
  data c content integer
  data refs content list of integer
  data v content integer

declaration scope SharedRule:
  input f0 content B0
  input f1 content B1
  input f2 content B0
  input f3 content B1
  output r0 content B1
  output r1 content B1
  output r2 content B1
```

```catala
scope SharedRule:
  definition r0 equals (let v1 equals B0 { -- s: 0 -- c: 0 -- refs: [] -- v: true } in (if v1.s = 0 then (if v1.v then (let v7 equals (let v2 equals f0 in (if v2.s = 0 then (let v3 equals (if v2.v then B1 { -- s: 0 -- c: 0 -- refs: [] -- v: (0) } else f1) in (let v6 equals (combine all v5 among [Meta { -- s: v2.s -- c: v2.c -- refs: v2.refs }; Meta { -- s: v3.s -- c: v3.c -- refs: v3.refs }] in v4 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v5.s > v4.s then v5.s else v4.s) -- c: (if v5.s > v4.s then v5.c else v4.c) -- refs: (v4.refs ++ v5.refs) }) in B1 { -- s: v6.s -- c: v6.c -- refs: v6.refs -- v: v3.v })) else B1 { -- s: v2.s -- c: v2.c -- refs: v2.refs -- v: (0) })) in (let v10 equals (combine all v9 among [Meta { -- s: v1.s -- c: v1.c -- refs: v1.refs }; Meta { -- s: v7.s -- c: v7.c -- refs: v7.refs }] in v8 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v9.s > v8.s then v9.s else v8.s) -- c: (if v9.s > v8.s then v9.c else v8.c) -- refs: (v8.refs ++ v9.refs) }) in B1 { -- s: v10.s -- c: v10.c -- refs: v10.refs -- v: v7.v })) else B1 { -- s: 4 -- c: v1.c -- refs: v1.refs -- v: (0) }) else B1 { -- s: v1.s -- c: v1.c -- refs: v1.refs -- v: (0) }))
  definition r1 equals (let v11 equals B0 { -- s: 0 -- c: 0 -- refs: [] -- v: true } in (if v11.s = 0 then (if v11.v then (let v12 equals f1 in (let v15 equals (combine all v14 among [Meta { -- s: v11.s -- c: v11.c -- refs: v11.refs }; Meta { -- s: v12.s -- c: v12.c -- refs: v12.refs }] in v13 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v14.s > v13.s then v14.s else v13.s) -- c: (if v14.s > v13.s then v14.c else v13.c) -- refs: (v13.refs ++ v14.refs) }) in B1 { -- s: v15.s -- c: v15.c -- refs: v15.refs -- v: v12.v })) else B1 { -- s: 4 -- c: v11.c -- refs: v11.refs -- v: (0) }) else B1 { -- s: v11.s -- c: v11.c -- refs: v11.refs -- v: (0) }))
  definition r2 equals (let v16 equals B0 { -- s: 0 -- c: 0 -- refs: [] -- v: true } in (if v16.s = 0 then (if v16.v then (let v22 equals (let v17 equals f2 in (if v17.s = 0 then (let v18 equals (if v17.v then f3 else B1 { -- s: 0 -- c: 0 -- refs: [] -- v: (0) }) in (let v21 equals (combine all v20 among [Meta { -- s: v17.s -- c: v17.c -- refs: v17.refs }; Meta { -- s: v18.s -- c: v18.c -- refs: v18.refs }] in v19 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v20.s > v19.s then v20.s else v19.s) -- c: (if v20.s > v19.s then v20.c else v19.c) -- refs: (v19.refs ++ v20.refs) }) in B1 { -- s: v21.s -- c: v21.c -- refs: v21.refs -- v: v18.v })) else B1 { -- s: v17.s -- c: v17.c -- refs: v17.refs -- v: (0) })) in (let v25 equals (combine all v24 among [Meta { -- s: v16.s -- c: v16.c -- refs: v16.refs }; Meta { -- s: v22.s -- c: v22.c -- refs: v22.refs }] in v23 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v24.s > v23.s then v24.s else v23.s) -- c: (if v24.s > v23.s then v24.c else v23.c) -- refs: (v23.refs ++ v24.refs) }) in B1 { -- s: v25.s -- c: v25.c -- refs: v25.refs -- v: v22.v })) else B1 { -- s: 4 -- c: v16.c -- refs: v16.refs -- v: (0) }) else B1 { -- s: v16.s -- c: v16.c -- refs: v16.refs -- v: (0) }))
```
