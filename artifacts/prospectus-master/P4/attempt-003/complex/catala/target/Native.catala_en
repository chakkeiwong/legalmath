# Declared factual interface
> Using Integer_en as Integer
> Using Decimal_en as Decimal
> Using Date_en as Date
> Using List_en as List
```catala
declaration structure Meta:
  data s content integer
  data c content integer
  data refs content list of integer

declaration structure B0:
  data s content integer
  data c content integer
  data refs content list of integer
  data v content boolean

declaration scope SharedRule:
  input f0 content B0
  input f1 content B0
  input f2 content B0
  input f3 content B0
  input f4 content B0
  output r0 content B0
```

```catala
scope SharedRule:
  definition r0 equals (let v1 equals B0 { -- s: 0 -- c: 0 -- refs: [] -- v: true } in (if v1.s = 0 then (if v1.v then (let v14 equals (let v9 equals f0 in (let v10 equals (let v2 equals f1 in (let v3 equals f2 in (let v4 equals f3 in (let v5 equals f4 in (let v8 equals (combine all v7 among [Meta { -- s: v2.s -- c: v2.c -- refs: v2.refs }; Meta { -- s: v3.s -- c: v3.c -- refs: v3.refs }; Meta { -- s: v4.s -- c: v4.c -- refs: v4.refs }; Meta { -- s: v5.s -- c: v5.c -- refs: v5.refs }] in v6 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v7.s > v6.s then v7.s else v6.s) -- c: (if v7.s > v6.s then v7.c else v6.c) -- refs: (v6.refs ++ v7.refs) }) in (if v8.s >= 2 then B0 { -- s: v8.s -- c: v8.c -- refs: v8.refs -- v: false } else if (v2.s = 0 and v2.v) or (v3.s = 0 and v3.v) or (v4.s = 0 and v4.v) or (v5.s = 0 and v5.v) then B0 { -- s: 0 -- c: 0 -- refs: v8.refs -- v: true } else if v8.s = 1 then B0 { -- s: v8.s -- c: v8.c -- refs: v8.refs -- v: false } else B0 { -- s: v8.s -- c: v8.c -- refs: v8.refs -- v: false })))))) in (let v13 equals (combine all v12 among [Meta { -- s: v9.s -- c: v9.c -- refs: v9.refs }; Meta { -- s: v10.s -- c: v10.c -- refs: v10.refs }] in v11 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v12.s > v11.s then v12.s else v11.s) -- c: (if v12.s > v11.s then v12.c else v11.c) -- refs: (v11.refs ++ v12.refs) }) in (if v13.s >= 2 then B0 { -- s: v13.s -- c: v13.c -- refs: v13.refs -- v: false } else if (v9.s = 0 and not v9.v) or (v10.s = 0 and not v10.v) then B0 { -- s: 0 -- c: 0 -- refs: v13.refs -- v: false } else if v13.s = 1 then B0 { -- s: v13.s -- c: v13.c -- refs: v13.refs -- v: false } else B0 { -- s: v13.s -- c: v13.c -- refs: v13.refs -- v: true })))) in (let v17 equals (combine all v16 among [Meta { -- s: v1.s -- c: v1.c -- refs: v1.refs }; Meta { -- s: v14.s -- c: v14.c -- refs: v14.refs }] in v15 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v16.s > v15.s then v16.s else v15.s) -- c: (if v16.s > v15.s then v16.c else v15.c) -- refs: (v15.refs ++ v16.refs) }) in B0 { -- s: v17.s -- c: v17.c -- refs: v17.refs -- v: v14.v })) else B0 { -- s: 4 -- c: v1.c -- refs: v1.refs -- v: false }) else B0 { -- s: v1.s -- c: v1.c -- refs: v1.refs -- v: false }))
