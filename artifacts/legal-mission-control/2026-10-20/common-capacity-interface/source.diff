+    c = warrant(p)
+    run(p, c)
+    (p.dispatch.directory/'warrant-p0/result.json').write_text('{}')
+    with pytest.raises(LegalMathError) as error:
+        run(p, c)
+    assert error.value.code == 'E_INTEGRITY'
+
