+"""Preserve and explicitly review every intervening adverse occurrence."""
+from copy import deepcopy
+from legalmath.canonical import digest
+from ..bounded_context import require
+from ..integration_contract import read_evidence
+from .context_disposition import answer_quote
+from .current_issue_disposition import SETTLED
+
+PROFILE = 'intervening-answer-issue-disposition.v1'
+
+
+def review_identity(predecessor):
+    # The complete review set can exceed the canonical single-object bound.
+    # Authenticate every ordered review separately, then bind their exact hashes.
+    return digest(dict(answer_hash=digest(predecessor['answer']),
+                       review_hashes=[digest(r) for r in predecessor['reviews']]))
+
+
+def census(predecessor):
+    rows = []
+    for i, review in enumerate(predecessor['reviews']):
+        if review.get('status') != 'VALIDATED' or review['value']['verdict'] != 'REJECT':
+            continue
+        require(review['value'].get('issues'), 'Adverse predecessor has no issue', 'E_INTEGRITY')
+        for j, issue in enumerate(review['value']['issues']):
+            rows.append(dict(id=str(i)+':issue-'+str(j), review_index=i,
+                             review_hash=digest(review), issue=issue))
+    return rows
+
+
+def validate(product, qid, question, candidate, predecessor, pointer, records):
+    value = read_evidence(pointer, product.root)
+    population = census(predecessor)
+    expected = dict(profile=PROFILE, question_id=qid, question_hash=digest(question),
+                    input_hash=product.route.input_hash, candidate_hash=digest(candidate),
+                    predecessor_review_identity=review_identity(predecessor), issue_population_hash=digest(population))
+    require(all(value.get(k) == v for k, v in expected.items()),
+            'Stale intervening issue disposition', 'E_INTEGRITY')
+    require(value.get('legal_acceptance') is False
+            and isinstance(value.get('reviewer'), str) and value['reviewer'].strip()
+            and read_evidence(value['review_note'], product.root, json_value=False).strip(),
+            'Missing intervening issue review', 'E_INTEGRITY')
+    for evidence in value.get('reviewed_evidence', []):
+        read_evidence(evidence, product.root, json_value=False)
+    rows = value.get('dispositions', [])
+    by_id = {r['id']: r for r in population}
+    require(len(rows) == len(population) and {r['id'] for r in rows} == set(by_id),
+            'Missing or duplicate intervening issue', 'E_INTEGRITY')
+    pending = []
+    for row in rows:
+        require(all(row.get(k) == v for k, v in by_id[row['id']].items()),
+                'Changed intervening issue identity', 'E_INTEGRITY')
+        require(row.get('disposition') in SETTLED | {'STILL_REQUIRED'}
+                and isinstance(row.get('reason'), str) and row['reason'].strip(),
+                'Missing substantive intervening decision', 'E_INTEGRITY')
+        if row['disposition'] == 'STILL_REQUIRED':
+            pending.append(deepcopy(row)); continue
+        require(row.get('support') and row.get('blocking_source_gaps') == [],
+                'Necessary evidence cannot be waived', 'E_INTEGRITY')
+        product.citations(dict(support=row['support'], source_gaps=[], assertion_bindings=[]), records)
+        answer_quote(candidate, **row['answer_evidence'])
+        if row['disposition'] == 'SUPPORTED_BY_REVIEWED_SOURCE':
+            require(value.get('reviewed_evidence'), 'Missing supplemental review', 'E_INTEGRITY')
+        if row['disposition'] == 'CONDITIONALLY_ADDRESSED':
+            require(isinstance(row.get('necessary_premises'), list) and row['necessary_premises'],
+                    'Conditional disposition omits premises', 'E_INTEGRITY')
+            for premise in row['necessary_premises']:
+                require(isinstance(premise.get('description'), str) and premise['description'].strip(),
+                        'Missing premise description', 'E_INTEGRITY')
+                answer_quote(candidate, **premise['answer_evidence'])
+    unresolved = [i for i, r in enumerate(predecessor['reviews'])
+                  if r.get('status') == 'VALIDATED' and r['value']['verdict'] == 'UNRESOLVED']
+    failed = [i for i, r in enumerate(predecessor['reviews']) if r.get('status') != 'VALIDATED']
+    return dict(profile=PROFILE, manifest=pointer, issue_count=len(population), pending=pending,
+                complete=not pending, predecessor_unresolved_indexes=unresolved,
+                predecessor_failed_indexes=failed, fresh_complete_review_required=True,
+                legal_acceptance=False)
+
