+"""Authenticated source-comparison text for fresh review; never an acceptance."""
+from copy import deepcopy
+from legalmath.canonical import digest
+from ..bounded_context import require
+from ..integration_contract import read_evidence
+
+PROFILE = 'answer-bound-source-comparison.v1'
+FIELD = 'reviewed_source_comparisons'
+MAX_TEXT_BYTES = 65536
+
+
+def factor_answer_fields(schema):
+    original = deepcopy(schema)
+    result = deepcopy(schema)
+    variants = result['properties']['need_dispositions']['items']['anyOf']
+    if len(variants) < 2:
+        return result
+    common = variants[0]['properties']['answer_evidence']
+    require(all(v['properties']['answer_evidence'] == common for v in variants),
+        'Cannot factor unequal answer-field schemas', 'E_INTEGRITY')
+    name = 'ReviewedSourceComparisonAnswerEvidence'
+    definitions = result.setdefault('$defs', {})
+    require(name not in definitions, 'Conflicting comparison schema definition', 'E_INTEGRITY')
+    definitions[name] = deepcopy(common)
+    for variant in variants:
+        variant['properties']['answer_evidence'] = {'$ref': '#/$defs/' + name}
+    # A mechanical expansion must recover every original constraint exactly.
+    expanded = deepcopy(result)
+    for variant in expanded['properties']['need_dispositions']['items']['anyOf']:
+        variant['properties']['answer_evidence'] = deepcopy(expanded['$defs'][name])
+    del expanded['$defs'][name]
+    if '$defs' not in original and not expanded['$defs']:
+        del expanded['$defs']
+    require(expanded == original, 'Schema factoring changed acceptance language', 'E_INTEGRITY')
+    return result
+
+
+def load(product, qid, question, answer, details, pointer):
+    value = read_evidence(pointer, product.root)
+    expected = dict(profile=PROFILE, question_id=qid, question_hash=digest(question),
+        input_hash=product.route.input_hash, answer_hash=digest(answer),
+        requirement_details_hash=digest(details), legal_acceptance=False)
+    require(all(value.get(k) == v for k, v in expected.items()),
+        'Stale or foreign source comparison', 'E_INTEGRITY')
+    require(isinstance(value.get('reviewer'), str) and value['reviewer'].strip(),
+        'Missing source comparison reviewer', 'E_INTEGRITY')
+    hashes = value.get('source_record_hashes')
+    require(isinstance(hashes, dict) and hashes, 'Missing compared sources', 'E_INTEGRITY')
+    for rid, sha in hashes.items():
+        source = product.route.records.get(rid)
+        require(source and source['kind'] == 'source' and qid in product.acquisition_questions(source)
+            and digest(source) == sha, 'Changed comparison source', 'E_INTEGRITY')
+    sources = value.get('source_files', [])
+    require(sources, 'Missing comparison source provenance', 'E_INTEGRITY')
+    for ref in sources:
+        read_evidence(ref, product.root, json_value=False)
+    attachments = value.get('documents')
+    require(isinstance(attachments, list) and attachments,
+        'Missing source comparison content', 'E_INTEGRITY')
+    documents, size, seen = [], 0, set()
+    for attachment in attachments:
+        require(set(attachment) == {'title', 'evidence'} and isinstance(attachment['title'], str)
+            and attachment['title'].strip(), 'Malformed comparison attachment', 'E_INTEGRITY')
+        ref = attachment['evidence']
+        require(ref['path'] not in seen, 'Duplicate comparison attachment', 'E_INTEGRITY')
+        seen.add(ref['path'])
+        data = read_evidence(ref, product.root, json_value=False)
+        size += len(data)
+        require(size <= MAX_TEXT_BYTES, 'Source comparison exceeds text capacity', 'E_RESOURCE_LIMIT')
+        text = data.decode('utf-8')
+        require(text.strip(), 'Empty source comparison', 'E_INTEGRITY')
+        documents.append(dict(title=attachment['title'], evidence=deepcopy(ref), text=text))
+    require(isinstance(value.get('limitations'), list) and value['limitations']
+        and all(isinstance(s, str) and s.strip() for s in value['limitations']),
+        'Missing source comparison limitations', 'E_INTEGRITY')
+    return dict(**expected, manifest=deepcopy(pointer), reviewer=value['reviewer'],
+        source_record_hashes=deepcopy(hashes), source_files=deepcopy(sources),
+        documents=documents, limitations=deepcopy(value['limitations']),
+        instruction='These are retained extraction alternatives and an explicit local materiality '
+        'assessment to evaluate critically. They are review evidence, not legal authority or a verdict. '
+        'Check the claimed effect against jointly delivered source text. Preserve contrary evidence, '
+        'unresolved conditions and factual needs. File hashes authenticate provenance only; binary '
+        'pages listed here have not been newly viewed by this review provider.')
