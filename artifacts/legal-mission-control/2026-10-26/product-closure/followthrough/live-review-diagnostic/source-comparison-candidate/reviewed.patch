+"""Opt-in measured batch-first partition; never waive capacity or a member."""
+from copy import deepcopy
+from legalmath.canonical import digest
+from ..bounded_context import require
+
+PROFILE = 'measured-batch-first-review-grouping.v1'
+FIELD = 'bounded_review_grouping_profile'
+
+
+def pack(items, measure, *, maximum_items):
+    require(type(maximum_items) is int and maximum_items > 0, 'Invalid item bound')
+    require(len({row['id'] for row in items}) == len(items), 'Duplicate input identity')
+    groups, blocked = [], []
+    def visit(rows):
+        receipt = measure(rows)
+        if receipt is not None:
+            groups.append(dict(members=deepcopy(rows), measurement=receipt))
+        elif len(rows) == 1:
+            blocked.append(deepcopy(rows[0]))
+        else:
+            midpoint = len(rows) // 2
+            visit(rows[:midpoint])
+            visit(rows[midpoint:])
+    for start in range(0, len(items), maximum_items):
+        visit(items[start:start+maximum_items])
+    actual = [row for group in groups for row in group['members']] + blocked
+    require(len(actual) == len(items) and {r['id']:digest(r) for r in actual} ==
+        {r['id']:digest(r) for r in items}, 'Packing changed or lost an item')
+    return groups, blocked
