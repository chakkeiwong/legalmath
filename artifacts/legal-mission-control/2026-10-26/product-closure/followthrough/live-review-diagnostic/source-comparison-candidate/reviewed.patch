+"""Explicit local detailed-account versions; never semantic acceptance."""
+from copy import deepcopy
+from jsonschema import validate as schema_validate
+from legalmath.canonical import digest
+from ..bounded_context import require
+from ..bounded_product import NOTE
+from ..integration_contract import read_evidence
+from ..legal_locators import normalized
+from .context_disposition import answer_quote
+
+PROFILE = 'reviewed-detailed-account-version.v1'
+
+
+def premises(requirement):
+    value = requirement['value']
+    return [dict(kind='fact', key=k, value=v) for k, v in sorted(value.get('facts', {}).items())] + [
+        dict(kind='missing_premise', key=p['id'], value=p) for p in value.get('missing_premises', [])]
+
+
+def gap_proofs(product, before, after, proofs, records):
+    original = {digest(g):g for g in before['source_gaps']}
+    current = {digest(g):g for g in after['source_gaps']}
+    require(len(original)==len(before['source_gaps']) and len(current)==len(after['source_gaps'])
+        and set(current)<=set(original), 'Unreviewed account source-gap change', 'E_INTEGRITY')
+    removed = set(original)-set(current)
+    require(len(proofs)==len(removed) and {digest(p['gap']) for p in proofs}==removed,
+        'Missing or duplicate account gap proof', 'E_INTEGRITY')
+    by_id = {r['id']:r for r in records}
+    indexes = {i['index_hash']:i for i in product.route.envelope.get('legal_indexes', [])}
+    for proof in proofs:
+        gap=proof['gap'];index=indexes.get(gap['index_hash'])
+        require(index is not None and proof.get('support'), 'Unknown account gap source', 'E_INTEGRITY')
+        numbered=[r for r in index['records'] if r['locator']==gap['locator']]
+        require(len(numbered)==1, 'Missing account numbered text', 'E_INTEGRITY')
+        product.citations(dict(support=proof['support'],source_gaps=[],assertion_bindings=[]),records)
+        parts=[]
+        for citation in proof['support']:
+            record=by_id.get(citation['record_id'])
+            require(record is not None and record.get('unit_id') in index['units']
+                and citation.get('locator')==gap['locator'], 'Foreign account gap proof', 'E_INTEGRITY')
+            parts.append(citation['quote'])
+        require(normalized(' '.join(parts))==normalized(numbered[0]['text']),
+            'Incomplete account numbered-text coverage', 'E_INTEGRITY')
+
+
+def select(product, qid, question, answer, details, pointer):
+    manifest=read_evidence(pointer,product.root)
+    expected=dict(profile=PROFILE,question_id=qid,question_hash=digest(question),
+        input_hash=product.route.input_hash,answer_hash=digest(answer),before_details_hash=digest(details))
+    require(all(manifest.get(k)==v for k,v in expected.items()), 'Stale detailed-account version', 'E_INTEGRITY')
+    require(manifest.get('legal_acceptance') is False and manifest.get('origin')=='LOCAL_REVIEWED_ACCOUNT_DRAFT'
+        and isinstance(manifest.get('reviewer'),str) and manifest['reviewer'].strip()
+        and read_evidence(manifest['review_note'],product.root,json_value=False).strip(),
+        'Missing detailed-account version review', 'E_INTEGRITY')
+    candidates=read_evidence(manifest['candidates'],product.root)
+    ids=[d['id'] for d in details]
+    require(len(set(ids))==len(ids) and [d['id'] for d in candidates]==ids
+        and all(set(d)=={'id','value'} for d in candidates)
+        and manifest.get('candidate_values_hash')==digest(candidates),
+        'Missing, reordered or changed account population', 'E_INTEGRITY')
+    changed={old['id'] for old,new in zip(details,candidates) if old['result']['value']!=new['value']}
+    rows=manifest.get('accounts',[])
+    require(changed and len(rows)==len(changed) and {r['id'] for r in rows}==changed,
+        'Missing or duplicate account change review', 'E_INTEGRITY')
+    reviews={r['id']:r for r in rows};result=deepcopy(details)
+    for old,new,out in zip(details,candidates,result):
+        if old['id'] not in changed:continue
+        before=old['result']['value'];after=new['value'];review=reviews[old['id']]
+        requirement=product.route.records.get(old['id'])
+        require(requirement is not None and requirement['kind'] in ('case','obligation','reading')
+            and qid in product.requirement_questions(requirement), 'Foreign account requirement', 'E_INTEGRITY')
+        require(review.get('before_hash')==digest(before) and review.get('after_hash')==digest(after)
+            and review.get('requirement_hash')==digest(requirement), 'Changed account or requirement', 'E_INTEGRITY')
+        schema_validate(after,NOTE)
+        require(set(after)==set(before) and all(after[k]==before[k] for k in ('considered','contrary'))
