+    outer=read_evidence(p.capacity_checkpoint,tmp_path)
+    manifest=read_evidence(outer[comparison.FIELD]['p14'],tmp_path)
+    manifest['source_record_hashes']={sources[0]['id']:digest(sources[0])}
+    outer[comparison.FIELD]['p14']=put(tmp_path,'uncited-comparison.json',manifest)
+    p.capacity_checkpoint=put(tmp_path,'uncited-checkpoint.json',outer)
+    with supplement.scope(*args) as active:
+        assert active['records'][sources[0]['id']]==sources[0]
+        records,payload=supplement.add(p,'p14',args[4],[],{'answer':args[4]})
+        assert sources[0] in records
