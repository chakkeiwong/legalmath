+from copy import deepcopy
+import pytest
+from legalmath.errors import LegalMathError
+from legalmath.interpretation.assurance.phased import review_planning
+
+
+def items(n):
+    return [dict(id=str(i), payload={'unchanged': i}) for i in range(n)]
+
+
+def test_full_population_needs_one_measurement_per_fitting_block():
+    population = items(1751)
+    before = deepcopy(population)
+    calls = []
+    def measure(rows):
+        calls.append([r['id'] for r in rows])
+        return dict(exact_ids=calls[-1])
+    groups, blocked = review_planning.pack(population, measure, maximum_items=24)
+    assert len(calls) == len(groups) == 73 and not blocked
+    assert [r for g in groups for r in g['members']] == before == population
+    assert all(g['measurement']['exact_ids'] == [r['id'] for r in g['members']] for g in groups)
+
+
+def test_split_keeps_oversized_singleton_and_every_other_member():
+    population = items(10)
+    calls = []
+    def measure(rows):
+        calls.append(tuple(r['id'] for r in rows))
+        return None if len(rows)>3 or any(r['id']=='4' for r in rows) else {'fits': True}
+    groups, blocked = review_planning.pack(population, measure, maximum_items=8)
+    assert blocked == [population[4]]
+    assert [r for g in groups for r in g['members']] == population[:4] + population[5:]
+    assert all(tuple(r['id'] for r in g['members']) in calls for g in groups)
+
+
+def test_nonmonotonic_measurements_do_not_infer_singleton_failure():
+    population = items(4)
+    calls = []
+    def measure(rows):
+        calls.append(len(rows))
+        return {'fits': True} if len(rows)==4 else None
+    groups, blocked = review_planning.pack(population, measure, maximum_items=4)
+    assert calls == [4] and len(groups)==1 and not blocked
+
+
+def test_unexpected_measurement_error_is_not_a_capacity_refusal():
+    def measure(rows):
+        raise RuntimeError('Broken measurement')
+    with pytest.raises(RuntimeError):
+        review_planning.pack(items(3), measure, maximum_items=3)
+
+
+@pytest.mark.parametrize('size',[0,-1,True])
+def test_invalid_group_bound_rejected(size):
+    with pytest.raises(LegalMathError):
+        review_planning.pack(items(1), lambda rows:{}, maximum_items=size)
+
+
+def test_duplicate_population_and_empty_population():
+    with pytest.raises(LegalMathError):
+        review_planning.pack(items(1)*2,lambda rows:{},maximum_items=2)
+    assert review_planning.pack([],lambda rows:pytest.fail('No empty call'),maximum_items=2)==([],[])
