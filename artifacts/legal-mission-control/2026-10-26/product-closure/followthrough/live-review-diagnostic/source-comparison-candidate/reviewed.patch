+def configured(root, damage=None):
+    args, sources = setup(root)
+    p, q, answer = args[0], args[2], args[4]
+    document = put(root, 'alternatives.txt', 'Exact alternatives: address segmentation. Operative language unchanged in inspected passages.')
+    source_file = put(root, 'source.bin', 'Retained binary source fixture')
+    value = dict(profile=comparison.PROFILE, question_id='p14', question_hash=digest(q),
+        input_hash=p.route.input_hash, answer_hash=digest(answer), requirement_details_hash=digest([]),
+        reviewer='Fixture source reviewer', legal_acceptance=False,
+        source_record_hashes={sources[-1]['id']:digest(sources[-1])}, source_files=[source_file],
+        documents=[dict(title='Comparison', evidence=document)],
+        limitations=['No blanket source qualification; no legal acceptance.'])
+    if damage in ('answer_hash', 'question_hash', 'input_hash', 'requirement_details_hash'):
+        value[damage] = '0'*64
+    if damage == 'source': value['source_record_hashes'][sources[-1]['id']] = '0'*64
+    if damage == 'acceptance': value['legal_acceptance'] = True
+    if damage == 'empty': value['documents'] = []
+    if damage == 'oversize':
+        value['documents'][0]['evidence'] = put(root, 'large.txt', 'x'*(comparison.MAX_TEXT_BYTES+1))
+    pointer = put(root, 'comparison.json', value)
+    from legalmath.interpretation.assurance.integration_contract import read_evidence
+    outer = read_evidence(p.capacity_checkpoint, root)
+    outer[comparison.FIELD] = {'p14':pointer}
+    p.capacity_checkpoint = put(root, 'comparison-checkpoint.json', outer)
+    if damage == 'changed_document': (root/'alternatives.txt').write_text('Changed')
+    if damage == 'changed_binary': (root/'source.bin').write_text('Changed')
+    return args, sources, document
+
+
+def test_group_context_and_account_receive_comparison(tmp_path, monkeypatch):
+    args, sources, document = configured(tmp_path)
+    p, q, answer = args[0], args[2], args[4]
+    item = next(r for r in assignments(p,'p14',[]) if r['origin_id']==sources[0]['id'])
+    initial = dict(status='VALIDATED',value={**decision(sources[0],'UNRESOLVED'),
+        'considered':[item['id']],'context_needs':[dict(kind='CLIENT_FACT',record_ids=[],
+            locators=[],query='',reason='Actual request unknown.')]})
+    expected = (tmp_path/'alternatives.txt').read_text()
+    baseline = group_review.build(p,'p14',q,answer,[item])[0]
+    observed = []
+    monkeypatch.setattr(group_review,'run',lambda *a,**k:[])
+    p.note = lambda key,task,question,records,material,expected,**kw: observed.append(material) or {'status':'VALIDATED','value':{'verdict':'UNRESOLVED'}}
+    with supplement.scope(*args) as active:
+        request = group_review.build(p,'p14',q,answer,[item])[0]
+        context = context_disposition.prepare(p,'p14',q,answer,item,initial,prefix='comparison-')[0]
+        requirement=next(r for r in p.route.records.values() if r['kind']=='obligation')
+        result=p.audit_answer('p14',q,answer,[{'id':requirement['id'],
+            'result':{'value':{'conclusion':'Account remains conditional.'}}}],prefix='fresh-')
+        for payload in [request['payload'],context['payload'],*observed]:
+            attachment=payload['supplemental_review_context']['source_comparison']
+            assert attachment['documents'][0]['text']==expected
+            assert attachment['documents'][0]['evidence']==document
+            assert attachment['legal_acceptance'] is False
+        assert request['required_considered']==baseline['required_considered']
+        assert request['review_scope']['assigned_source_ids']==baseline['review_scope']['assigned_source_ids']
+        assert result[0]['value']['verdict']=='UNRESOLVED'
+        old_identity=active['identity']
+    assert not hasattr(p,supplement.ATTRIBUTE)
+    # Same source records but a changed reviewed comparison must get a fresh identity.
+    from legalmath.interpretation.assurance.integration_contract import read_evidence
+    outer=read_evidence(p.capacity_checkpoint,tmp_path)
+    manifest=read_evidence(outer[comparison.FIELD]['p14'],tmp_path)
+    manifest['documents'][0]['evidence']=put(tmp_path,'second.txt','A changed comparison remains provisional.')
+    outer[comparison.FIELD]['p14']=put(tmp_path,'second-comparison.json',manifest)
+    p.capacity_checkpoint=put(tmp_path,'second-checkpoint.json',outer)
+    with supplement.scope(*args) as active:assert active['identity']!=old_identity
+
+
+@pytest.mark.parametrize('damage',['answer_hash','question_hash','input_hash','requirement_details_hash',
+    'source','acceptance','empty','oversize','changed_document','changed_binary'])
+def test_comparison_refuses_bad_identity_or_content(tmp_path,damage):
+    args,_,_=configured(tmp_path,damage)
+    with pytest.raises(LegalMathError):
+        with supplement.scope(*args):pytest.fail('Invalid comparison reached consumer')
+    assert not hasattr(args[0],supplement.ATTRIBUTE)
+
