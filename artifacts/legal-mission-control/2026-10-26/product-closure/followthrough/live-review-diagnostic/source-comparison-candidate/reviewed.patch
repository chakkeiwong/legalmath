+"""Explicit reviewed field changes; representation checks do not prove entailment."""
+from legalmath.canonical import digest
+from ..bounded_context import require
+from ..integration_contract import read_evidence
+from ..legal_locators import normalized
+from .context_disposition import answer_quote
+
+PROFILE = 'reviewed-field-change-answer-version.v1'
+MUTABLE = {'conclusion', 'support', 'assertion_bindings', 'alternatives', 'source_gaps', 'unresolved'}
+
+
+def validate(product, qid, fixed, candidate, spec, records):
+    value = read_evidence(spec['field_changes'], product.root)
+    expected = dict(profile=PROFILE, question_id=qid, input_hash=product.route.input_hash,
+                    before_hash=digest(fixed), after_hash=digest(candidate))
+    require(all(value.get(k) == v for k, v in expected.items()),
+            'Stale reviewed field changes', 'E_INTEGRITY')
+    require(value.get('legal_acceptance') is False
+            and isinstance(value.get('reviewer'), str) and value['reviewer'].strip()
+            and read_evidence(value['review_note'], product.root, json_value=False).strip(),
+            'Missing field-change review', 'E_INTEGRITY')
+    changed = {k for k in fixed if fixed[k] != candidate[k]}
+    require(set(fixed) == set(candidate) and changed and changed <= MUTABLE,
+            'Unreviewed protected field change', 'E_INTEGRITY')
+    require(candidate['conclusion'].startswith(fixed['conclusion']),
+            'Original conclusion not retained', 'E_INTEGRITY')
