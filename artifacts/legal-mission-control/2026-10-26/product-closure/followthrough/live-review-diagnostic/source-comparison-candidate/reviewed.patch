+"""Explicit local candidate selection after authenticated provider history.
+
+This validates provenance and representation only. Fresh complete review remains
+mandatory and retains its adverse veto; no provider response is manufactured.
+"""
+from copy import deepcopy
+
+from jsonschema import validate as schema_validate
+
+from legalmath.canonical import digest
+from ..bounded_context import require
+from ..bounded_product import NOTE
+from ..integration_contract import read_evidence
+from . import current_issue_disposition, reviewed_source_context
+from . import reviewed_field_changes, intervening_issue_disposition
+
+PROFILE = 'reviewed-append-and-support-answer-version.v1'
+FIELD = 'reviewed_answer_versions'
+
+
+def select(product, qid, question, original, held, dependencies):
+    checkpoint = getattr(product, 'capacity_checkpoint', None)
+    outer = read_evidence(checkpoint, product.root) if checkpoint is not None else {}
+    pointer = outer.get(FIELD, {}).get(qid)
+    if pointer is None:
+        return None
+    value = read_evidence(pointer, product.root)
+    fixed = held['candidate']['value']
+    require(value.get('profile') in (PROFILE, reviewed_field_changes.PROFILE),
+        'Unknown local answer version profile', 'E_INTEGRITY')
+    expected = dict(profile=value['profile'], question_id=qid, question_hash=digest(question),
+        input_hash=product.route.input_hash, original_answer_hash=digest(original),
+        fixed_answer_hash=digest(fixed),
+        requirement_details_hash=digest(held['corrected_requirement_details']),
+        dependency_population_hash=digest(dependencies))
+    require(all(value.get(k) == v for k, v in expected.items()),
+        'Stale or foreign local answer version', 'E_INTEGRITY')
+    require(value.get('origin') == 'LOCAL_REVIEWED_CANDIDATE'
+        and value.get('legal_acceptance') is False
+        and isinstance(value.get('reviewer'), str) and value['reviewer'].strip()
+        and read_evidence(value['review_note'], product.root, json_value=False).strip(),
+        'Missing local candidate review and provenance', 'E_INTEGRITY')
+    candidate = read_evidence(value['candidate'], product.root)
+    schema_validate(candidate, NOTE)
+    require(set(candidate) == set(fixed)
+        and candidate['conclusion'].startswith(fixed['conclusion'])
+        and len(candidate['conclusion']) > len(fixed['conclusion']),
+        'Local version changed the retained conclusion or shape', 'E_INTEGRITY')
+    if value['profile'] == PROFILE:
+        mutable = {'conclusion', 'support', 'assertion_bindings'}
+        require(all(candidate[k] == fixed[k] for k in fixed if k not in mutable),
+            'Local version changed original alternatives, conditions or gaps', 'E_INTEGRITY')
+    require(all(candidate[k][:len(fixed[k])] == fixed[k]
+        for k in ('support', 'assertion_bindings')),
+        'Local version removed or changed original source support', 'E_INTEGRITY')
+    # Source-gap declarations describe the candidate's reviewed delivery, not
+    # every source anywhere in the route. Retain that exact delivery and add
+    # the new candidate's cited records; never invent a broader comparator.
+    fixed_request = read_evidence(outer['calls']['correction-'+qid]['request'], product.root)
+    records = {r['id']: r for r in fixed_request['records']}
+    records.update({r['id']: r for r in product.source_records(candidate)})
+    require(all(product.route.records.get(rid) == row
+        and row['kind'] == 'source' and qid in product.acquisition_questions(row)
+        for rid, row in records.items()), 'Changed local candidate source delivery', 'E_INTEGRITY')
+    product.citations(candidate, list(records.values()))
+    field_review = (reviewed_field_changes.validate(product, qid, fixed, candidate, value,
+        list(records.values())) if value['profile'] == reviewed_field_changes.PROFILE else None)
+    mapping = outer.get('current_answer_issue_dispositions', {}).get(qid)
+    require(value.get('issue_mapping') == mapping and mapping is not None
+        and outer.get(reviewed_source_context.FIELD) == reviewed_source_context.PROFILE,
+        'Local version lacks exact mapping or complete-source review profile', 'E_INTEGRITY')
+    reviews = [r for r in held['original_reviews'] if r.get('status') == 'VALIDATED']
+    details = held['corrected_requirement_details']
+    account_review = None
+    if value.get('reviewed_account_versions') is not None:
+        from . import reviewed_account_version
+        details, account_review = reviewed_account_version.select(product, qid, question,
+            candidate, details, value['reviewed_account_versions'])
+    checked = current_issue_disposition.validate(product, qid, question, original,
+        candidate, details, reviews,
+        held['review_warrants'], read_evidence(mapping, product.root))
+    require(checked['complete'], 'Local version retains unresolved original objections', 'E_DEPENDENCY')
+    # A newer failed review of the fixed answer is not part of the original
+    # issue census. Retain its adverse findings explicitly until a separately
+    # reviewed disposition exists; a fresh general review cannot erase them.
+    predecessor = read_evidence(value['predecessor_reviews'], product.root)['answers'][qid]
+    require(predecessor['answer']['value'] == fixed and predecessor['reviews'],
+        'Local version lacks the exact predecessor review population', 'E_INTEGRITY')
+    adverse = [dict(review_index=i, review_hash=digest(row),
+        considered=deepcopy(row['value']['considered']), issues=deepcopy(row['value']['issues']))
+        for i, row in enumerate(predecessor['reviews'])
+        if row.get('status') == 'VALIDATED' and row['value']['verdict'] == 'REJECT']
+    intervening = None
+    if value.get('intervening_issue_dispositions') is not None:
+        intervening = intervening_issue_disposition.validate(product, qid, question, candidate,
+            predecessor, value['intervening_issue_dispositions'], list(records.values()))
+        pending_indexes = {row['review_index'] for row in intervening['pending']}
+        adverse = [row for row in adverse if row['review_index'] in pending_indexes]
+    result = dict(status='VALIDATED', value=deepcopy(candidate), provenance=dict(
+        origin='LOCAL_REVIEWED_CANDIDATE', version=pointer,
+        predecessor_candidate_hash=digest(held['candidate']),
+        predecessor_reviews=value['predecessor_reviews'],
+        predecessor_review_identity=intervening_issue_disposition.review_identity(predecessor),
+        predecessor_unresolved_review_count=sum(row.get('status') == 'VALIDATED'
+            and row['value']['verdict'] == 'UNRESOLVED' for row in predecessor['reviews']),
+        predecessor_failed_review_count=sum(row.get('status') != 'VALIDATED'
+            for row in predecessor['reviews']),
+        reviewed_field_changes=field_review,
+        intervening_issue_disposition=intervening,
+        unresolved_predecessor_adverse_reviews=adverse,
+        new_provider_calls=0, semantic_acceptance=False, fresh_complete_review_required=True))
+    if account_review is not None:
+        result['reviewed_requirement_details'] = details
+        result['provenance']['reviewed_accounts'] = account_review
+    return result
