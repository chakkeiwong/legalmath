+@pytest.mark.parametrize('damage',[None,'missing','unknown','duplicate'])
+def test_schema_factoring_preserves_constraints(damage):
+    from jsonschema import Draft202012Validator
+    evidence={'type':'object','additionalProperties':False,'properties':{'answer_field':{'type':'string','enum':['','/conclusion','/unresolved/0']}},'required':['answer_field']}
+    variants=[{'type':'object','additionalProperties':False,'properties':{'need_id':{'type':'string','enum':[str(i)]},'answer_evidence':deepcopy(evidence)},'required':['need_id','answer_evidence']} for i in range(3)]
+    schema={'type':'object','properties':{'need_dispositions':{'type':'array','items':{'anyOf':variants}}},'required':['need_dispositions']}
+    result=comparison.factor_answer_fields(schema)
+    value={'need_dispositions':[{'need_id':'0','answer_evidence':{'answer_field':'/conclusion'}}]}
+    if damage=='missing':value['need_dispositions'][0]['answer_evidence']={}
+    if damage=='unknown':value['need_dispositions'][0]['answer_evidence']['answer_field']='/invented'
+    if damage=='duplicate':value['need_dispositions'][0]['answer_evidence']['extra']='x'
+    assert Draft202012Validator(schema).is_valid(value)==Draft202012Validator(result).is_valid(value)
+    assert Draft202012Validator(result).is_valid(value)==(damage is None)
+
