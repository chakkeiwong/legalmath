+"""Opt-in delivery of authenticated supplemental sources to fresh reviews.
+
+This supplies context, never a verdict. The new context identity must select
+fresh request keys and cannot reuse acceptance from a different source window.
+"""
+from contextlib import contextmanager
+from copy import deepcopy
+
+from legalmath.canonical import digest
+from ..bounded_context import require
+from ..integration_contract import read_evidence
+
+PROFILE = 'answer-bound-reviewed-source-context.v1'
+FIELD = 'reviewed_source_context_profile'
+ATTRIBUTE = '_active_reviewed_source_context'
+
+
+@contextmanager
+def scope(product, qid, question, original, answer, details, reviews, assessments, disposition):
+    checkpoint = getattr(product, 'capacity_checkpoint', None)
+    outer = read_evidence(checkpoint, product.root) if checkpoint is not None else {}
+    selected = outer.get(FIELD)
+    if selected is None:
+        yield None
+        return
+    require(selected == PROFILE, 'Unknown supplemental source profile', 'E_AUTHORITY')
+    pointer = outer.get('current_answer_issue_dispositions', {}).get(qid)
+    require(pointer is not None and disposition is not None
+        and disposition.get('review') == pointer,
+        'Supplemental context lacks its authenticated current-answer review', 'E_INTEGRITY')
+    value = read_evidence(pointer, product.root)
+    from .current_issue_disposition import validate
+    checked = validate(product, qid, question, original, answer, details, reviews, assessments, value)
+    require(disposition == {**checked, 'review': pointer},
+        'Changed supplemental context disposition', 'E_INTEGRITY')
+    claims, records = [], {}
+    cited = product.source_records(answer)
+    for record in cited:
+        require(qid in product.acquisition_questions(record),
+            'Answer-cited source is outside this question', 'E_INTEGRITY')
+        records[record['id']] = deepcopy(record)
+    for row in value['dispositions']:
+        if row['disposition'] != 'SUPPORTED_BY_REVIEWED_SOURCE':
+            continue
+        ids = list(dict.fromkeys(q['record_id'] for q in row['support']))
+        for rid in ids:
+            record = product.route.records.get(rid)
+            require(record and record['kind'] == 'source'
+                and qid in product.acquisition_questions(record),
+                'Supplemental source is outside this question', 'E_INTEGRITY')
+            records[rid] = deepcopy(record)
+        claims.append(dict(answer_evidence=deepcopy(row['answer_evidence']), source_record_ids=ids))
+    require(claims, 'No authenticated supplemental source context', 'E_INTEGRITY')
+    manifest = dict(profile=PROFILE, question_id=qid, answer_hash=digest(answer),
+        reviewed_evidence=deepcopy(pointer), claims=claims,
+        answer_cited_source_ids=[record['id'] for record in cited],
+        source_record_hashes={rid: digest(record) for rid, record in records.items()},
+        instruction='These are additional exact source records for fresh assessment of the unchanged '
+            'answer. The claim mapping identifies the proposition to assess; it does not establish '
+            'entailment, legal applicability, current law or a verdict. Preserve material contrary '
+            'evidence, unresolved needs and conditional premises. Earlier review dispositions are '
+            'not legal authority and do not determine this review.')
+    from . import review_planning, review_target
+    local_accounts = any(row.get('result', {}).get('provenance', {}).get('origin')
+        == 'LOCAL_REVIEWED_ACCOUNT_DRAFT' for row in details)
+    if local_accounts:
+        account_sources = product.source_records(details)
+        for record in account_sources:
+            require(qid in product.acquisition_questions(record),
+                'Account source is outside this question', 'E_INTEGRITY')
+            records[record['id']] = deepcopy(record)
+        manifest['requirement_details_hash'] = digest(details)
+        manifest['account_cited_source_ids'] = [r['id'] for r in account_sources]
+        manifest['source_record_hashes'] = {rid:digest(record) for rid,record in records.items()}
+    for module in (review_planning, review_target):
+        selected = outer.get(module.FIELD)
+        require(selected in (None, module.PROFILE), 'Unknown scoped review profile', 'E_AUTHORITY')
+        if selected is not None:
+            manifest[module.FIELD] = selected
+    if outer.get(review_target.FIELD) is not None:
+        manifest['verdict_target_instruction'] = review_target.GUIDANCE
+    from . import reviewed_source_comparison
+    comparison = outer.get(reviewed_source_comparison.FIELD, {}).get(qid)
+    required_comparison = value.get('required_source_comparison')
+    if required_comparison is not None:
+        require(comparison == required_comparison,
+            'Reviewed disposition requires its exact source comparison', 'E_INTEGRITY')
+    if comparison is not None:
+        manifest['source_comparison'] = reviewed_source_comparison.load(
+            product, qid, question, answer, details, comparison)
+        for rid in manifest['source_comparison']['source_record_hashes']:
+            records[rid] = deepcopy(product.route.records[rid])
+        manifest['source_record_hashes'] = {rid:digest(record) for rid,record in records.items()}
+    context = dict(identity=digest(manifest), manifest=manifest, records=records)
+    missing = object()
+    previous = getattr(product, ATTRIBUTE, missing)
+    require(previous is missing or previous is None,
+        'Nested supplemental source context', 'E_INTEGRITY')
+    setattr(product, ATTRIBUTE, context)
+    try:
+        yield context
+    finally:
+        if previous is missing:
+            delattr(product, ATTRIBUTE)
+        else:
+            setattr(product, ATTRIBUTE, previous)
+
+
+def add(product, qid, answer, records, payload):
+    context = getattr(product, ATTRIBUTE, None)
+    if context is None:
+        return records, payload
+    manifest = context['manifest']
+    require(manifest['question_id'] == qid and manifest['answer_hash'] == digest(answer),
+        'Stale or foreign supplemental source consumer', 'E_INTEGRITY')
+    table = {r['id']: r for r in records}
+    require(len(table) == len(records), 'Duplicate review source identity', 'E_INTEGRITY')
+    for rid, record in context['records'].items():
+        require(product.route.records.get(rid) == record
+            and digest(record) == manifest['source_record_hashes'][rid],
+            'Changed supplemental source bytes', 'E_INTEGRITY')
+        require(rid not in table or table[rid] == record,
+            'Conflicting supplemental source delivery', 'E_INTEGRITY')
+        table[rid] = deepcopy(record)
+    require('supplemental_review_context' not in payload,
+        'Duplicate supplemental context manifest', 'E_INTEGRITY')
+    return list(table.values()), {**payload, 'supplemental_review_context': deepcopy(manifest)}
