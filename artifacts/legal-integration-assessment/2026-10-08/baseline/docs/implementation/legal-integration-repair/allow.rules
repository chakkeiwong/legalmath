# Closed four-action CLI; no arbitrary shell, paths, limits, or model arguments.
prefix_rule(pattern=[".venv/bin/python", "scripts/run_legal_integration_repair.py", "check"], decision="allow")
prefix_rule(pattern=[".venv/bin/python", "scripts/run_legal_integration_repair.py", "execute"], decision="allow")
prefix_rule(pattern=[".venv/bin/python", "scripts/run_legal_integration_repair.py", "status"], decision="allow")
prefix_rule(pattern=[".venv/bin/python", "scripts/run_legal_integration_repair.py", "verify"], decision="allow")
