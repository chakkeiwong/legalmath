{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalmath.invalid/interpretation/v1/candidate",
  "title": "Proposed interpretation.v1 candidate",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "interpretation.v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_packet_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "family_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "subject_unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "controlled_language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "bundle_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assumption_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "provenance_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "SOURCE_SUPPORTED",
              "FACT_REQUIRED",
              "PROVISIONAL",
              "DISPUTED",
              "REJECTED"
            ]
          }
        },
        "required": [
          "assumption_id",
          "statement",
          "provenance_refs",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "argument_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
          },
          "conclusion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "premise_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "inference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "inference_kind": {
            "enum": [
              "STRICT",
              "DEFEASIBLE",
              "NOT_FORMALIZED"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "opposes_argument_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "argument_id",
          "conclusion",
          "premise_refs",
          "inference",
          "inference_kind",
          "source_refs",
          "opposes_argument_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "issue_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "ACTIVE",
        "DEFERRED",
        "DEFEATED",
        "UNSUPPORTED",
        "SELECTED_FOR_REVIEW"
      ]
    },
    "disposition_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "scheduling_priority": {
      "type": "integer",
      "minimum": 0
    },
    "score_purpose": {
      "const": "INVESTIGATION_PRIORITY_ONLY"
    },
    "probability_of_legal_correctness": {
      "type": "null"
    },
    "generation_phase": {
      "enum": [
        "BLIND_INITIAL",
        "SHARED_RESOLUTION",
        "HUMAN_AUTHORED"
      ]
    },
    "action_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "run_id",
    "parent_id",
    "source_packet_hash",
    "source_unit_ids",
    "family_ids",
    "subject_unit",
    "controlled_language",
    "bundle_hash",
    "assumptions",
    "arguments",
    "issue_ids",
    "status",
    "disposition_reason",
    "scheduling_priority",
    "score_purpose",
    "probability_of_legal_correctness",
    "generation_phase",
    "action_id",
    "revision_reason"
  ],
  "additionalProperties": false
}
