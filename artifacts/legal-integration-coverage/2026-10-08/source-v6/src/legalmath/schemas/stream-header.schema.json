{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalmath.invalid/spec/0.1/stream-header",
  "type": "object",
  "properties": {
    "stream_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "profile": {
      "enum": [
        "consent",
        "achievement"
      ]
    },
    "inception": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "actor": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "obligation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile_version": {
      "const": "0.1"
    },
    "ordering_authority": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "initial_snapshot": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "as_of": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
            },
            "state": {
              "enum": [
                "ACTIVE",
                "WITHDRAWN",
                "NOT_ESTABLISHED"
              ]
            },
            "generation": {
              "type": "integer",
              "minimum": 0
            },
            "reviewer_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "evidence_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
            }
          },
          "required": [
            "as_of",
            "state",
            "generation",
            "reviewer_id",
            "evidence_id",
            "recorded_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "stream_id",
    "profile",
    "inception",
    "subject",
    "category",
    "actor",
    "action",
    "obligation_id",
    "profile_version",
    "ordering_authority",
    "initial_snapshot"
  ],
  "additionalProperties": false
}
