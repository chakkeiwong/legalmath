          "enum": [
            "AVAILABLE",
            "MISSING",
            "UNCERTAIN",
            "NONE_DECLARED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "dependency_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
