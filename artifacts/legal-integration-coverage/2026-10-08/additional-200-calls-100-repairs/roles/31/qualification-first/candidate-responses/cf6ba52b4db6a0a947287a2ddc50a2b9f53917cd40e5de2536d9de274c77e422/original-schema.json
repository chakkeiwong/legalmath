{
  "$defs": {
    "AuthorityAssessment": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "MISSING",
            "UNCERTAIN",
            "NONE_DECLARED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "dependency_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Dependency Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "dependency_ids",
        "rationale"
      ],
      "title": "AuthorityAssessment",
      "type": "object"
    },
    "Correspondence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PRESERVES",
            "CONFLICTS",
            "OMITS",
            "NOT_APPLICABLE",
            "UNAVAILABLE",
            "BLOCKED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "representation_quotes": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "title": "Representation Quotes",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "representation_quotes",
        "rationale"
      ],
      "title": "Correspondence",
      "type": "object"
    },
    "QuestionRelation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "RELEVANT",
            "NOT_APPLICABLE_TO_THIS_QUESTION",
            "UNCERTAIN",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "question_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Question Hash",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "maxItems": 12,
          "title": "Evidence",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "question_hash",
        "evidence",
        "rationale"
      ],
      "title": "QuestionRelation",
      "type": "object"
