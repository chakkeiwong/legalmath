      "type": "array"
    },
    "additional_concerns": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Additional Concerns",
      "type": "array"
    }
  },
  "required": [
    "checks",
    "additional_concerns"
