{
  "$defs": {
    "AuthorityAssessment": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "MISSING",
            "UNCERTAIN",
            "NONE_DECLARED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "dependency_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Dependency Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "dependency_ids",
        "rationale"
      ],
      "title": "AuthorityAssessment",
      "type": "object"
    },
    "Correspondence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PRESERVES",
            "CONFLICTS",
            "OMITS",
            "NOT_APPLICABLE",
            "UNAVAILABLE",
            "BLOCKED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "representation_quotes": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "title": "Representation Quotes",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "representation_quotes",
        "rationale"
      ],
      "title": "Correspondence",
      "type": "object"
