        "status": {
          "enum": [
            "AVAILABLE",
            "MISSING",
            "UNCERTAIN",
            "NONE_DECLARED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "dependency_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Dependency Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "dependency_ids",
        "rationale"
      ],
      "title": "AuthorityAssessment",
      "type": "object"
    },
    "Correspondence": {
