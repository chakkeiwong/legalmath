            "BLOCKED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "representation_quotes": {
          "items": {
            "type": "string",
            "enum": [
              "exec2.2bbaa8bd8caa775727710e8d920dae9be39105ed86879e325e8238305abb3228",
