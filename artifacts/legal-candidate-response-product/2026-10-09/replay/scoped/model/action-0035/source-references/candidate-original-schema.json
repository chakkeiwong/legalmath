            "BLOCKED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "representation_quotes": {
          "items": {
            "type": "string",
            "enum": [
              "exec2.e768f4ebeb7fd7231f42309b7f8bac1109b24edcb4254848078579895800b474",
