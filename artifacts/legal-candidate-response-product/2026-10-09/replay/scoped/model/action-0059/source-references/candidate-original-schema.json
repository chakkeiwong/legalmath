        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "representation_quotes",
        "rationale"
      ],
      "title": "Correspondence",
      "type": "object"
