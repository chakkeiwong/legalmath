{
  "$defs": {
    "AuthorityAssessment": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "MISSING",
            "UNCERTAIN",
            "NONE_DECLARED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "dependency_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Dependency Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "dependency_ids",
        "rationale"
      ],
      "title": "AuthorityAssessment",
      "type": "object"
    },
    "Correspondence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PRESERVES",
            "CONFLICTS",
            "OMITS",
            "NOT_APPLICABLE",
            "UNAVAILABLE",
            "BLOCKED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "representation_quotes": {
          "items": {
            "type": "string",
            "enum": [
              "exec2.1bbcac611d85621e47ce5a41d226c0b3eb2f9a795fc452374705c19f446b270f",
              "exec2.34fc7f7d3008ea96a91db024132ae9f30dd59abf2f1b8e3abacd782e400d2cd8",
              "exec2.122ceaafe8e05e087c5e36432acdafa64395dacb6ef0d5f416cfe3be7282f5ef",
              "exec2.b8134e0dc065a68ec3fa276be1b184cf79fd8fb380f709d529796e01fd37f34b"
            ]
          },
          "maxItems": 12,
          "title": "Representation Quotes",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "representation_quotes",
        "rationale"
      ],
      "title": "Correspondence",
      "type": "object"
    },
    "QuestionRelation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "RELEVANT",
            "NOT_APPLICABLE_TO_THIS_QUESTION",
            "UNCERTAIN",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "question_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Question Hash",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "maxItems": 12,
          "title": "Evidence",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "question_hash",
        "evidence",
        "rationale"
      ],
      "title": "QuestionRelation",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Unit Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "quote"
      ],
      "title": "Quote",
      "type": "object"
    },
    "ScopedCheck": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Claim Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "source_support": {
          "$ref": "#/$defs/SourceSupport"
        },
        "question_relation": {
          "$ref": "#/$defs/QuestionRelation"
        },
        "executable_correspondence": {
          "$ref": "#/$defs/Correspondence"
        },
        "authority": {
          "$ref": "#/$defs/AuthorityAssessment"
        },
        "followup_questions": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Followup Questions",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "candidate_id",
        "source_support",
        "question_relation",
        "executable_correspondence",
        "authority",
        "followup_questions"
      ],
      "title": "ScopedCheck",
      "type": "object"
    },
    "SourceSupport": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "CONTRADICTED",
            "NOT_ESTABLISHED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "maxItems": 12,
          "title": "Evidence",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "evidence",
        "rationale"
      ],
      "title": "SourceSupport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/ScopedCheck"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "additional_concerns": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Additional Concerns",
      "type": "array"
    }
  },
  "required": [
    "checks",
    "additional_concerns"
  ],
  "title": "FidelityV2",
  "type": "object"
}
