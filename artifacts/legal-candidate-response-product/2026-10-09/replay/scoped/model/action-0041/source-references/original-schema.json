{
  "$defs": {
    "AuthorityAssessment": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE",
            "MISSING",
            "UNCERTAIN",
            "NONE_DECLARED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "dependency_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Dependency Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "dependency_ids",
        "rationale"
      ],
      "title": "AuthorityAssessment",
      "type": "object"
    },
    "Correspondence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PRESERVES",
            "CONFLICTS",
            "OMITS",
            "NOT_APPLICABLE",
            "UNAVAILABLE",
            "BLOCKED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "representation_quotes": {
          "items": {
            "type": "string",
            "enum": [
              "exec2.906c42bf58ffdba4a630f91c6cc9053a5f14c56cce8fc3bfbd7c493574eb1ea3",
              "exec2.65c04a98d679508964270a5c797a87f386ff3c70cb9a9c2128229625d0585033",
              "exec2.5ad1b53809fea15e1b59071d0b9851fb5da153d649e7497f4d171622b014b134",
              "exec2.5a0691e816ae5a7d958d6753cb3665a2437f39cbb6cb72235b1f5b5d90bf1539"
            ]
          },
          "maxItems": 12,
          "title": "Representation Quotes",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "representation_quotes",
        "rationale"
      ],
      "title": "Correspondence",
      "type": "object"
    },
    "QuestionRelation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "RELEVANT",
            "NOT_APPLICABLE_TO_THIS_QUESTION",
            "UNCERTAIN",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "question_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Question Hash",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "maxItems": 12,
          "title": "Evidence",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "question_hash",
        "evidence",
        "rationale"
      ],
      "title": "QuestionRelation",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Unit Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "quote"
      ],
      "title": "Quote",
      "type": "object"
    },
    "ScopedCheck": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Claim Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "source_support": {
          "$ref": "#/$defs/SourceSupport"
        },
        "question_relation": {
          "$ref": "#/$defs/QuestionRelation"
        },
        "executable_correspondence": {
          "$ref": "#/$defs/Correspondence"
        },
        "authority": {
          "$ref": "#/$defs/AuthorityAssessment"
        },
        "followup_questions": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Followup Questions",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "candidate_id",
        "source_support",
        "question_relation",
        "executable_correspondence",
        "authority",
        "followup_questions"
      ],
      "title": "ScopedCheck",
      "type": "object"
    },
    "SourceSupport": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "CONTRADICTED",
            "NOT_ESTABLISHED",
            "UNASSESSED"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "maxItems": 12,
          "title": "Evidence",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "status",
        "evidence",
        "rationale"
      ],
      "title": "SourceSupport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/ScopedCheck"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "additional_concerns": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Additional Concerns",
      "type": "array"
    }
  },
  "required": [
    "checks",
    "additional_concerns"
  ],
  "title": "FidelityV2",
  "type": "object"
}
