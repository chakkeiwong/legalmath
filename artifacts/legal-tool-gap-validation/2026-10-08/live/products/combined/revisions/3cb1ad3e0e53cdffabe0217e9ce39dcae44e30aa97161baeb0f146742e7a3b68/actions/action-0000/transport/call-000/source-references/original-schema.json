{
  "$defs": {
    "Control": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "question": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "unit_of_assessment": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Unit Of Assessment",
          "type": "string"
        },
        "actor": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "temporal_basis": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Temporal Basis",
          "type": "string"
        },
        "result_kind": {
          "enum": [
            "REQUIREMENT_APPLIES",
            "REQUIREMENT_SATISFIED",
            "PROHIBITED",
            "COMPLIANT",
            "DUTY_TRIGGER",
            "DUTY_STATE",
            "CLASSIFICATION"
          ],
          "title": "Result Kind",
          "type": "string"
        },
        "true_means": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "True Means",
          "type": "string"
        },
        "false_means": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "False Means",
          "type": "string"
        },
        "source_evidence": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Source Evidence",
          "type": "array"
        }
      },
      "required": [
        "control_id",
        "question",
        "unit_of_assessment",
        "actor",
        "temporal_basis",
        "result_kind",
        "true_means",
        "false_means",
        "source_evidence"
      ],
      "title": "Control",
      "type": "object"
    },
    "QuestionAssignment": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "question": {
          "$ref": "#/$defs/Control"
        },
        "assignment_status": {
          "enum": [
            "PROPOSED",
            "UNCERTAIN"
          ],
          "title": "Assignment Status",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "question",
        "assignment_status"
      ],
      "title": "QuestionAssignment",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Unit Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "quote"
      ],
      "title": "Quote",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assignments": {
      "items": {
        "$ref": "#/$defs/QuestionAssignment"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Assignments",
      "type": "array"
    }
  },
  "required": [
    "assignments"
  ],
  "title": "Questions",
  "type": "object"
}
