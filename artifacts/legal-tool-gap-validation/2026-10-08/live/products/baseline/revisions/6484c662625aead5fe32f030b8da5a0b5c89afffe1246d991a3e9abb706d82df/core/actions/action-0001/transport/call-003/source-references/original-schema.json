{
  "$defs": {
    "DimensionFinding": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "scope",
            "definitions",
            "exceptions",
            "modality",
            "time",
            "dependencies"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "status": {
          "enum": [
            "PROPOSED",
            "AMBIGUOUS",
            "NOT_APPLICABLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_unit_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Source Unit Ids",
          "type": "array"
        },
        "explanation": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "status",
        "source_unit_ids",
        "explanation"
      ],
      "title": "DimensionFinding",
      "type": "object"
    },
    "Disposition": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Unit Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "INTERPRETED",
            "CONTEXT",
            "DEFERRED",
            "UNCERTAIN"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "status",
        "reason"
      ],
      "title": "Disposition",
      "type": "object"
    },
    "FactDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "bool",
            "integer",
            "money_hkd",
            "date"
          ],
          "title": "Type",
          "type": "string"
        },
        "meaning": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "unit": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "source_unit_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Source Unit Ids",
          "type": "array"
        },
        "requires_judgment": {
          "title": "Requires Judgment",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "type",
        "meaning",
        "unit",
        "source_unit_ids",
        "requires_judgment"
      ],
      "title": "FactDefinition",
      "type": "object"
    },
    "Formalization": {
      "additionalProperties": false,
      "properties": {
        "facts": {
          "items": {
            "$ref": "#/$defs/FactDefinition"
          },
          "maxItems": 30,
          "title": "Facts",
          "type": "array"
        },
        "scope": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "result": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Result",
          "type": "string"
        },
        "result_type": {
          "enum": [
            "bool",
            "integer",
            "money_hkd",
            "date"
          ],
          "title": "Result Type",
          "type": "string"
        }
      },
      "required": [
        "facts",
        "scope",
        "result",
        "result_type"
      ],
      "title": "Formalization",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Unit Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "quote"
      ],
      "title": "Quote",
      "type": "object"
    },
    "Reading": {
      "additionalProperties": false,
      "properties": {
        "local_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Local Id",
          "type": "string"
        },
        "family": {
          "enum": [
            "scope",
            "definitions",
            "exceptions",
            "modality",
            "time",
            "dependencies"
          ],
          "title": "Family",
          "type": "string"
        },
        "subject": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "distinction": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Distinction",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Assumptions",
          "type": "array"
        },
        "questions": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Questions",
          "type": "array"
        },
        "formalization": {
          "anyOf": [
            {
              "$ref": "#/$defs/Formalization"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "local_id",
        "family",
        "subject",
        "statement",
        "distinction",
        "citations",
        "assumptions",
        "questions",
        "formalization"
      ],
      "title": "Reading",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "readings": {
      "items": {
        "$ref": "#/$defs/Reading"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Readings",
      "type": "array"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/DimensionFinding"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Dimensions",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/Disposition"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    },
    "questions": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Questions",
      "type": "array"
    }
  },
  "required": [
    "readings",
    "dimensions",
    "coverage",
    "questions"
  ],
  "title": "Generation",
  "type": "object"
}
