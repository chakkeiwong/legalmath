{
  "$defs": {
    "ClaimCheck": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Claim Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "label": {
          "enum": [
            "ENTAILED",
            "CONTRADICTED",
            "NOT_ESTABLISHED"
          ],
          "title": "Label",
          "type": "string"
        },
        "source_evidence": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "maxItems": 12,
          "title": "Source Evidence",
          "type": "array"
        },
        "representation_quotes": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Representation Quotes",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "failing_stage": {
          "enum": [
            "NONE",
            "EXTRACTION",
            "INTERPRETATION",
            "FORMALIZATION",
            "DEPENDENCY"
          ],
          "title": "Failing Stage",
          "type": "string"
        },
        "question": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Question"
        }
      },
      "required": [
        "claim_id",
        "candidate_id",
        "label",
        "source_evidence",
        "representation_quotes",
        "rationale",
        "failing_stage",
        "question"
      ],
      "title": "ClaimCheck",
      "type": "object"
    },
