{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalmath.invalid/spec/0.1/java-build-manifest",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "JavaBuildManifest"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "generated_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jar_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "java_target": {
      "const": 17
    },
    "compiler": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision_engine": {
      "type": "string",
      "minLength": 1
    },
    "event_engine": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "record_type",
    "bundle_hash",
    "source_hashes",
    "generated_sha256",
    "runtime_sha256",
    "jar_sha256",
    "java_target",
    "compiler",
    "command",
    "dependencies",
    "licenses",
    "decision_engine",
    "event_engine"
  ],
  "additionalProperties": false
}
