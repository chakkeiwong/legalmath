{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalmath.invalid/spec/0.1/verification-report",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "VerificationReport"
    },
    "build_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jar_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference_engine": {
      "type": "string",
      "minLength": 1
    },
    "corpus_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "evidence_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "passed",
          "evidence_hash"
        ],
        "additionalProperties": false
      }
    },
    "passed": {
      "type": "boolean"
    }
  },
  "required": [
    "record_type",
    "build_manifest_hash",
    "jar_sha256",
    "bundle_hash",
    "reference_engine",
    "corpus_hash",
    "commands",
    "checks",
    "passed"
  ],
  "additionalProperties": false
}
