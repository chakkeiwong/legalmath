        "hypothesis.872a552016870edbc645daed": {
          "local_id": "ordinary-course-negation-shared",
          "family": "scope",
          "subject": "Under a proposed parse of the Q3 ordinary-course sentence, is the antecedent of the qualified single-family-office business guidance satisfied?",
          "statement": "[TRUE_IS_SATISFIED] The antecedent is satisfied under shared negation when a genuine single family office receives no income beyond reimbursement and has no profit objective.",
          "distinction": "Negation scopes over both coordinated predicates. True means the arrangement is genuine, receives no income beyond reimbursement, and lacks a profit objective.",
          "citations": [
            {
              "unit_id": "daa1876316641.u40.28601",
              "quote": "What amounts to “carrying on a business in Hong Kong” is not defined in the Ordinance and will need to be determined by reference to the facts of each case, including whether the person is performing an occupation or a duty which requires attention; the activity involves continuity; the activity is capable of making profit; and the activity was carried out for the purpose of making profit.  A genuine single family office arrangement, established to serve the investment needs of members of a single family, which is not being run as a business (i.e. not receiving any income, other than reimbursement of operating expenses from the family) or have the pursuit of profit as its business objective, should not in the ordinary course be considered as carrying on a business from a licensing perspective.  It is also not the SFC’s intent to extend its regulatory oversight to this type of single family office setup."
            }
          ],
          "assumptions": [
            "The conclusion retains should not in the ordinary course; this predicate does not establish a licensing exemption or compliance.",
            "Business status remains case-specific under the surrounding paragraph and its non-exhaustive factors.",
            "The wider regulated-activity, carve-out and territory questions remain outside this antecedent experiment.",
            "This bounded experiment uses income beyond reimbursement as the sentence's parenthetical operational reading of being run as a business; this is not a general business classification and may be inadequate.",
            "Facts concern the same arrangement and period; unknown or conflicting evidence is not filled in.",
            "The relative clause coordinates two negative conditions: the arrangement is not run as a business and does not have profit as its business objective.",
            "The parenthetical “i.e.” explains the first negative condition and does not alter the separate profit-objective condition."
          ],
          "questions": [
            "Does the coordination support reading “not” as shared across both predicates despite the mismatch between “is” and “have”?"
          ],
          "formalization": {
            "facts": [
              {
                "name": "genuine_family_arrangement",
                "type": "bool",
                "meaning": "The arrangement is a genuine single family office established to serve the investment needs of members of a single family.",
                "unit": "truth value",
                "source_unit_ids": [
                  "daa1876316641.u40.28601"
                ],
                "requires_judgment": true
              },
              {
                "name": "income_beyond_reimbursement",
                "type": "bool",
                "meaning": "The arrangement receives income other than reimbursement of operating expenses from the family.",
                "unit": "truth value",
                "source_unit_ids": [
                  "daa1876316641.u40.28601"
                ],
                "requires_judgment": true
              },
              {
                "name": "profit_objective",
                "type": "bool",
                "meaning": "The arrangement has the pursuit of profit as its business objective.",
                "unit": "truth value",
                "source_unit_ids": [
                  "daa1876316641.u40.28601"
                ],
                "requires_judgment": true
              }
            ],
            "scope": "true",
            "result": "(and genuine_family_arrangement (not income_beyond_reimbursement) (not profit_objective))",
            "result_type": "bool"
          }
        },
