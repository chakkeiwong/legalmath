ce_unit_ids":["u1","u3","u9"],"type":"bool","unit":"Boolean"},{"meaning":"IPD administers the investment product concerned in the assessed event.","name":"product_administered_by_ipd","requires_judgment":true,"source_unit_ids":["u1","u9"],"type":"bool","unit":"Boolean"},{"meaning":"The investment product concerned belongs to at least one category listed in footnote 1.","name":"product_in_footnote_list","requires_judgment":true,"source_unit_ids":["u17"],"type":"bool","unit":"Boolean"},{"meaning":"The Gregorian calendar date on which the assessed application or submission is made.","name":"submission_date","requires_judgment":false,"source_unit_ids":["u1","u9"],"type":"date","unit":"Gregorian calendar date"},{"meaning":"The assessed application or submission is submitted to IPD through e-IP.","name":"submitted_via_eip","requires_judgment":false,"source_unit_ids":["u1","u9"],"type":"bool","unit":"Boolean"}],"result":"submitted_via_eip","result_type":"bool","scope":"(and is_application_or_submission product_administered_by_ipd product_in_footnote_list (>= submission_date (date 2024-11-30)))"},"local_id":"r1","questions":["Does the footnote have a limiting definitional function?","How should hybrid products or disputed category membership be classified?"],"statement":"Selected control—compulsory e-IP routing: an application or submission to IPD made on or after 30 November 2024 must use e-IP when it concerns an IPD-administered product within footnote 1's enumerated categories. The extended parallel run permits existing channels through 29 November. Optional fee payment and practicability of SFC enhancements do not qualify this routing duty.","subject":"Compulsory e-IP routing with an exhaustive product list"},"protocol":"legalmath.search.v1","role":"adversarial-investigator","source_packet":{"authority":"RETAINED_SOURCE","dependencies":[{"dependency_id":"external-authorities.24ec50","source_hash":null}],"family_ids":["scope","definitions","exceptions","modality","time","dependencies"],"selected_slice":"Selected control: the compulsory electronic submission route and its transition date. Account for the whole source as context; do not invent duties for optional facilities.","source_key":"sfc.24ec50.search","units":[{"locator":"Retained text line 1","normative":true,"span":{"end":424,"id":"s.u1","page":1,"quote_sha256":"70ee7250eeb7b965a9f36fea7033b47195b54623f1df2b278429b9ad341b7041","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":0,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"This circular informs the industry that the Securities and Futures Commission (SFC) will extend the parallel run period of its new online application/submission system for investment products, e-IP, by one month to 29 November 2024. After the extended period, applications and submissions of investment products administered by the Investment Products Division (IPD)1 must be submitted to IPD via e-IP from 30 November 2024.","unit_id":"u1"},{"locator":"Retained text line 2","normative":true,"span":{"end":437,"id":"s.u2","page":1,"quote_sha256":"ea2b8a878841df5955c78edc6cae47446483b86e3f5ccb04e1a8d940cf7e59fd","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":427,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"Background","unit_id":"u2"},{"locator":"Retained text line 3","normative":true,"span":{"end":734,"id":"s.u3","page":1,"quote_sha256":"6dd2652b9a49ce7c352f98e5230cf5742e20f2ed218efc06086398f209c8be86","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":439,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"Following the “Circular on launch of e-IP application/submission system on WINGS” dated 8 July 2024, the SFC launched e-IP on its WINGS2 portal on 29 July 2024 to streamline and enhance the efficiency of processing new product applications and post-authorisation/registration submissions to IPD.","unit_id":"u3"},{"locator":"Retained text line 4","normative":true,"span":{"end":954,"id":"s.u4","page":1,"quote_sha256":"5485d462df3cc79af89f6c4cf8e4463555ef205796f5e9e410f0a36a68d037a2","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":737,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"A three-month period of parallel run from the launch of e-IP up to 29 October 2024 was provided at the initial stage. During this period, the SFC continues to accept applications and submissions via existing channels.","unit_id":"u4"},{"locator":"Retained text line 5","normative":true,"span":{"end":1011,"id":"s.u5","page":1,"quote_sha256":"54513ae6db769b044b5e307776db8b64749d00e78e99c8023eec503d86cbd09b","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":956,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"Parallel run period extension and upcoming enhancements","unit_id":"u5"},{"locator":"Retained text line 6","normative":true,"span":{"end":1185,"id":"s.u6","page":1,"quote_sha256":"ae8025e775a524055d7dde8da0a2413c689018f34c1c186de6f9be553d7f51d4","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":1013,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"Since its implementation, the SFC has closely monitored the functioning of e-IP and actively engaged with industry participants to obtain their feedback on user experience.","unit_id":"u6"},{"locator":"Retained text line 7","normative":true,"span":{"end":1503,"id":"s.u7","page":1,"quote_sha256":"9c3d8ebc66be0cb7e3a70941a0d925f4220ca2db57fde8edf06bd65d69366155","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":1187,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"While e-IP has garnered widespread industry support and is running smoothly, new features and more advanced settings will be introduced to further enhance user experience based on users’ comments. To facilitate these enhancements, the SFC will extend the parallel run period of e-IP by one month to 29 November 2024.","unit_id":"u7"},{"locator":"Retained text line 8","normative":true,"span":{"end":1526,"id":"s.u8","page":1,"quote_sha256":"f8ea1bb0c6eb553da747db18a062061d29ce9c517ac82d03266b19472652bdd8","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":1505,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"Full adoption of e-IP","unit_id":"u8"},{"locator":"Retained text line 9","normative":true,"span":{"end":2009,"id":"s.u9","page":1,"quote_sha256":"69a8f8c21086c4223a4406cea95c3b870ea3b3fd7db8affa2d78a0c4ea0977d1","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":1528,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"Starting 30 November 2024, ie, after the parallel run period, applications and submissions of investment products administered by IPD must be submitted via e-IP. The current submission requests from IPD via the IP E-submission system will be integrated into e-IP, including reporting of net asset values, large redemptions and suspensions of dealing. In addition, e-IP users can also settle recurring annual fees associated with relevant investment products through the new system.","unit_id":"u9"},{"locator":"Retained text line 10","normative":true,"span":{"end":2033,"id":"s.u10","page":1,"quote_sha256":"a84bc14b3eb8ea57129a0ba9ad1d7188a5ca29171867d4d394efa4bdab6b14e5","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":2011,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"Feedback and enquiries","unit_id":"u10"},{"locator":"Retained text line 11","normative":true,"span":{"end":2189,"id":"s.u11","page":1,"quote_sha256":"d968cc66fb9127305c4faecfe1e7314b2ade507d9ba019bf4480381b45aff075","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":2035,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"The SFC will continue to review and enhance the operation of e-IP where practicable. If you have any questions, please contact the relevant case officers.","unit_id":"u11"},{"locator":"Retained text line 12","normative":true,"span":{"end":2219,"id":"s.u12","page":1,"quote_sha256":"2262a17aa8ece28244aedc22e1f37fce7075bbeb018d04e4b3b36c1c9d0199ce","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":2191,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"Investment Products Division","unit_id":"u12"},{"locator":"Retained text line 13","normative":true,"span":{"end":2253,"id":"s.u13","page":1,"quote_sha256":"88e2bc94e9edc39f2ac1cdaaea86b44ab5ea59b31c446f69591f21bf460b005e","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":2220,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"Securities and Futures Commission","unit_id":"u13"},{"locator":"Retained text line 14","normative":true,"span":{"end":2259,"id":"s.u14","page":1,"quote_sha256":"f4db1e48476f60753980b10d66219042b3a3d9c65c9cc77a53d81b88fd869c64","raw_sha256":"fbd54d2f2ef063334df5c30ae20bc4bc47fc332a8b201a10730cd242055ea1a4","source_id":"24EC50","start":2256,"text_sha256":"31ea1ec5eb95fa7f7f9dcb9e090d3a2f3fe4754a01c2613bc94c4741f749dba3"},"text":"End","u