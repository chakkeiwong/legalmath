{
  "bundle_id": "candidate.23ec49.strict_six_months",
  "facts": [
    {
      "description": "Reviewed product authorisation and Chapter 8.2 classification",
      "name": "authorised_mmf",
      "type": "bool"
    },
    {
      "description": "Relevant material shows annualised returns based on less than one year",
      "name": "annualised_under_year",
      "type": "bool"
    },
    {
      "description": "Seven-day annualised return in the same document",
      "name": "seven_day_present",
      "type": "bool"
    },
    {
      "description": "Computation basis disclosed; fairness is not decided by this flag",
      "name": "basis_disclosed",
      "type": "bool"
    },
    {
      "description": "Completed calendar months, supplied after reviewed calendar calculation",
      "name": "track_record_months",
      "type": "integer"
    },
    {
      "description": "An additional period annualised return is displayed",
      "name": "additional_return",
      "type": "bool"
    },
    {
      "description": "Positive whole-day length of the additional return period",
      "name": "additional_days",
      "type": "integer"
    },
    {
      "description": "Reviewed publication-channel classification",
      "name": "interactive",
      "type": "bool"
    },
    {
      "description": "Online short-period figures updated daily",
      "name": "updated_daily",
      "type": "bool"
    },
    {
      "description": "Printed note directs investors to current daily figures",
      "name": "daily_figure_link",
      "type": "bool"
    }
  ],
  "interpretations": [
    {
      "basis": "reviewer_interpretation",
      "id": "meaning.slice",
      "issue_ids": [
        "pending.meaning"
      ],
      "source_span_ids": [
        "s.23ec49.u0000",
        "s.23ec49.u0011",
        "s.23ec49.u0012",
        "s.23ec49.u0017",
        "s.23ec49.u0024",
        "s.23ec49.u0025",
        "s.23ec49.u0026"
      ],
      "statement": "Challenge: track record must exceed six months."
    }
  ],
  "rules": [
    {
      "body": {
        "args": [
          {
            "name": "basis_disclosed",
            "node_id": "n.4",
            "op": "fact"
          },
          {
            "cmp": "gt",
            "left": {
              "name": "track_record_months",
              "node_id": "n.5",
              "op": "fact"
            },
            "node_id": "n.7",
            "op": "compare",
            "right": {
              "node_id": "n.6",
              "op": "literal",
              "type": "integer",
              "value": "6"
            }
          },
          {
            "name": "seven_day_present",
            "node_id": "n.8",
            "op": "fact"
          },
          {
            "condition": {
              "args": [
                {
                  "name": "additional_return",
                  "node_id": "n.9",
                  "op": "fact"
                },
                {
                  "cmp": "gt",
                  "left": {
                    "node_id": "n.10",
                    "op": "literal",
                    "type": "integer",
                    "value": "7"
                  },
                  "node_id": "n.12",
                  "op": "compare",
                  "right": {
                    "name": "additional_days",
                    "node_id": "n.11",
                    "op": "fact"
                  }
                }
              ],
              "node_id": "n.13",
              "op": "all"
            },
            "else": {
              "node_id": "n.18",
              "op": "literal",
              "type": "bool",
              "value": true
            },
            "node_id": "n.19",
            "op": "if",
            "then": {
              "condition": {
                "name": "interactive",
                "node_id": "n.14",
                "op": "fact"
              },
              "else": {
                "name": "daily_figure_link",
                "node_id": "n.16",
                "op": "fact"
              },
              "node_id": "n.17",
              "op": "if",
              "then": {
                "name": "updated_daily",
                "node_id": "n.15",
                "op": "fact"
              }
            }
          }
        ],
        "node_id": "n.20",
        "op": "all"
      },
      "id": "selected.control",
      "interpretation_id": "meaning.slice",
      "scope": {
        "args": [
