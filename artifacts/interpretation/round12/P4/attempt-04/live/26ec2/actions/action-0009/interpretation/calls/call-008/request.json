stributionWeb/gateway/EN/circular/doc?refNo=26EC2 chars 3250:3322","normative":true,"span":{"end":3322,"id":"s.da12aecad4e68.u26.3250","page":1,"quote_sha256":"a34dae95e3fa959d32e3b9d449ce3d6673bb0f9164701b66ec63aa9baa87e7df","raw_sha256":"63957c97961f486576f1ba5d508a3514afd355f8914fff1be1d6d6af8128ed45","source_id":"da12aecad4e68","start":3250,"text_sha256":"4b0ef5d38aceea3f9aeb478e6e7fa2935e21e1fd959fd8629f6a9658b3852912"},"text":"f206230e309e4f5ba196bca77dfe46b9&hash=408F99B6D8750D895676F20D9A09A302).","unit_id":"da12aecad4e68.u26.3250"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC2 chars 3328:3329","normative":true,"span":{"end":3329,"id":"s.da12aecad4e68.u27.3328","page":1,"quote_sha256":"d4735e3a265e16eee03f59718b9b5d03019c07d8b6c51f90da3a666eec13ab35","raw_sha256":"63957c97961f486576f1ba5d508a3514afd355f8914fff1be1d6d6af8128ed45","source_id":"da12aecad4e68","start":3328,"text_sha256":"4b0ef5d38aceea3f9aeb478e6e7fa2935e21e1fd959fd8629f6a9658b3852912"},"text":"2","unit_id":"da12aecad4e68.u27.3328"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC2 chars 3334:3557","normative":true,"span":{"end":3557,"id":"s.da12aecad4e68.u28.3334","page":1,"quote_sha256":"ff9acde946400f033ce7d1579a1d9dd927c92d61dc19575646abdc188a843b4c","raw_sha256":"63957c97961f486576f1ba5d508a3514afd355f8914fff1be1d6d6af8128ed45","source_id":"da12aecad4e68","start":3334,"text_sha256":"4b0ef5d38aceea3f9aeb478e6e7fa2935e21e1fd959fd8629f6a9658b3852912"},"text":"For STRs submitted to the JFIU via channels other than STREAMS 2 following its implementation, licensed firms are required to re-submit the STRs via STREAMS 2. The JFIU will provide guidance to facilitate the re-submission.","unit_id":"da12aecad4e68.u28.3334"},{"locator":"https://apps.sfc.hk/edistributionWeb/gateway/EN/circular/doc?refNo=26EC2 chars 3563:3564","normative":true,"span":{"end":3564,"id":"s.da12aecad4e68.u29.3563","page":1,"quote_sha256":"4e07408562bedb