nit_id":"da12aecad4e68.u0.0"},{"quote":"Licensed firms are required to submit STRs to the JFIU via STREAMS 2 by one of the following means:","unit_id":"da12aecad4e68.u3.811"},{"quote":"submission of an STR in an Extensible Markup Language (XML) format3;","unit_id":"da12aecad4e68.u4.1003"},{"quote":"uploading a completed STR form in the prescribed PDF format3; or","unit_id":"da12aecad4e68.u5.1078"},{"quote":"completing the web-based STR form in STREAMS 2.","unit_id":"da12aecad4e68.u6.1149"},{"quote":"upon the launch of STREAMS 2 at 9:00am on 2 February 2026","unit_id":"da12aecad4e68.u13.2131"},{"quote":"Hongkong Post e-Cert (electronic certificate) is required for this submission.","unit_id":"da12aecad4e68.u30.3569"}],"distinction":"A completed web-form submission through STREAMS 2 without e-Cert can satisfy this selected control; an XML or prescribed-PDF submission without e-Cert cannot. A rival requiring e-Cert for all three methods lacks a footnote marker on option (c), so it is not proposed as an equally supported reading.","family":"exceptions","formalization":{"facts":[{"meaning":"The actor for the identified STR falls within the circular's defined licensed firms.","name":"licensed_firm","requires_judgment":true,"source_unit_ids":["da12aecad4e68.u0.0"],"type":"bool","unit":"Boolean"},{"meaning":"The identified STR submission occurs at or after the stated STREAMS 2 launch instant, 9:00am on 2 February 2026; supplied using an externally resolved timezone.","name":"post_launch_submission","requires_judgment":true,"source_unit_ids":["da12aecad4e68.u11.1700","da12aecad4e68.u13.2131"],"type":"bool","unit":"Boolean"},{"meaning":"The identified STR submission is made to JFIU through STREAMS 2.","name":"via_streams2","requires_judgment":false,"source_unit_ids":["da12aecad4e68.u3.811"],"type":"bool","unit":"Boolean"},{"meaning":"The identified STR is submitted in XML format; this records format selection, not conformity with the separately supplied schema.","name":"xml_s