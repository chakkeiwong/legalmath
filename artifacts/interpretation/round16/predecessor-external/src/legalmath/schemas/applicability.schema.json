{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalmath.invalid/spec/0.1/applicability",
  "type": "object",
  "properties": {
    "assessment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "legal_entity": {
      "type": "string",
      "minLength": 1
    },
    "regulated_role": {
      "type": "string",
      "minLength": 1
    },
    "activity": {
      "type": "string",
      "minLength": 1
    },
    "product_class": {
      "type": "string",
      "minLength": 1
    },
    "client_class": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "conclusion": {
      "enum": [
        "in_scope",
        "out_of_scope",
        "unresolved"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "source_span_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      }
    },
    "reviewer_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    }
  },
  "required": [
    "assessment_id",
    "bundle_hash",
    "legal_entity",
    "regulated_role",
    "activity",
    "product_class",
    "client_class",
    "jurisdiction",
    "valid_from",
    "valid_until",
    "conclusion",
    "reason",
    "source_span_ids",
    "reviewer_id"
  ],
  "additionalProperties": false
}
