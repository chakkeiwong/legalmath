{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalmath.invalid/spec/0.1/boundary-error",
  "type": "object",
  "properties": {
    "error": {
      "const": "BOUNDARY_ERROR"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "pointer",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "error",
    "diagnostics"
  ],
  "additionalProperties": false
}
