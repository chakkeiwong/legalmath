  return flag;
}
function isQueryValid(thisForm,lang) {
  var flag = 1;
  switch(lang) {
    case 1:
      if (!thisForm.query.value || tcClear==0){
        flag=0;
      }
      break;
    default:
      if (!thisForm.query.value || enClear==0){
        flag=0;
      }
  }
  return flag;
}
