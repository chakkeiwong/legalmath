prefix_rule(
    pattern = ["python3", "-m", "scripts.prospectus_integration_repair", ["preflight", "check", "layout", "authoring", "feasibility", "analyze", "run", "status"]],
    decision = "allow",
    justification = "User-authorized finite integration repair; fixed CPU jobs, localhost-only server, no arbitrary shell or URL arguments.",
    match = ["python3 -m scripts.prospectus_integration_repair layout", "python3 -m scripts.prospectus_integration_repair authoring"],
    not_match = ["python3 -c pass", "python3 -m scripts.prospectus_integration_repair authorize", "python3 -m scripts.another_program run"],
)
