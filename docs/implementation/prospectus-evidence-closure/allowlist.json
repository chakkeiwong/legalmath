{
  "entrypoint": [".venv/bin/python", "scripts/run_prospectus_evidence_master.py", "close"],
  "actions": ["status", "check", "phase", "run", "verify", "inspect", "render", "rules"],
  "phases": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7"],
  "max_execution_seconds": 14400,
  "max_command_seconds": 900,
  "max_failures_per_input": 3,
  "max_http_requests_including_continuation": 112,
  "max_requests_per_url": 2,
  "max_http_seconds": 45,
  "max_response_bytes": 33554432,
  "public_hosts": ["www.basf.com", "www.enel.com", "www.unilever.com", "www.sec.gov", "www.lloydsbankinggroup.com", "sebgroup.com", "webapp.sebgroup.com", "www.lvmh.com", "lvmh-com.cdn.prismic.io", "shareholdersandinvestors.bbva.com", "dl.bourse.lu", "www.luxse.com", "graphqlaz.luxse.com", "dl.luxse.com", "accionistaseinversores.bbva.com", "live.euronext.com", "www.hkma.gov.hk", "brdr.hkma.gov.hk"],
  "cpu_only": true,
  "paid_model_calls": 0,
  "dependency_installations": false,
  "private_data_fetching": false,
  "arbitrary_shell_arguments": false,
  "preserve_previous_campaigns": true,
  "global_rule": "Already installed: [.venv/bin/python, scripts/run_prospectus_evidence_master.py]",
  "local_edits": [".venv/bin/python", "scripts/edit_workspace_files.py"],
  "host_review": "Exact issuer, regulator and exchange hosts retained in the predecessor acquisition policy. No wildcard, credentials, non-HTTPS ports or automatic redirects. Every dispatched URL must also appear in the reviewed closure queue."
}
