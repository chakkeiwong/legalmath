prefix_rule(
    pattern = [".venv/bin/python", "scripts/run_prospectus_evidence_master.py", "close"],
    decision = "allow",
    justification = "User-authorised prospectus closure: fixed CPU phases, public source queue, tests and reports, with protected historical evidence and finite request budgets.",
    match = [".venv/bin/python scripts/run_prospectus_evidence_master.py close run", ".venv/bin/python scripts/run_prospectus_evidence_master.py close check"],
    not_match = ["python scripts/run_prospectus_evidence_master.py close run", ".venv/bin/python -c pass"],
)
