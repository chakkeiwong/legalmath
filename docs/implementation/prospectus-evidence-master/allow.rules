prefix_rule(
    pattern = [".venv/bin/python", "scripts/run_prospectus_evidence_master.py"],
    decision = "allow",
    justification = "User-authorised bounded prospectus evidence master: fixed actions, public sources, CPU tests, repairs and versioned reports; no arbitrary command input.",
    match = [".venv/bin/python scripts/run_prospectus_evidence_master.py run", ".venv/bin/python scripts/run_prospectus_evidence_master.py status"],
    not_match = [".venv/bin/python -c print(1)", ".venv/bin/python scripts/another.py run"],
)
