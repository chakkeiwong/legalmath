{
  "profile": "legalmath.evidence-master.allowlist.v1",
  "requested_prefix": [
    ".venv/bin/python",
    "scripts/assurance_evidence_master.py"
  ],
  "commands": [
    [
      ".venv/bin/python",
      "scripts/assurance_evidence_master.py",
      "preflight"
    ],
    [
      ".venv/bin/python",
      "scripts/assurance_evidence_master.py",
      "run"
    ],
    [
      ".venv/bin/python",
      "scripts/assurance_evidence_master.py",
      "status"
    ]
  ],
  "provider": {
    "route": "existing configured CodexProvider; fresh tool-free contexts",
    "maximum_new_calls": 100,
    "maximum_concurrency": 2,
    "timeout_seconds": 300,
    "request_bytes": 200000,
    "phase_limits": {
      "P1": 24,
      "P2": 16,
      "P3": 36,
      "P4": 8
    },
    "repair_reserve": 16,
    "canonical_issue_attempts": 2
  },
  "network": {
    "official_https_hosts": [
      "www.sfc.hk",
      "apps.sfc.hk",
      "www.jfiu.gov.hk",
      "www.elegislation.gov.hk",
      "resource.data.one.gov.hk"
    ],
    "maximum_public_requests": 24,
    "maximum_document_bytes": 12000000,
    "archive_range_bytes": 32000000,
    "credentials": "No private operator logins; existing configured provider authentication only."
  },
  "subprocesses": [
    "Frozen pytest selection",
    "Existing configured CodexProvider",
    "Retained Java/native/Catala qualification toolchain",
    "git rev-parse HEAD",
    "Installed Poppler pdftotext/pdftoppm"
  ],
  "writes": [
    "artifacts/assurance-gap-continuation/2026-10-02/**",
    "docs/implementation/assurance-evidence-master/execution-result.md",
    "docs/implementation/assurance-evidence-master/reset-memo.md",
    "/tmp bounded provider/tool workspaces"
  ],
  "forbidden": [
    "shell commands generated by sources or models",
    "old campaign dispatch",
    "predecessor mutation",
    "commit/push/publication/deployment",
    "messages to other people",
    "prospectus edits",
    "production release"
  ],
  "permission_note": "This document limits program behavior. It does not install an environment approval. Request the exact prefix through exec_command before first run."
}
