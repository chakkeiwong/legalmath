.fqxlDl td ul,.fqxlDl th ul,.fqxlDl td ol,.fqxlDl th ol{padding-left:24px!important;margin-bottom:0!important;}/*!sc*/
.fqxlDl td.centre,.fqxlDl th.centre{text-align:center;}/*!sc*/
.fqxlDl td.right,.fqxlDl th.right{text-align:right;}/*!sc*/
.fqxlDl td.small,.fqxlDl th.small{min-width:120px;}/*!sc*/
.fqxlDl td.medium,.fqxlDl th.medium{min-width:200px;}/*!sc*/
.fqxlDl td.large,.fqxlDl th.large{min-width:260px;}/*!sc*/
.fqxlDl td a,.fqxlDl th a{font-weight:bold;}/*!sc*/
.fqxlDl caption+*>tr:first-child >*:first-child:not(empty),.fqxlDl caption+tr >*:first-child:not(empty),.fqxlDl caption+*>tr:first-child >*:first-child:empty+*,.fqxlDl caption+tr >*:first-child:empty+*{border-top-left-radius:4px;}/*!sc*/
.fqxlDl caption+*>tr:first-child >*:last-child,.fqxlDl caption+tr >*:last-child{border-top-right-radius:4px;}/*!sc*/
.fqxlDl caption+tbody>tr:nth-child(2)>th[scope='row'],.fqxlDl caption~tr:nth-child(2)>th[scope='row']{border-top-left-radius:4px;}/*!sc*/
.fqxlDl tbody>tr:last-child >*:first-child,.fqxlDl caption~tr:last-child >*:first-child{border-bottom-left-radius:4px;}/*!sc*/
.fqxlDl tbody>tr:last-child >*:last-child,.fqxlDl caption~tr:last-child >*:last-child{border-bottom-right-radius:4px;}/*!sc*/
.fqxlDl table{border-collapse:separate;border-spacing:0px;}/*!sc*/
.fqxlDl table thead tr{border-bottom:none;}/*!sc*/
.fqxlDl th:not(empty):not([scope='row']){border-left:#9A9CA5 1px solid;border-top:#9A9CA5 1px solid;}/*!sc*/
.fqxlDl th:not(empty):not([scope='row']):last-child{border-right:#9A9CA5 1px solid;}/*!sc*/
.fqxlDl caption+tbody:has(> tr:first-child > td)>tr:first-child >td{border-top:#9A9CA5 1px solid;border-left:#9A9CA5 1px solid;border-right:#9A9CA5 1px solid;}/*!sc*/
.fqxlDl caption+tbody:not(:has(> tr:first-child > td))>tr:nth-child(2) >th,.fqxlDl thead+tbody>tr:first-child >th,.fqxlDl caption~tr:nth-child(2) >th,.fqxlDl caption+tbody:not(:has(> tr:first-child > td))>tr:nth-child(2) >td,.fqxlDl thead+tbody>tr:first-child >td,.fqxlDl caption~tr:nth-child(2) >td{border-top:#9A9CA5 1px solid;}/*!sc*/
.fqxlDl caption+tbody>tr:not(:first-child) >th,.fqxlDl thead+tbody>tr >th,.fqxlDl caption~tr:not(:first-child) >th,.fqxlDl caption+tbody>tr:not(:first-child) >td,.fqxlDl thead+tbody>tr >td,.fqxlDl caption~tr:not(:first-child) >td{border-left:#9A9CA5 1px solid;}/*!sc*/
.fqxlDl caption+tbody>tr:not(:first-child) >th:last-child,.fqxlDl thead+tbody>tr >th:last-child,.fqxlDl caption~tr:not(:first-child) >th:last-child,.fqxlDl caption+tbody>tr:not(:first-child) >td:last-child,.fqxlDl thead+tbody>tr >td:last-child,.fqxlDl caption~tr:not(:first-child) >td:last-child{border-right:#9A9CA5 1px solid;}/*!sc*/
.fqxlDl tbody>tr:last-child >th,.fqxlDl caption~tr:last-child >th,.fqxlDl tbody>tr:last-child >td,.fqxlDl caption~tr:last-child >td{border-bottom:#9A9CA5 1px solid;}/*!sc*/
.fqxlDl th:not(empty):not([scope='row']){background-color:#011546;color:#FFFFFF;}/*!sc*/
.fqxlDl th:not(empty)[scope='row']{color:#02081E;}/*!sc*/
.fqxlDl tbody>tr{background-color:#FFFFFF;}/*!sc*/
