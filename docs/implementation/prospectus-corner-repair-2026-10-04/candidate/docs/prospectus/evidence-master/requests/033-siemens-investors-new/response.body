    function breadCrumbContext() {
        const breadCrumbContextInputData = {
            'page': '4juhXOWUDImrp9Ggk9VzLd',
            'site': 'one',
            'locale': 'en-US'
        }

        if (typeof disw !== 'undefined' && disw.context && disw.context.addContextToLinks) {
            disw.context.addContextToLinks(breadCrumbContextInputData, 'bc');
        }
    }

    let rafScheduled = false;

    function domObserverCallback(mutations) {
        if (rafScheduled) return;

        const hasNewNodes = mutations.some(function(mutation) {
            return mutation.type === 'childList' && mutation.addedNodes.length > 0;
        });

        if (hasNewNodes) {
            rafScheduled = true;
            requestAnimationFrame(function() {
                breadCrumbContext();
                rafScheduled = false;
            });
        }
    }

    const observer = new MutationObserver(domObserverCallback);

    observer.observe(document, {
        childList: true,
        subtree: true
    });

    breadCrumbContext();

    if (document.readyState === 'complete') {
        observer.disconnect();
    } else {
        window.addEventListener('load', function() {
            requestAnimationFrame(function() {
                observer.disconnect();
            });
        });
    }
</script><script type="module" src="/shared-assets/b1f8327a3228f4d012ba778eb1f4826e8cf686cf/siteScripts/analyticsEventBinder.js"></script>
        
