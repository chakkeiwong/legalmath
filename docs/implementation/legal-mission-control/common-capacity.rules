# Narrow fixed actions for the reviewed common-capacity package.
# Installing a host rule requires host approval; this file is the reviewable proposal.
# Live authority remains the registered master grant and unchanged deadline.
prefix_rule(pattern=[".venv-context/bin/python", "scripts/legal_common_capacity_deploy.py", "status"], decision="allow")
prefix_rule(pattern=[".venv-context/bin/python", "scripts/legal_common_capacity_deploy.py", "arm"], decision="allow")
prefix_rule(pattern=[".venv-context/bin/python", "scripts/legal_common_capacity_replay.py"], decision="allow")
prefix_rule(pattern=[".venv-context/bin/python", "scripts/legal_common_capacity_work.py", "test"], decision="allow")
prefix_rule(pattern=[".venv-context/bin/python", "scripts/legal_integration_master.py", "gap-refresh"], decision="allow")
