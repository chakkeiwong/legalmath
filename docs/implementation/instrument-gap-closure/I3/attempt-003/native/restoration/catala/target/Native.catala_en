# Declared factual interface
> Using Integer_en as Integer
> Using Decimal_en as Decimal
> Using Date_en as Date
> Using List_en as List
```catala
declaration structure Meta:
  data s content integer
  data c content integer
  data refs content list of integer

declaration structure B0:
  data s content integer
  data c content integer
  data refs content list of integer
  data v content boolean

declaration scope SharedRule:
  input f0 content B0
  input f1 content B0
  input f2 content B0
  input f3 content B0
  input f4 content B0
  input f5 content B0
  input f6 content B0
  output r0 content B0
```

```catala
scope SharedRule:
  definition r0 equals (let v1 equals B0 { -- s: 0 -- c: 0 -- refs: [] -- v: true } in (if v1.s = 0 then (if v1.v then (let v12 equals (let v2 equals f0 in (let v3 equals f1 in (let v4 equals f2 in (let v5 equals f3 in (let v6 equals f4 in (let v7 equals f5 in (let v8 equals f6 in (let v11 equals (combine all v10 among [Meta { -- s: v2.s -- c: v2.c -- refs: v2.refs }; Meta { -- s: v3.s -- c: v3.c -- refs: v3.refs }; Meta { -- s: v4.s -- c: v4.c -- refs: v4.refs }; Meta { -- s: v5.s -- c: v5.c -- refs: v5.refs }; Meta { -- s: v6.s -- c: v6.c -- refs: v6.refs }; Meta { -- s: v7.s -- c: v7.c -- refs: v7.refs }; Meta { -- s: v8.s -- c: v8.c -- refs: v8.refs }] in v9 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v10.s > v9.s then v10.s else v9.s) -- c: (if v10.s > v9.s then v10.c else v9.c) -- refs: (v9.refs ++ v10.refs) }) in (if v11.s >= 2 then B0 { -- s: v11.s -- c: v11.c -- refs: v11.refs -- v: false } else if (v2.s = 0 and not v2.v) or (v3.s = 0 and not v3.v) or (v4.s = 0 and not v4.v) or (v5.s = 0 and not v5.v) or (v6.s = 0 and not v6.v) or (v7.s = 0 and not v7.v) or (v8.s = 0 and not v8.v) then B0 { -- s: 0 -- c: 0 -- refs: v11.refs -- v: false } else if v11.s = 1 then B0 { -- s: v11.s -- c: v11.c -- refs: v11.refs -- v: false } else B0 { -- s: v11.s -- c: v11.c -- refs: v11.refs -- v: true }))))))))) in (let v15 equals (combine all v14 among [Meta { -- s: v1.s -- c: v1.c -- refs: v1.refs }; Meta { -- s: v12.s -- c: v12.c -- refs: v12.refs }] in v13 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v14.s > v13.s then v14.s else v13.s) -- c: (if v14.s > v13.s then v14.c else v13.c) -- refs: (v13.refs ++ v14.refs) }) in B0 { -- s: v15.s -- c: v15.c -- refs: v15.refs -- v: v12.v })) else B0 { -- s: 4 -- c: v1.c -- refs: v1.refs -- v: false }) else B0 { -- s: v1.s -- c: v1.c -- refs: v1.refs -- v: false }))
```
