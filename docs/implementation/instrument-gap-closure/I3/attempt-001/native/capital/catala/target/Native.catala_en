# Declared factual interface
> Using Integer_en as Integer
> Using Decimal_en as Decimal
> Using Date_en as Date
> Using List_en as List
```catala
declaration structure Meta:
  data s content integer
  data c content integer
  data refs content list of integer

declaration structure B0:
  data s content integer
  data c content integer
  data refs content list of integer
  data v content boolean

declaration structure B1:
  data s content integer
  data c content integer
  data refs content list of integer
  data v content integer

declaration scope SharedRule:
  input f0 content B1
  input f1 content B1
  input f2 content B1
  output r0 content B0
```

```catala
scope SharedRule:
  definition r0 equals (let v1 equals B0 { -- s: 0 -- c: 0 -- refs: [] -- v: true } in (if v1.s = 0 then (if v1.v then (let v24 equals (let v19 equals (let v2 equals f2 in (let v5 equals (combine all v4 among [Meta { -- s: v2.s -- c: v2.c -- refs: v2.refs }] in v3 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v4.s > v3.s then v4.s else v3.s) -- c: (if v4.s > v3.s then v4.c else v3.c) -- refs: (v3.refs ++ v4.refs) }) in (if v5.s = 0 then (let v6 equals ((v2.v * 7) / 1) in (let v7 equals (integer of v6) in (if (decimal of v7) = v6 then B1 { -- s: v5.s -- c: v5.c -- refs: v5.refs -- v: v7 } else B1 { -- s: 3 -- c: 1 -- refs: v5.refs -- v: (0) }))) else B1 { -- s: v5.s -- c: v5.c -- refs: v5.refs -- v: (0) }))) in (let v20 equals (let v13 equals (let v8 equals f0 in (let v9 equals f1 in (let v12 equals (combine all v11 among [Meta { -- s: v8.s -- c: v8.c -- refs: v8.refs }; Meta { -- s: v9.s -- c: v9.c -- refs: v9.refs }] in v10 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v11.s > v10.s then v11.s else v10.s) -- c: (if v11.s > v10.s then v11.c else v10.c) -- refs: (v10.refs ++ v11.refs) }) in (if v12.s = 0 then B1 { -- s: v12.s -- c: v12.c -- refs: v12.refs -- v: (v8.v + v9.v) } else B1 { -- s: v12.s -- c: v12.c -- refs: v12.refs -- v: (0) })))) in (let v16 equals (combine all v15 among [Meta { -- s: v13.s -- c: v13.c -- refs: v13.refs }] in v14 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v15.s > v14.s then v15.s else v14.s) -- c: (if v15.s > v14.s then v15.c else v14.c) -- refs: (v14.refs ++ v15.refs) }) in (if v16.s = 0 then (let v17 equals ((v13.v * 100) / 1) in (let v18 equals (integer of v17) in (if (decimal of v18) = v17 then B1 { -- s: v16.s -- c: v16.c -- refs: v16.refs -- v: v18 } else B1 { -- s: 3 -- c: 1 -- refs: v16.refs -- v: (0) }))) else B1 { -- s: v16.s -- c: v16.c -- refs: v16.refs -- v: (0) }))) in (let v23 equals (combine all v22 among [Meta { -- s: v19.s -- c: v19.c -- refs: v19.refs }; Meta { -- s: v20.s -- c: v20.c -- refs: v20.refs }] in v21 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v22.s > v21.s then v22.s else v21.s) -- c: (if v22.s > v21.s then v22.c else v21.c) -- refs: (v21.refs ++ v22.refs) }) in (if v23.s = 0 then B0 { -- s: v23.s -- c: v23.c -- refs: v23.refs -- v: (v19.v > v20.v) } else B0 { -- s: v23.s -- c: v23.c -- refs: v23.refs -- v: false })))) in (let v27 equals (combine all v26 among [Meta { -- s: v1.s -- c: v1.c -- refs: v1.refs }; Meta { -- s: v24.s -- c: v24.c -- refs: v24.refs }] in v25 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v26.s > v25.s then v26.s else v25.s) -- c: (if v26.s > v25.s then v26.c else v25.c) -- refs: (v25.refs ++ v26.refs) }) in B0 { -- s: v27.s -- c: v27.c -- refs: v27.refs -- v: v24.v })) else B0 { -- s: 4 -- c: v1.c -- refs: v1.refs -- v: false }) else B0 { -- s: v1.s -- c: v1.c -- refs: v1.refs -- v: false }))
```
