# Declared factual interface
> Using Integer_en as Integer
> Using Decimal_en as Decimal
> Using Date_en as Date
> Using List_en as List
```catala
declaration structure Meta:
  data s content integer
  data c content integer
  data refs content list of integer

declaration structure B0:
  data s content integer
  data c content integer
  data refs content list of integer
  data v content boolean

declaration structure B1:
  data s content integer
  data c content integer
  data refs content list of integer
  data v content integer

declaration scope SharedRule:
  input f0 content B1
  input f1 content B0
  input f2 content B0
  output r0 content B0
```

```catala
scope SharedRule:
  definition r0 equals (let v1 equals B0 { -- s: 0 -- c: 0 -- refs: [] -- v: true } in (if v1.s = 0 then (if v1.v then (let v13 equals (let v7 equals f2 in (let v8 equals f1 in (let v9 equals (let v2 equals B1 { -- s: 0 -- c: 0 -- refs: [] -- v: (90) } in (let v3 equals f0 in (let v6 equals (combine all v5 among [Meta { -- s: v2.s -- c: v2.c -- refs: v2.refs }; Meta { -- s: v3.s -- c: v3.c -- refs: v3.refs }] in v4 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v5.s > v4.s then v5.s else v4.s) -- c: (if v5.s > v4.s then v5.c else v4.c) -- refs: (v4.refs ++ v5.refs) }) in (if v6.s = 0 then B0 { -- s: v6.s -- c: v6.c -- refs: v6.refs -- v: (v2.v >= v3.v) } else B0 { -- s: v6.s -- c: v6.c -- refs: v6.refs -- v: false })))) in (let v12 equals (combine all v11 among [Meta { -- s: v7.s -- c: v7.c -- refs: v7.refs }; Meta { -- s: v8.s -- c: v8.c -- refs: v8.refs }; Meta { -- s: v9.s -- c: v9.c -- refs: v9.refs }] in v10 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v11.s > v10.s then v11.s else v10.s) -- c: (if v11.s > v10.s then v11.c else v10.c) -- refs: (v10.refs ++ v11.refs) }) in (if v12.s >= 2 then B0 { -- s: v12.s -- c: v12.c -- refs: v12.refs -- v: false } else if (v7.s = 0 and not v7.v) or (v8.s = 0 and not v8.v) or (v9.s = 0 and not v9.v) then B0 { -- s: 0 -- c: 0 -- refs: v12.refs -- v: false } else if v12.s = 1 then B0 { -- s: v12.s -- c: v12.c -- refs: v12.refs -- v: false } else B0 { -- s: v12.s -- c: v12.c -- refs: v12.refs -- v: true }))))) in (let v16 equals (combine all v15 among [Meta { -- s: v1.s -- c: v1.c -- refs: v1.refs }; Meta { -- s: v13.s -- c: v13.c -- refs: v13.refs }] in v14 initially Meta { -- s: 0 -- c: 0 -- refs: [] } with Meta { -- s: (if v15.s > v14.s then v15.s else v14.s) -- c: (if v15.s > v14.s then v15.c else v14.c) -- refs: (v14.refs ++ v15.refs) }) in B0 { -- s: v16.s -- c: v16.c -- refs: v16.refs -- v: v13.v })) else B0 { -- s: 4 -- c: v1.c -- refs: v1.refs -- v: false }) else B0 { -- s: v1.s -- c: v1.c -- refs: v1.refs -- v: false }))
```
