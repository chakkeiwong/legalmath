:false,\"tags\":[],\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"After announcing this spring the return of Les Journées Particulières, LVMH is sharing the full program for this 6th edition, which will take place from October 16 to 18, 2026.\",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"heading1\",\"text\":\"LVMH unveils Les Journées Particulières 2026 program: 71 venues open across 13 countries and exclusive experiences\",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":960,\"height\":640},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/8_tkTjiQlOd_qsah_image.jpeg?auto=format,compress\",\"id\":\"8_tkTjiQlOd_qsah\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"},\"mobile\":{\"dimensions\":{\"width\":960,\"height\":640},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/8_tkTjiQlOd_qsah_image.jpeg?auto=format,compress\",\"id\":\"8_tkTjiQlOd_qsah\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"}},\"buttonLabel\":\"Learn more\"},\"simpleList\":\"$undefined\"},\"primaryLink\":{\"link\":{\"link_type\":\"Any\"},\"label\":\"$undefined\"},\"secondaryLinks\":[{\"id\":\"secondary_0\",\"label\":\"\",\"link\":{\"link_type\":\"Any\"}}],\"tertiaryLinks\":[],\"title\":{\"label\":[{\"type\":\"heading3\",\"text\":\"GROUP\",\"spans\":[{\"start\":0,\"end\":5,\"type\":\"em\"}]}],\"link\":{\"link_type\":\"Any\"}}}},\"displaySeoContent\":true}]}],[\"$\",\"li\",null,{\"className\":\"py-2 \",\"children\":[\"$\",\"$L27a\",null,{\"small\":\"$undefined\",\"item\":{\"id\":\"primary_link_Commitments\",\"link\":{\"link_type\":\"Any\"},\"label\":\"Commitments\",\"sublevel\":{\"id\":\"ZfRxqxEAAB8Aogji\",\"bottomLink\":{\"link\":{\"link_type\":\"Any\"},\"label\":\"$undefined\"},\"description\":[{\"type\":\"paragraph\",\"text\":\"Committed to positive impact, LVMH actively supports social, environmental and cultural initiatives with a long-term vision, in order to make a lasting difference. The Group works closely with numerous stakeholders that address important social issues.\",\"spans\":[]}],\"links\":[{\"links\":[{\"id\":\"subnav_ZfRxqxEAAB8Aogji_0\",\"link\":{\"id\":\"ZldhHREAACgAd2oT\",\"uid\":\"commitment-in-action\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"The LVMH Group strengthens its long-standing social and environmental responsibility commitment through robust roadmaps.\",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"Commitment in action\",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":8000,\"height\":4919},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aGKuuXfc4bHWi3Tn_ART-CULTURE_BLUE-site.jpg?auto=format,compress\",\"id\":\"aGKuuXfc4bHWi3Tn\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"},\"mobile\":{\"dimensions\":{\"width\":8000,\"height\":4919},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aGKuuXfc4bHWi3Tn_ART-CULTURE_BLUE-site.jpg?auto=format,compress\",\"id\":\"aGKuuXfc4bHWi3Tn\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Our commitment in action\"},{\"id\":\"subnav_ZfRxqxEAAB8Aogji_1\",\"link\":{\"id\":\"Zh_KUhEAACkAq8cC\",\"uid\":\"ethics-and-compliance\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"Every action taken by the Group and its employees reflects LVMH’s commitment to ethics and social and environmental responsibility. \",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"heading1\",\"text\":\"Ethics and compliance\",\"spans\":[]}],\"miniature_image\":{},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Our ethics \u0026 compliance approach\"},{\"id\":\"subnav_ZfRxqxEAAB8Aogji_2\",\"link\":{\"id\":\"ZlQ_0BIAAC4AMMQM\",\"uid\":\"for-people\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"LVMH’s social responsibility strategy is long-term and puts men and women at the core of its initiatives. It is structured around a global road map.\",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"For People\",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":2880,\"height\":1312},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/a1ff0f9d-ee56-4154-8b36-faa94ac56fc8_HEADER+%281%29.png?auto=format,compress?auto=compress,format\",\"id\":\"Zj3_9BEAAB8Ax_He\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"},\"mobile\":{\"dimensions\":{\"width\":2880,\"height\":1312},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/a1ff0f9d-ee56-4154-8b36-faa94ac56fc8_HEADER+%281%29.png?auto=format,compress?auto=compress,format\",\"id\":\"Zj3_9BEAAB8Ax_He\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"For People\"},{\"id\":\"subnav_ZfRxqxEAAB8Aogji_3\",\"link\":{\"id\":\"ZlXcIxEAACcAdS_k\",\"uid\":\"for-the-environment\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"The LVMH Group is using the power of its influence to galvanize the luxury industry through concrete actions and to drive far-reaching changes to help protect ecosystems. \",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"For the Environment\",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":2894,\"height\":3543},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/ZlROWCk0V36pXpeB_engagement_environnement.jpg?auto=format,compress?auto=compress,format\",\"id\":\"ZlROWCk0V36pXpeB\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"},\"mobile\":{\"dimensions\":{\"width\":2894,\"height\":3543},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/ZlROWCk0V36pXpeB_engagement_environnement.jpg?auto=format,compress?auto=compress,format\",\"id\":\"ZlROWCk0V36pXpeB\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"For the Environment\"},{\"id\":\"subnav_ZfRxqxEAAB8Aogji_4\",\"link\":{\"id\":\"ZldZRxEAACsAd17h\",\"uid\":\"for-philanthropy\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"The Group and its Maisons serve the general interest in France and around the world, enabling the widest possible access to art, heritage and arts education, and supporting medical research and social solidarity initiatives.\",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"For Philanthropy\",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":3858,\"height\":4724},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/Zkdw4iol0Zci9Pz9_Group03-BLUE-LAYERS.jpeg?auto=format,compress?auto=compress,format\",\"id\":\"Zkdw4iol0Zci9Pz9\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"},\"mobile\":{\"dimensions\":{\"width\":3858,\"height\":4724},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/Zkdw4iol0Zci9Pz9_Group03-BLUE-LAYERS.jpeg?auto=format,compress?auto=compress,format\",\"id\":\"Zkdw4iol0Zci9Pz9\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"For Philanthropy\"},{\"id\":\"subnav_ZfRxqxEAAB8Aogji_5\",\"link\":{\"id\":\"Zn01_BIAAC4Aj9Op\",\"uid\":\"all-our-actions\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"The Group has already put in place numerous initiatives in the area of social and environmental responsibility, with the active involvement of its employees and partners. \",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"All our actions\",\"spans\":[]}],\"miniature_image\":{},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"All our actions\"}]}],\"pushs\":{\"title\":\"Highlight\",\"primary\":{\"push\":{\"id\":\"arDpehEAACsA7lBf\",\"uid\":\"2026-nyc-climate-week-lvmh-highlights-its-business-partners-commitments-under-life-360\",\"lang\":\"en-us\",\"type\":\"news\",\"link_type\":\"Document\",\"isBroken\":false,\"tags\":[],\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"As the 2026 NYC Climate Week takes place from September 20 to 27, LVMH is reaffirming one of the key pillars of its LIFE 360 roadmap: working hand in hand with its business partners to accelerate environmental transformation across the value chain.\",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"heading1\",\"text\":\"2026 NYC Climate Week: LVMH highlights its Business Partners commitments under LIFE 360\",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":7000,\"height\":4666},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/C_NmxMx1EKCQ8c0z_LVMH_2025_CARTES_REVES_RUINART_HUGO_MAPELLI_3%5B93%5D.jpg?auto=format,compress\",\"id\":\"C_NmxMx1EKCQ8c0z\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"},\"mobile\":{\"dimensio