8-450c-8429-a020816fa00e_marie-louise-metiers-retail.png?auto=compress,format\",\"id\":\"ZR_OZRIAACUAw3O6\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Discover our Métiers\"},{\"id\":\"subnav_link_first_ZfRsyREAAB8AofLS_2\",\"link\":{\"id\":\"ZfhA9hEAACIAstn4\",\"uid\":\"people-gallery\",\"lang\":\"en-us\",\"type\":\"talents\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"Discover the People Gallery\",\"spans\":[]}],\"pageTitle\":\"$undefined\",\"miniature_image\":{},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"People Gallery\"}],\"title\":\"Your Journey at LVMH\"},{\"links\":[{\"id\":\"subnav_link_second_ZfRsyREAAB8AofLS_0\",\"link\":{\"id\":\"Zmg6HREAACgAF0Fs\",\"uid\":\"lvmh-metiers-dexcellence\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"LVMH’s Métiers d’Excellence encompass over 280 Creative, Craft and Client Experience métiers with unique savoir-faire that are indispensable to the success of the Group and our Maisons.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"LVMH Métiers d'Excellence\",\"spans\":[]}],\"miniature_image\":{\"dimensions\":{\"width\":2880,\"height\":1600},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aifTMAeQX7-eXAO__ZoUY5R5LeNNTwvqW_dac923af-3d93-40f9-9499-b6fee9eebe22_Module%2BSlider%2BHub-2.avif?auto=format,compress\",\"id\":\"aifTMAeQX7-eXAO_\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"},\"mobile\":{\"dimensions\":{\"width\":2880,\"height\":1600},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aifTMAeQX7-eXAO__ZoUY5R5LeNNTwvqW_dac923af-3d93-40f9-9499-b6fee9eebe22_Module%2BSlider%2BHub-2.avif?auto=format,compress\",\"id\":\