"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"Attracting, developing, and engaging next generation talents at LVMH is vital for fueling a pipeline of passionate and qualified candidates for our Maisons and ensuring the Group's continued success.\",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"INSIDE LVMH\",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":3298,\"height\":1850},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aeHvfp1ZCF7ETR4m_CoverINSIDELVMH.png?auto=format,compress\",\"id\":\"aeHvfp1ZCF7ETR4m\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"},\"mobile\":{\"dimensions\":{\"width\":3298,\"height\":1850},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aeHvfp1ZCF7ETR4m_CoverINSIDELVMH.png?auto=format,compress\",\"id\":\"aeHvfp1ZCF7ETR4m\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"INSIDE LVMH\"},{\"id\":\"subnav_link_second_ZfRsyREAAB8AofLS_3\",\"link\":{\"id\":\"ZkfKmhAAACIAr65I\",\"uid\":\"dare-disrupt-act-risk-to-be-an-entrepreneur\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"DARE – Disrupt, Act, Risk to be an Entrepreneur – is the LVMH Group’s intrepreneurial program, launched in 2017.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"DARE\",\"spans\":[]}],\"miniature_image\":{},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"DARE\"}],\"title\":\"Our programs\"}],\"pushs\":{\"title\":\"Highlight\",\"primary\":{\"push\":{\"id\":\"arI9OREAAC4A8JeX\",\"uid\":\"applications-are-now-open-for-the-october-2026-cohort-of-the-inside-lvmh-certificate\",\"lang\":\"en-us\",\"type\":\"news\",\"link_ty