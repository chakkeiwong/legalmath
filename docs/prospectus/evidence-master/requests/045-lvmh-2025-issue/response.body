fff\"},\"mobile\":{\"dimensions\":{\"width\":2303,\"height\":1536},\"alt\":\"Cover Fendi\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/dd9af34c-cd50-4a45-9b69-b4f6aa03295c__KKK8576.jpg?auto=compress,format\",\"id\":\"ZWXAoxAAACgAFk5E\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Fendi\"},{\"id\":\"ZPhMrxIAACMAc_de\",\"link\":{\"id\":\"ZPhMrxIAACMAc_de\",\"uid\":\"givenchy\",\"lang\":\"en-us\",\"type\":\"house\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"With its world-renowned collections of men's and women's fashion, Maison Givenchy has been sensuously reinterpreting the codes of elegance, sophistication, and femininity since it was founded in 1952.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"Givenchy\",\"spans\":[]}],\"miniature_image\":{\"dimensions\":{\"width\":2868,\"height\":1602},\"alt\":\"Cover - Givenchy\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/cc6fe53f-eae3-4326-9224-76543ea7b232_Capture+d%E2%80%99e%CC%81cran+2023-11-27+a%CC%80+14.32.56.png?auto=compress,format\",\"id\":\"ZWSaqBAAACgAEO_Y\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"},\"mobile\":{\"dimensions\":{\"width\":2868,\"height\":1602},\"alt\":\"Cover Givenchy\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/cc6fe53f-eae3-4326-9224-76543ea7b232_Capture+d%E2%80%99e%CC%81cran+2023-11-27+a%CC%80+14.32.56.png?auto=compress,format\",\"id\":\"ZWSaqBAAACgAEO_Y\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Givenchy\"},{\"id\":\"ZcyCZRIAACoAGOEB\",\"link\":{\"id\":\"ZcyCZRIAACoAGOEB\",\"uid\":\"kenzo\",\"lang\":\"en-us\",\"type\":\"house\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":