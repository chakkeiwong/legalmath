xt\":\"DISCOVER OUR MÉTIERS\",\"spans\":[{\"start\":9,\"end\":20,\"type\":\"em\"}],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":2592,\"height\":1408},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/7ff98db4-ecd8-450c-8429-a020816fa00e_marie-louise-metiers-retail.png?auto=compress,format\",\"id\":\"ZR_OZRIAACUAw3O6\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Discover our Métiers\"},{\"id\":\"subnav_link_first_ZfRsyREAAB8AofLS_2\",\"link\":{\"id\":\"ZfhA9hEAACIAstn4\",\"uid\":\"people-gallery\",\"lang\":\"en-us\",\"type\":\"talents\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"Discover the People Gallery\",\"spans\":[]}],\"pageTitle\":\"$undefined\",\"miniature_image\":{},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"People Gallery\"}],\"title\":\"Your Journey at LVMH\"},{\"links\":[{\"id\":\"subnav_link_second_ZfRsyREAAB8AofLS_0\",\"link\":{\"id\":\"Zmg6HREAACgAF0Fs\",\"uid\":\"lvmh-metiers-dexcellence\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"LVMH’s Métiers d’Excellence encompass over 280 Creative, Craft and Client Experience métiers with unique savoir-faire that are indispensable to the success of the Group and our Maisons.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"LVMH Métiers d'Excellence\",\"spans\":[]}],\"miniature_image\":{\"dimensions\":{\"width\":2880,\"height\":1600},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aifTMAeQX7-eXAO__ZoUY5R5LeNNTwvqW_dac923af-3d93-40f9-9499-b6fee9eebe22_Module%2BSlider%2BHub-2.avif?auto=format,compress\",\"id\":\"aifTMAeQX7-eXAO_\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"},\"mobile\":{\"dimensions\":{\"width\":2880,\"height\":1600},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aifTMAeQX7-eXAO__ZoUY5R5LeNNTwvqW_dac923af-3d93-40f9-9499-b6fee9eebe22_Module%2BSlider%2BHub-2.avif?auto=format,compress\",\"id\":\"aifTMAeQX7-eXAO_\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"LVMH Métiers d'Excellence\"},{\"id\":\"subnav_link_second_ZfRsyREAAB8AofLS_1\",\"link\":{\"id\":\"Zj4gkREAACEAyCZB\",\"uid\":\"lvmh-graduate-programs\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"At LVMH, we have always been committed to supporting and empowering the next generations. With the goal of fueling the pipeline of the next generation of leaders of the Group and our Maisons, the LVMH graduate programs are designed specifically to serve as a launching pad for fresh graduates and professionals in the early stages of their careers.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"heading2\",\"text\":\"LVMH Graduate Programs\",\"spans\":[{\"start\":5,\"end\":22,\"type\":\"em\"}]}],\"miniature_image\":{\"dimensions\":{\"width\":988,\"height\":421},\"alt\":\"Decorative image\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/c3bb3135-5e8b-40f4-a9c5-13704cadc10b_GRADUATE+PROGRAMS+Page+-+Header+Photo.jpg?auto=compress,format\",\"id\":\"Zij9YRAAAB8AEK8g\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"},\"mobile\":{\"dimensions\":{\"width\":988,\"height\":1500},\"alt\":\"Decorative image\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/c3bb3135-5e8b-40f4-a9c5-13704cadc10b_GRADUATE+PROGRAMS+Page+-+Header+Photo.jpg?auto=compress,format\u0026rect=419,0,277,421\u0026w=988\u0026h=1500\",\"id\":\"Zij9YRAAAB8AEK8g\",\"edit\":{\"x\":-1492,\"y\":0,\"zoom\":3.5629453681710213,\"background\":\"#fff\"}}},