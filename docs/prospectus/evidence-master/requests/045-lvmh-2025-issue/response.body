\":\"#fff\"},\"mobile\":{\"dimensions\":{\"width\":12000,\"height\":12000},\"alt\":\"Cover - Our mission\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/Zl2sfaWtHYXtUBhQ_Pattern_1x1.jpg?auto=format,compress?auto=compress,format\",\"id\":\"Zl2sfaWtHYXtUBhQ\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Mission\"},{\"id\":\"subnav_ZfRrUREAACIAoeuS_2\",\"link\":{\"id\":\"Zbv5uhAAACIA9h9O\",\"uid\":\"governance\",\"lang\":\"en-us\",\"type\":\"governance\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"Consult the Profiles of members of the LVMH Executive Committee and Board of Directors, as well as the rules of conduct and action principles to guide the behavior of all Group’s employees and stakeholders.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"heading2\",\"text\":\"Governance \u0026 Ethics\",\"spans\":[{\"start\":10,\"end\":19,\"type\":\"em\"}]}],\"miniature_image\":{},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Governance \u0026 Ethics\"},{\"id\":\"subnav_ZfRrUREAACIAoeuS_3\",\"link\":{\"id\":\"ZiEF6REAACkAsR6q\",\"uid\":\"our-model\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"LVMH's mission is to ensure the development of each of its Maisons by providing them with all the resources they need to create, manufacture and distribute products and services that prioritize outstanding quality and the highest ethical, social and environmental standards.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"Our model\",\"spans\":[]}],\"miniature_image\":{\"dimensions\":{\"width\":2704,\"height\":2277},\"alt\":\"Cover - Our model\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/Zl7opZm069VX1b_1_header-pattern.jpg?auto=form