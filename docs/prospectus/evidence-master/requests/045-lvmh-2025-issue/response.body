5240-2b0779763caa1351.js\",\"8624\",\"static/chunks/8624-798775a4975e5871.js\",\"4218\",\"static/chunks/4218-d80ccc508dcd1945.js\",\"9399\",\"static/chunks/9399-db54c16078defc35.js\",\"1858\",\"static/chunks/1858-f786eefe13715e5b.js\",\"9583\",\"static/chunks/app/%5Blocale%5D/(mainContent)/%5B...uid%5D/page-b7f10e318abae019.js\"],\"default\"]\n27d:[]\n27c:{\"type\":\"paragraph\",\"text\":\"Our portfolio of Wines \u0026 Spirits Maisons, each synonymous with excellence and authenticity, is unparalleled in the world.\",\"spans\":\"$27d\"}\n27b:[\"$27c\"]\n280:[]\n27f:{\"type\":\"paragraph\",\"text\":\"Wines \u0026 Spirits\",\"spans\":\"$280\"}\n27e:[\"$27f\"]\n282:{\"width\":2362,\"height\":2953}\n283:{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}\n285:{\"width\":2362,\"height\":2953}\n286:{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}\n284:{\"dimensions\":\"$285\",\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/72af9bca-f7f8-4ea6-89e2-f3b56adb5057_Vins%26Spiritueux.jp"])</script><script>self.__next_f.push([1,"g?auto=compress,format\",\"id\":\"ZjiVcxEAACQAwCq5\",\"edit\":\"$286\"}\n281:{\"dimensions\":\"$282\",\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/72af9bca-f7f8-4ea6-89e2-f3b56adb5057_Vins%26Spiritueux.jpg?auto=compress,format\",\"id\":\"ZjiVcxEAACQAwCq5\",\"edit\":\"$283\",\"mobile\":\"$284\"}\n289:[]\n288:{\"type\":\"paragraph\",\"text\":\"Fashion \u0026 Leather Goods comprises an exceptional portfolio of Maisons with a unique heritage, as well as more recent brands with great potential. Their creations become objects of desire…desire with timeless appeal. - LVMH\",\"spans\":\"$289\"}\n287:[\"$288\"]\n28c:[]\n28b:{\"type\":\"paragraph\",\"text\":\"Fashion \u0026 Leather goods\",\"spans\":\"$28c\",\"direction\":\"ltr\"}\n28a:[\"$28b\"]\n28e:{\"width\":2880,\"height\":1600}\n28f:{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}\n291:{\"width\":2880,\"height\":1600}\n292:{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}\n290:{\"dimensions\":\"$291\",\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/dac923af-3d93-40f9-9499-b6fee9eebe22_Module+Slider+Hub.png?auto=compress,format\",\"id\":\"ZTomUBAAACIAgHY4\",\"edit\":\"$292\"}\n28d:{\"dimensions\":\"$28e\",\"alt\":\"Cover - Fashion \u0026 Leather goods\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/dac923af-3d93-40f9-9499-b6fee9eebe22_Module+Slider+Hub.png?auto=compress,format\",\"id\":\"ZTomUBAAACIAgHY4\",\"edit\":\"$28f\",\"mobile\":\"$290\"}\n295:[]\n294:{\"type\":\"paragraph\",\"text\":\"A world leader in fragrances, makeup and skincare, the Perfumes \u0026 Cosmetics division brings together globally renowned Maisons, as well as young brands with promising potential.\",\"spans\":\"$295\"}\n293:[\"$294\"]\n298:[]\n297:{\"type\":\"paragraph\",\"text\":\"Perfumes \u0026 Cosmetics\",\"spans\":\"$298\",\"direction\":\"ltr\"}\n296:[\"$297\"]\n29a:{\"width\":2880,\"height\":1600}\n29b:{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}\n29d:{\"width\":2880,\"height\":1600}\n29e:{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}\n29c:{\"dimensions\":\"$29d\",\"alt\":\"Banner Perfumes \u0026 Cosmetics\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aa8b3c85-927c-44dd-8f67-6465bf1c4c9d_Parfums+%26+Co"])</script><script>self.__next_f.push([1,"sm%C3%A9tiques.png?auto=compress,format\",\"id\":\"ZTomUBAAACIAgHYz\",\"edit\":\"$29e\"}\n299:{\"dimensions\":\"$29a\",\"alt\":\"Cover - Perfumes \u0026 Cosmetics\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aa8b3c85-927c-44dd-8f67-6465bf1c4c9d_Parfums+%26+Cosm%C3%A9tiques.png?auto=compress,format\",\"id\":\"ZTomUBAAACIAgHYz\",\"edit\":\"$29b\",\"mobile\":\"$29c\"}\n2a1:[]\n2a0:{\"type\":\"paragraph\",\"text\":\"One of the most recently established activities, the Watches \u0026 Jewelry sector brings together leading Houses with complementary positions.\",\"spans\":\"$2a1\"}\n29f:[\"$2a0\"]\n2a4:[]\n2a3:{\"type\":\"paragraph\",\"text\":\"Watches \u0026 Jewelry\",\"spans\":\"$2a4\"}\n2a2:[\"$2a3\"]\n2a6:{\"width\":5504,\"height\":6880}\n2a7:{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}\n2a9:{\"width\":5504,\"height\":6880}\n2aa:{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}\n2a8:{\"dimensions\":\"$2a9\",\"alt\":\"Decorative image\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/9a9fec33-9b27-4744-bfe9-67e1396147a4_Montres+et+Joaillerie.jpeg?auto=compress,format\",\"id\":\"ZjipHREAACAAwEmr\",\"edit\":\"$2aa\"}\n2a5:{\"dimensions\":\"$2a6\",\"alt\":\"Cover - Watches \u0026 Jewelry\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/9a9fec33-9b27-4744-bfe9-67e1396147a4_Montres+et+Joaillerie.jpeg?auto=compress,format\",\"id\":\"ZjipHREAACAAwEmr\",\"edit\":\"$2a7\",\"mobile\":\"$2a8\"}\n2ad:[]\n2ac:{\"type\":\"paragraph\",\"text\":\"Because each customer is unique, LVMH Selective Retailing Maisons create personalized shopping experiences matched to individual aspirations. \",\"spans\":\"$2ad\"}\n2ab:[\"$2ac\"]\n2b0:[]\n2af:{\"type\":\"paragraph\",\"text\":\"Selective Retailing\",\"spans\":\"$2b0\"}\n2ae:[\"$2af\"]\n2b2:{\"width\":2953,\"height\":1996}\n2b3:{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}\n2b5:{\"width\":2953,\"height\":1996}\n2b6:{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}\n2b4:{\"dimensions\":\"$2b5\",\"alt\":\"Decorative image\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/f9629d05-73d4-46af-b8a3-0ffea8912b82_Distrubution+Se%CC%81lective.png?auto=compress,format\",\"id\":\"Zjjl3REAACEAwKJ_\",\"edit\":\"$2b6\"}\n2b1:{\"dimensions\":\"$2b2\",\"alt\":\"Cove"])</script><script>self.__next_f.push([1,"r - Selective Retailing\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/f9629d05-73d4-46af-b8a3-0ffea8912b82_Distrubution+Se%CC%81lective.png?auto=compress,format\",\"id\":\"Zjjl3REAACEAwKJ_\",\"edit\":\"