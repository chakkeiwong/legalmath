Fact foo
    Derived from (Foreach bar:
        bar.baz == 0 || (Forall qux :
            qux.baz - quux.baz >= bar.baz
            When (
                quux.corge == grault.corge
                && quux.garply == grault.waldo.garply
                && quux.fred == grault.waldo.fred
            )
        )
        When bar.plugh == grault.waldo // slow
     // When bar.plugh == grault.waldo // much faster
    ).



