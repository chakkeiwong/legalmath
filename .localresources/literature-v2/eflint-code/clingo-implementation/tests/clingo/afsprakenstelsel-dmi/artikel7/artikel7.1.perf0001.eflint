// Description:
//   Scenario dat een paar voorbeelden toont voor
//   `publieke-diensten-geen-commons` uit artikel 7.1.
//


///// SCENARIO /////
// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee agenten, Amy en Bob
+deelnemer(Amy). +deelnemer(Bob).

// Amy biedt iets aan als Commons, wat niet grotendeels gefinancieerd is door publieke middelen.
// Goed gedaan, Amy!
+aanbod(0, Amy, Appel, 2023).
+aanbod-als-commons(aanbod(0, Amy, Appel, 2023)).
//#violated !publieke-diensten-geen-commons(deelnemer(Amy), beheerder(Ecoraad), aanbod(id(0), deelnemer(Amy), dienst(Appel), jaar(2023))).

// Bob biedt iets aan als Commons wat _wel_ grotendeels geficancieerd is door publieke middelen.
// Waarom, Bob?
+dienst-grotendeels-gefinancieerd-met-publieke-middelen(Banaan).
+aanbod(1, Bob, Banaan, 2023).
+aanbod-als-commons(aanbod(1, Bob, Banaan, 2023)).
//#violated publieke-diensten-geen-commons(deelnemer(Bob), beheerder(Ecoraad), aanbod(id(1), deelnemer(Bob), dienst(Banaan), jaar(2023))).
