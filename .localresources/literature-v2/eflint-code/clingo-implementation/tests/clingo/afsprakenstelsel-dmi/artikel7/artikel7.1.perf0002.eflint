// Description:
//   Scenario dat een paar voorbeelden toont voor
//   `publieke-diensten-geen-kosten` uit artikel 7.1.
//


///// SCENARIO /////
// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee agenten, Amy en Bob
+deelnemer(Amy). +deelnemer(Bob).

// Amy biedt iets grotendeels gefinancieerd is door publieke middelen aan zonder kosten.
// Goed gedaan, Amy!
+dienst-grotendeels-gefinancieerd-met-publieke-middelen(Appel).
+aanbod(0, Amy, Appel, 2023).
+aanbod-kosten(aanbod(0, Amy, Appel, 2023), 0).
//#violated !publieke-diensten-geen-kosten(deelnemer(Amy), beheerder(Ecoraad), aanbod(id(0), deelnemer(Amy), dienst(Appel), jaar(2023))).

// Bob biedt iets grotendeels gefinancieerd is door publieke middelen aan mét kosten.
// Waarom, Bob?
+dienst-grotendeels-gefinancieerd-met-publieke-middelen(Banaan).
+aanbod(1, Bob, Banaan, 2023).
+aanbod-kosten(aanbod(1, Bob, Banaan, 2023), 2000).
//#violated publieke-diensten-geen-kosten(deelnemer(Bob), beheerder(Ecoraad), aanbod(id(1), deelnemer(Bob), dienst(Banaan), jaar(2023))).
