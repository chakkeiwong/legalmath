// Description:
//   Scenario dat een paar voorbeelden toont voor
//   `moet-commons-aanbieden` uit artikel 7.2.
//


///// SCENARIO /////
// Er is een huidig jaar
{
    +huidig-jaar(2023).
    +jaarlijkse-commons-waarde(2500, 2023).
}

// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn vier partijen
+deelnemer(Amy).
+deelnemer(Bob).
+deelnemer(Cho).
+deelnemer(Dan).

// Er zijn wat producten
+dienst-waarde(Appel, 1000).
+dienst-waarde(Banaan, 1500).

// Amy biedt genoeg aan
+aanbod(0, Amy, Appel, 2023).
+aanbod-als-commons(aanbod(0, Amy, Appel, 2023)).
+aanbod(1, Amy, Banaan, 2023).
+aanbod-als-commons(aanbod(1, Amy, Banaan, 2023)).

// Bob biedt wat aan maar niet genoeg
+aanbod(2, Bob, Banaan, 2023).
+aanbod-als-commons(aanbod(2, Bob, Banaan, 2023)).

// Cho biedt wat aan maar niet als Commons
+aanbod(3, Cho, Appel, 2023).
+aanbod(4, Cho, Banaan, 2023).
+aanbod-als-commons(aanbod(3, Cho, Appel, 2023)).

// Dan biedt niks aan



// Als we naar het volgende jaar gaan worden de violations getriggered
{
    +huidig-jaar(2024).
    +jaarlijkse-commons-waarde(2500, 2024).
}
//#violated not moet-commons-aanbieden(deelnemer(Amy), beheerder(Ecoraad), jaar(2023)).
//#violated moet-commons-aanbieden(deelnemer(Bob), beheerder(Ecoraad), jaar(2023)).
//#violated moet-commons-aanbieden(deelnemer(Cho), beheerder(Ecoraad), jaar(2023)).
//#violated moet-commons-aanbieden(deelnemer(Dan), beheerder(Ecoraad), jaar(2023)).
