//
// Created:
//   28 Jun 2024, 10:44:12
// Last edited:
//   22 Aug 2024, 11:11:52
// Auto updated?
//   Yes
//
// Description:
//   Scenario dat een paar voorbeelden toont voor
//   `data-opgebouwd-met-commons-data-om-niet` uit artikel 7.6.
//

#require "../../artikel7/artikel7.6.eflint".


///// SCENARIO /////
// Er is een huidig jaar
+huidig-jaar(2023).

// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee kennisinstituten
{
    +deelnemer("Voedsel & Waren Autoriteit Amy").
    +kennisinstituut(deelnemer("Voedsel & Waren Autoriteit Amy")).
}
{
    +deelnemer("Bob 3D Scanning").
    +kennisinstituut(deelnemer("Bob 3D Scanning")).
}

// Amy heeft een resultaat wat gemaakt is met als Commons aangeboden data. Maar ze biedt het gratis aan.
+dienst-waarde("Appel Goedkeuring", 1500).
+dienst-opgebouwd-met-commons-data("Appel Goedkeuring").
{
    +aanbod(0, "Voedsel & Waren Autoriteit Amy", "Appel Goedkeuring", 2023).
    +aanbod-als-commons(aanbod(0, "Voedsel & Waren Autoriteit Amy", "Appel Goedkeuring", 2023)).
    +aanbod-kosten(aanbod(0, "Voedsel & Waren Autoriteit Amy", "Appel Goedkeuring", 2023), 0).
    +aanbod-gebruiks-kosten(aanbod(0, "Voedsel & Waren Autoriteit Amy", "Appel Goedkeuring", 2023), 0).
}
//#violated not data-opgebouwd-met-commons-data-om-niet(kennisinstituut(deelnemer("Voedsel & Waren Autoriteit Amy")), beheerder(Ecoraad), dienst("Appel Goedkeuring")).

// Bob heeft eenzelfde resultaat, maar biedt het aan voor schandalig veel geld! Ongelooflijk, Bob!
+data("3D Banaan").
+dienst-waarde("3D Banaan", 1500).
+dienst-opgebouwd-met-commons-data("3D Banaan").
{
    +aanbod(1, "Bob 3D Scanning", "3D Banaan", 2023).
    +aanbod-als-commons(aanbod(1, "Bob 3D Scanning", "3D Banaan", 2023)).
    +aanbod-kosten(aanbod(1, "Bob 3D Scanning", "3D Banaan", 2023), 2500).
    +aanbod-gebruiks-kosten(aanbod(1, "Bob 3D Scanning", "3D Banaan", 2023), 2500).
}
//#violated data-opgebouwd-met-commons-data-om-niet(kennisinstituut(deelnemer("Bob 3D Scanning")), beheerder(Ecoraad), dienst("3D Banaan")).
