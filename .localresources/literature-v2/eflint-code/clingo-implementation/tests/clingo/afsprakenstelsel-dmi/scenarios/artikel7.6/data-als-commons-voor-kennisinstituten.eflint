// Last edited:
//   22 Aug 2024, 11:11:54
// Auto updated?
//   Yes
//
// Description:
//   Scenario dat een paar voorbeelden toont voor
//   `data-als-commons-voor-kennisinstituten` uit artikel 7.6.
//

#require "../../artikel7/artikel7.6.eflint".


///// SCENARIO /////
// Er is een huidig jaar
+huidig-jaar(2023).

// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee partijen en een kennisinstituut
+deelnemer(Amy).
+deelnemer(Bob).
{
    +deelnemer("Dan's Fruit Analyse Lab").
    +kennisinstituut(deelnemer("Dan's Fruit Analyse Lab")).
}

// Amy biedt een dataset aan voor geld, en ook als Commons voor een kennisinstituut
+data(DigiAppel).
+dienst-waarde(DigiAppel, 1500).
{
    +aanbod(0, Amy, DigiAppel, 2023).
    +aanbod-gebruiks-kosten(aanbod(0, Amy, DigiAppel, 2023), 1500).
    +aanbod-aan(aanbod(0, Amy, DigiAppel, 2023), deelnemer).

    +aanbod(1, Amy, DigiAppel, 2023).
    +aanbod-gebruiks-kosten(aanbod(1, Amy, DigiAppel, 2023), 10).
    +aanbod-als-commons(aanbod(1, Amy, DigiAppel, 2023)).
    +aanbod-aan(aanbod(1, Amy, DigiAppel, 2023), "Dan's Fruit Analyse Lab").
}
//#violated not data-als-commons-voor-kennisinstituten(deelnemer(Amy), beheerder(Ecoraad), aanbod(id(0), deelnemer(Amy), dienst(DigiAppel), jaar(2023))).

// Bob biedt zijn dataset echter alleen aan
+data(DigiBanaan).
+dienst-waarde(DigiBanaan, 1500).
{
    +aanbod(2, Bob, DigiBanaan, 2023).
    +aanbod-gebruiks-kosten(aanbod(2, Bob, DigiBanaan, 2023), 1500).
    +aanbod-aan(aanbod(2, Bob, DigiBanaan, 2023), deelnemer).
}
//#violated data-als-commons-voor-kennisinstituten(deelnemer(Bob), beheerder(Ecoraad), aanbod(id(2), deelnemer(Bob), dienst(DigiBanaan), jaar(2023))).
