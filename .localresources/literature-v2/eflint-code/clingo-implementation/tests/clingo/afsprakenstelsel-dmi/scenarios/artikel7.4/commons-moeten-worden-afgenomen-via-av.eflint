//
// Created:
//   21 Jun 2024, 09:56:47
// Last edited:
//   22 Aug 2024, 11:11:10
// Auto updated?
//   Yes
//
// Description:
//   Scenario dat een paar voorbeelden toont voor
//   `commons-moeten-worden-afgenomen-via-av` uit artikel 7.4.
//

#require "../../artikel7/artikel7.4.eflint".


///// SCENARIO /////
// Er is een huidig jaar
+huidig-jaar(2023).

// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee partijen
+deelnemer(Amy).
+deelnemer(Bob).

// Amy biedt iets aan als Commons dat via de Algemene Voorzieningen wordt afgenomen
+dienst-waarde(Appel, 1000).
+aanbod(0, Amy, Appel, 2023).
{
    +aanbod-als-commons(aanbod(0, Amy, Appel, 2023)).
    +aanbod-in(aanbod(0, Amy, Appel, 2023), catalogus("Producten en Diensten Catalogus")).
    +aanbod-via(aanbod(0, Amy, Appel, 2023), plaats("Algemene Voorzieningen")).
}
//#violated not commons-moeten-worden-afgenomen-via-av(deelnemer(Amy), beheerder(Ecoraad), aanbod(id(0), deelnemer(Amy), dienst(Appel), jaar(2023))).

// Bob biedt iets aan als Commons wat niet via de PDC wordt aangeboden
+dienst-waarde(Banaan, 5000).
+aanbod(1, Bob, Banaan, 2023).
{
    +aanbod-als-commons(aanbod(1, Bob, Banaan, 2023)).
    +aanbod-in(aanbod(1, Bob, Banaan, 2023), catalogus("Producten en Diensten Catalogus")).
    +aanbod-via(aanbod(1, Bob, Banaan, 2023), plaats("Bob's Worker Emporium")).
}
//#violated commons-moeten-worden-afgenomen-via-av(deelnemer(Bob), beheerder(Ecoraad), aanbod(id(1), deelnemer(Bob), dienst(Banaan), jaar(2023))).
