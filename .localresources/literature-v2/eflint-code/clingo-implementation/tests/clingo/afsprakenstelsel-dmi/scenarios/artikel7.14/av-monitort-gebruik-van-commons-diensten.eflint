#require "../../artikel7/artikel7.14.eflint".


///// SCENARIO /////
// Er bestaat een Algemene Voorzieningen
+algemene-voorzieningen("Algemene Voorzieningen").

// Is het zo dat de Algemene Voorzieningen het gebruik van als Commons aangeboden diensten, producten en/of data monitort?
?av-monitort-gebruik-van-commons-diensten(algemene-voorzieningen("Algemene Voorzieningen")).        // query successful
