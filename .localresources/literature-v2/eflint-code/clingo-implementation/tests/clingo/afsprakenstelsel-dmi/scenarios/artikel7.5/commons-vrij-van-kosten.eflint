//
// Description:
//   Scenario dat een paar voorbeelden toont voor `commons-vrij-van-kosten` uit
//   artikel 7.5.
//

#require "../../artikel7/artikel7.5.eflint".


///// SCENARIO /////
// Er is een huidig jaar
+huidig-jaar(2023).

// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee partijen
+deelnemer(Amy).
+deelnemer(Bob).

// Amy biedt iets aan als Commons voor niks
+dienst-waarde(Appel, 1000).
+aanbod(0, Amy, Appel, 2023).
+aanbod-als-commons(aanbod(0, Amy, Appel, 2023)).
+overeenkomst(aanbod(0, Amy, Appel, 2023), Bob).
+overeenkomst-kosten(overeenkomst(aanbod(0, Amy, Appel, 2023), Bob), 0).
//#violated not commons-vrij-van-kosten(deelnemer(Amy), beheerder(Ecoraad), overeenkomst(aanbod(id(0), deelnemer(Amy), dienst(Appel), jaar(2023)), deelnemer(Bob))).

// Bob biedt iets aan als Commons voor waarde. Foei, Bob!
+dienst-waarde(Banaan, 5000).
+aanbod(1, Bob, Banaan, 2023).
+aanbod-als-commons(aanbod(1, Bob, Banaan, 2023)).
+overeenkomst(aanbod(1, Bob, Banaan, 2023), Amy).
+overeenkomst-kosten(overeenkomst(aanbod(1, Bob, Banaan, 2023), Amy), 5000).
//#violated commons-vrij-van-kosten(deelnemer(Bob), beheerder(Ecoraad), overeenkomst(aanbod(id(1), deelnemer(Bob), dienst(Banaan), jaar(2023)), deelnemer(Amy))).
