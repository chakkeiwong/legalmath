// Auto updated?
//   Yes
//
// Description:
//   Scenario dat een paar voorbeelden toont voor de uitbreiding van
//   `commons-vrij-van-gebruiks-kosten` uit artikel 7.6.
//

#require "../../artikel7/artikel7.6.eflint".


///// SCENARIO /////
// Er is een huidig jaar
+huidig-jaar(2023).

// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee partijen en een kennisinstituut
+deelnemer(Amy).
+deelnemer(Bob).
{
    +deelnemer("Dan's Fruit Analyse Lab").
    +kennisinstituut(deelnemer("Dan's Fruit Analyse Lab")).
}

// Amy biedt iets aan als Commons voor niks
+dienst-waarde(DigiAppel, 1000).
+aanbod(0, Amy, DigiAppel, 2023).
+aanbod-als-commons(aanbod(0, Amy, DigiAppel, 2023)).
+overeenkomst(aanbod(0, Amy, DigiAppel, 2023), Bob). +overeenkomst-gebruiks-kosten(overeenkomst(aanbod(0, Amy, DigiAppel, 2023), Bob), 0).
+overeenkomst(aanbod(0, Amy, DigiAppel, 2023), "Dan's Fruit Analyse Lab"). +overeenkomst-gebruiks-kosten(overeenkomst(aanbod(0, Amy, DigiAppel, 2023), "Dan's Fruit Analyse Lab"), 0).
//#violated not commons-vrij-van-gebruiks-kosten(deelnemer(Amy), beheerder(Ecoraad), overeenkomst(aanbod(id(0), deelnemer(Amy), dienst(DigiAppel), jaar(2023)), deelnemer(Bob))).
//#violated not commons-vrij-van-gebruiks-kosten(deelnemer(Amy), beheerder(Ecoraad), overeenkomst(aanbod(id(0), deelnemer(Amy), dienst(DigiAppel), jaar(2023)), deelnemer("Dan's Fruit Analyse Lab"))).

// Bob biedt iets aan als Commons voor waarde. Dat mag in het geval van het kennisinstituut
+dienst-waarde(DigiBanaan, 5000).
+aanbod(1, Bob, DigiBanaan, 2023).
+aanbod-als-commons(aanbod(1, Bob, DigiBanaan, 2023)).
+overeenkomst(aanbod(1, Bob, DigiBanaan, 2023), Bob). +overeenkomst-gebruiks-kosten(overeenkomst(aanbod(1, Bob, DigiBanaan, 2023), Bob), 500).
+overeenkomst(aanbod(1, Bob, DigiBanaan, 2023), "Dan's Fruit Analyse Lab"). +overeenkomst-gebruiks-kosten(overeenkomst(aanbod(1, Bob, DigiBanaan, 2023), "Dan's Fruit Analyse Lab"), 500).
//#violated commons-vrij-van-gebruiks-kosten(deelnemer(Bob), beheerder(Ecoraad), overeenkomst(aanbod(id(1), deelnemer(Bob), dienst(DigiBanaan), jaar(2023)), deelnemer(Bob))).
//#violated not commons-vrij-van-gebruiks-kosten(deelnemer(Bob), beheerder(Ecoraad), overeenkomst(aanbod(id(1), deelnemer(Bob), dienst(DigiBanaan), jaar(2023)), deelnemer("Dan's Fruit Analyse Lab"))).
