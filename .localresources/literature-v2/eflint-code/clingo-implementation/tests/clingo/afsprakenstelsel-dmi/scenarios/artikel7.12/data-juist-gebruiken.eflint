// Description:
//   Scenario dat een paar voorbeelden toont voor
//   `data-juist-gebruiken` uit artikel 7.12.
//

#require "../../artikel7/artikel7.12.eflint".


///// SCENARIO /////
// Er is een huidig jaar
+huidig-jaar(2023).

// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee partijen
+deelnemer(Amy).
+deelnemer(Bob).

// Er zijn twee datasets
+data("Appel Analyse").
+data("3D Banaan").

// Amy gebruikt data voor een geldige reden
+data-gebruik("Appels verbeteren").
+data-aanwending(Amy, data("Appel Analyse"), "Appels verbeteren").
//#violated not data-juist-gebruiken(deelnemer(Amy), beheerder(Ecoraad), data-aanwending(deelnemer(Amy), data(dienst("Appel Analyse")), data-gebruik("Appels verbeteren"))).

// Bob, echter, gebruik de 3D Banaan voor ongeldige redenen!
+data-gebruik("Banaan 3D-printen om als een nep-pistool te gebruiken bij een fruitwinkel overval").
+data-gebruik-in-strijd-met-wet(data-gebruik("Banaan 3D-printen om als een nep-pistool te gebruiken bij een fruitwinkel overval")).
+data-aanwending(Bob, data("3D Banaan"), "Banaan 3D-printen om als een nep-pistool te gebruiken bij een fruitwinkel overval").
//#violated data-juist-gebruiken(deelnemer(Bob), beheerder(Ecoraad), data-aanwending(deelnemer(Bob), data(dienst("3D Banaan")), data-gebruik("Banaan 3D-printen om als een nep-pistool te gebruiken bij een fruitwinkel overval"))).
