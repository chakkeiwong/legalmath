// Last edited:
//   21 Aug 2024, 09:31:41
// Auto updated?
//   Yes
//
// Description:
//   Scenario dat een paar voorbeelden toont voor
//   `alleen-overeenkomst-over-commons-als-overeenstemming` uit artikel 7.10.
//

#require "../../artikel7/artikel7.10.eflint".


///// SCENARIO /////
// Er is een huidig jaar
+huidig-jaar(2023).

// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee partijen
+deelnemer(Amy).
+deelnemer(Bob).

// Amy biedt wat aan als Commons, waar zowel zij en Bob het over eens zijn.
+dienst-waarde(Appel, 1000).
+aanbod(0, Amy, Appel, 2023).
+overeenkomst(aanbod(0, Amy, Appel, 2023), Bob).
{
    +aanbod-als-commons(aanbod(0, Amy, Appel, 2023)).
    +overeenkomst-met-overeenstemming(overeenkomst(aanbod(0, Amy, Appel, 2023), Bob)).
}
//#violated not alleen-overeenkomst-over-commons-als-overeenstemming(deelnemer(Amy), beheerder(Ecoraad), overeenkomst(aanbod(id(0), deelnemer(Amy), dienst(Appel), jaar(2023)), deelnemer(Bob))).

// Bob, echter, biedt iets aan als Commons zonder overeenkomst. Niet oké, Bob!
+dienst-waarde(Banaan, 500).
+aanbod(1, Bob, Banaan, 2023).
+overeenkomst(aanbod(1, Bob, Banaan, 2023), Amy).
+aanbod-als-commons(aanbod(1, Bob, Banaan, 2023)).
//#violated alleen-overeenkomst-over-commons-als-overeenstemming(deelnemer(Bob), beheerder(Ecoraad), overeenkomst(aanbod(id(1), deelnemer(Bob), dienst(Banaan), jaar(2023)), deelnemer(Amy))).
