#require "../../begrippen/aanbod.eflint".
#require "../../artikel7/artikel7.3.eflint".
// Deze uitbreiding berekent automatisch een correcte `totale-commons-waarde-aangeboden` gebaseerd
// op elk gegeven `aanbod`. Ook komt er automatisch een correct `waarde-herleidbaar-tot` bij.
#require "../../utils/commons-waarde-aangeboden-van-aanbod-met-herleidbaarheid.eflint".


///// SCENARIO /////
// Er is een huidig jaar
+huidig-jaar(2023).

// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee partijen
+deelnemer(Amy).
+deelnemer(Bob).

// Amy heeft afgenomen wat afleidbaar is tot de commerciële waarde van wat ze afgenomen heeft.
{
    +commons-waarde-afgenomen(Amy, Bob, 1000, 2023).
    +afgenomen-waarde-herleidbaar-tot-commerciele-waarde(commons-waarde-afgenomen(Amy, Bob, 1000, 2023)).
}
//#violated not commons-waarde-afgenomen-moet-herleidbaar-zijn-tot-commerciele-waarde(deelnemer(Amy), beheerder(Ecoraad), commons-waarde-afgenomen(deelnemer("Amy"), deelnemer("Bob"), waarde(1000), jaar(2023))).

// Bob heeft afgenomen maar niet afleidbaar! Waarom ben je zo, Bob?
+commons-waarde-afgenomen(Bob, Amy, 1500, 2023).
//#violated commons-waarde-afgenomen-moet-herleidbaar-zijn-tot-commerciele-waarde(deelnemer(Bob), beheerder(Ecoraad), commons-waarde-afgenomen(deelnemer("Bob"), deelnemer("Amy"), waarde(1500), jaar(2023))).
