// Auto updated?
//   Yes
//
// Description:
//   Scenario dat een paar voorbeelden toont voor
//   `open-data-niet-als-commons` uit artikel 7.15.
//

#require "../../artikel7/artikel7.15.eflint".


///// SCENARIO /////
// Er is een huidig jaar
+huidig-jaar(2023).

// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee partijen
+deelnemer(Amy).
+deelnemer(Bob).

// Er zijn twee datasets
+dienst-waarde("Appel Analyse", 1000). +data(dienst("Appel Analyse")).
+dienst-waarde("3D Banaan", 500). +data(dienst("3D Banaan")).

// Amy en Bob bieden appels en bananen aan als Commons, respectievelijk.
+aanbod(0, Amy, "Appel Analyse", 2023).
+aanbod(1, Bob, "3D Banaan", 2023).

// Amy biedt het aan als Commons maar niet als open data; Amy is goed bezig.
+aanbod-als-commons(aanbod(0, Amy, "Appel Analyse", 2023)).
//#violated not open-data-niet-als-commons(deelnemer(Amy), beheerder(Ecoraad), data(dienst("Appel Analyse"))).

// Bob, echter, biedt de bananen-data aan als Commons terwijl het al open data is! Oh nee, Bob!
+aanbod-als-commons(aanbod(1, Bob, "3D Banaan", 2023)).
+data-als-open-data(data(dienst("3D Banaan"))).
//#violated open-data-niet-als-commons(deelnemer(Bob), beheerder(Ecoraad), data(dienst("3D Banaan"))).
