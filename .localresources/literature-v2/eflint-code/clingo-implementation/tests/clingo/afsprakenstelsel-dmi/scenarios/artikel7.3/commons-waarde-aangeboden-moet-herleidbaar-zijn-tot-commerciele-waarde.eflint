//
// Description:
//   Scenario dat een paar voorbeelden toont voor
//   `commons-waarde-aangeboden-moet-herleidbaar-zijn-tot-commerciele-waarde`
//   uit artikel 7.3.
//

#require "../../begrippen/aanbod.eflint".
#require "../../artikel7/artikel7.3.eflint".


///// SCENARIO /////
// Er is een huidig jaar
+huidig-jaar(2023).

// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee partijen
{
    +deelnemer(Amy).
    +commons-waarde-aangeboden(Amy, 0, 2023).
}
{
    +deelnemer(Bob).
    +commons-waarde-aangeboden(Bob, 0, 2023).
}

// Amy biedt iets aan en specificeert de correcte waarde
{
    -commons-waarde-aangeboden(Amy, 0, 2023). +commons-waarde-aangeboden(Amy, 1000, 2023).
    +aangeboden-waarde-herleidbaar-tot-commerciele-waarde(commons-waarde-aangeboden(Amy, 1000, 2023)).
}
//#violated not commons-waarde-aangeboden-moet-herleidbaar-zijn-tot-commerciele-waarde(deelnemer(Amy), beheerder(Ecoraad), commons-waarde-aangeboden(deelnemer(Amy), waarde(1000), jaar(2023))).

// Bob biedt iets aan maar geeft een niet-afleidbare waarde
{
    -commons-waarde-aangeboden(Bob, 0, 2023). +commons-waarde-aangeboden(Bob, 500, 2023).
}
//#violated commons-waarde-aangeboden-moet-herleidbaar-zijn-tot-commerciele-waarde(deelnemer(Bob), beheerder(Ecoraad), commons-waarde-aangeboden(deelnemer(Bob), waarde(500), jaar(2023))).
