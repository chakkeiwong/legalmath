//
// Description:
//   Scenario dat een paar voorbeelden toont voor
//   `dienst-niet-commercieel-gebruiken` uit artikel 7.13.
//

#require "../../artikel7/artikel7.13.eflint".


///// SCENARIO /////
// Er is een huidig jaar
+huidig-jaar(2023).

// Er is een beheerder
+beheerder(Ecoraad).

// Er zijn twee partijen
+deelnemer(Amy).
+deelnemer(Bob).

// Er zijn twee diensten
+dienst("Appel").
+dienst("Banaan").

// Amy gebruikt data voor een wettelijke doeleinden
+dienst-gebruik("Appels uitdelen aan voedselbanken").
+dienst-aanwending(Amy, "Appel", "Appels uitdelen aan voedselbanken").
//#violated not dienst-juist-gebruiken(deelnemer(Amy), beheerder(Ecoraad), dienst-aanwending(deelnemer(Amy), dienst("Appel"), data-gebruik("Appels uitdelen aan voedselbanken"))).

// Bob, echter, gebruikt de banaan voor criminele redenen! Boooob!
+dienst-gebruik("Bananen weggooien bij het plastic").
+dienst-gebruik-in-strijd-met-wet(dienst-gebruik("Bananen weggooien bij het plastic")).
+dienst-aanwending(Bob, "Banaan", "Bananen weggooien bij het plastic").
//#violated dienst-juist-gebruiken(deelnemer(Bob), beheerder(Ecoraad), dienst-aanwending(deelnemer(Bob), dienst("Banaan"), dienst-gebruik("Bananen weggooien bij het plastic"))).
