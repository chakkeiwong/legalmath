// Description:
//   Representeert een afgenomen overeenkomst (i.e., een afgenomen aanbod).
//

#require "overeenkomst.eflint".


///// REGELS /////
/// Representeert dat een overeenkomst is afgenomen.
Fact transactie Identified by id * overeenkomst.
Extend Fact id
    Derived from (Foreach transactie: transactie.id).





///// ASSERTIONS /////
/// We willen liever geen overlappende IDs.
Invariant unieke-transactie-ids
    When (Forall transactie1:
        Not(Exists transactie2:
            transactie1.id == transactie2.id
            && transactie1 != transactie2
        )
    ).
