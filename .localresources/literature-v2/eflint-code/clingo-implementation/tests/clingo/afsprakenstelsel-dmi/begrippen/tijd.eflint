///// LIBRARY /////
// Defininieert een jaartal.
Fact jaar Identified by Int.

/// Specificeert welk jaar de huidige is.
Var huidig-jaar Identified by jaar.
Extend Fact jaar
    Derived from (Foreach huidig-jaar : huidig-jaar.jaar).
