#require "deelnemer.eflint".
#require "dienst.eflint".


///// LIBRARY /////
/// Benoemt hoe data gebruikt wordt
Fact data-gebruik Identified by String.

/// Benoemt hoe een Deelnemer een bepaalde dataset gebruikt wordt voor iets.
Fact data-aanwending Identified by deelnemer * data * data-gebruik.
Extend Fact deelnemer
    Derived from (Foreach data-aanwending : data-aanwending.deelnemer).
Extend Fact data
    Derived from (Foreach data-aanwending : data-aanwending.data).
Extend Fact data-gebruik
    Derived from (Foreach data-aanwending : data-aanwending.data-gebruik).



/// Benoemt hoe diensten gebruikt worden
Fact dienst-gebruik Identified by String.

/// Benoemt dat- en hoe een Deelnemer een bepaalde dienst gebruikt (wordt) voor iets.
Fact dienst-aanwending Identified by deelnemer * dienst * dienst-gebruik.
Extend Fact deelnemer
    Derived from (Foreach dienst-aanwending : dienst-aanwending.deelnemer).
Extend Fact dienst
    Derived from (Foreach dienst-aanwending : dienst-aanwending.dienst).
Extend Fact dienst-gebruik
    Derived from (Foreach dienst-aanwending : dienst-aanwending.dienst-gebruik).
