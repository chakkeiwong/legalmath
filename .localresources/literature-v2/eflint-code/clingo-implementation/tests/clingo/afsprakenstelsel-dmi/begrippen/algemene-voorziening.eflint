#require "deelnemer.eflint".


///// LIBRARY /////
/// Een vertegenwoordiger van de Algemene Voorzieningen.
Fact algemene-voorzieningen Identified by String.

/// Stelt dat er altijd exact één beheerder moet zijn als er ook een Deelnemer bestaat
Invariant exact-een-av
    When Not(Exists deelnemer : True) || (Count(Foreach algemene-voorzieningen : algemene-voorzieningen) == 1).
