//
// Description:
//   Implementeert optionele uitbreidingen voor het Afsprakenstelsel die
//   automatisch afleiden dat elk aanbod wordt aangeboden in de Producten en
//   Diensten Catalogus (PDC), en wordt afgenomen via de Algemene Voorzieningen
//   (AV).
//

#require "../artikel7/artikel7.4.eflint".


///// REGELS /////
Extend Fact aanbod-in
    Derived from (Foreach aanbod :
        aanbod-in(aanbod, catalogus("Producten en Diensten Catalogus"))
    ).

Extend Fact aanbod-via
    Derived from (Foreach aanbod :
        aanbod-via(aanbod, plaats("Algemene Voorzieningen"))
    ).
