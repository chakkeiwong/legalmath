%YAML 1.2
---
# See http://www.sublimetext.com/docs/3/syntax.html
file_extensions:
  - eflint
scope: source

contexts:
  # The prototype context is prepended to all contexts but those setting
  # meta_include_prototype: false.
  prototype:
    - include: comments

  main:
    # The main context is the initial starting point of our syntax.
    # Include other contexts from here (or specify them directly).
    - include: numbers
    - include: clauses1
    - include: wordoperators
    - include: operator2
    - include: strings
    - include: types
    - include: operator1
    - include: clauses2
    - include: consts
    - include: capsliteral

  numbers:
    - match: '\b(-)?[0-9.]+|True|False\b'
      scope: entity.name.type
      
      
  clauses1:
    - match: '\b(Present\s+when|When|Holder|Claimant|Violated\s+when|Derived\s+from|Conditioned\s+by|Syncs\s+with|Identified\s+by|Holds\s+when|Creates|Terminates|Obfuscates|Actor|Recipient|Related\s+to|With)'
      scope: constant.language

  wordoperators:
    - match: '\b(Where|Exists|Forall|Foreach|Enabled|Holds|Sum|Max|Min|Count)'
      scope: entity.name

  comments:
    # Comments begin with a '//' and finish at the end of the line.
    - match: '//'
      scope: punctuation.definition.comment.example-c
      push:
        # This is an anonymous context push for brevity.
        - meta_scope: comment.line.double-slash.example-c
        - match: $\n?
          pop: true

  strings:
    # Strings begin and end with quotes, and use backslashes as an escape
    # character.
    - match: '"'
      scope: punctuation.definition.string.begin.example-c
      push: inside_string

  inside_string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.double.example-c
    - match: '\.'
      scope: constant.character.escape.example-c
    - match: '"'
      scope: punctuation.definition.string.end.example-c
      pop: true

  clauses2:
    - match: '\b(For)'
      scope: constant.language

  consts:
    - match: '\(|\)'
      scope: support.constant

  operator2:
    - match: '<=|>=|:|<|>|!=|\.\.|==|\.|\+|\~|\*|,|\|\||\&\&|'
      scope: keyword.operator

  operator1:
    - match: '#include|#require|!|\?|Atom|Int|Time|Current\s+Time|String|Boolean'
      scope: keyword.operator

  types:
    - match: '\b(Placeholder|Extend|Invariant|Fact|Act|Event|Duty|Bool|Function|Var|Predicate|Physical)\b'
      scope: keyword.control.example-c

  capsliteral:
    - match: '[A-Z]([a-z]|[A-Z]|_|[0-9])*'
      scope: string
