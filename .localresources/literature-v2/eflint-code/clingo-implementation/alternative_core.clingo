state(1).
state(S) :- in(F, S).
state(S - 1) :- state(S), 1 < S.
:- state(S), not 0 < S.
in(F, S + 1) :- in((add, F), S), not in((rem, F), S), state(S + 1).
in((add, F), S + 1) :- in((add, F), S), not in((rem, F), S), state(S + 1).

in((add, (holds, X)), S) :- in((create, X), S).
in((holds, X), S) :- in((derived, X), S).
