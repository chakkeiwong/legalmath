{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalmath.invalid/interpretation/v1/coverage",
  "title": "Proposed interpretation.v1 coverage",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "interpretation.v1"
    },
    "coverage_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
    },
    "source_packet_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inventory_unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "disposition": {
            "enum": [
              "IMPLEMENTED",
              "CONTEXT",
              "DEFINITION_DEPENDENCY",
              "SEPARATE_OBLIGATION",
              "OUT_OF_SCOPE_REVIEWED",
              "UNRESOLVED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "target_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "unit_id",
          "locator",
          "disposition",
          "reason",
          "target_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_dependency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "acquired_dependency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "identified_family_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "explored_family_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "inventory_review_status": {
      "enum": [
        "UNREVIEWED",
        "SYNTHETIC_FIXTURE",
        "REVIEWED"
      ]
    },
    "review_decision_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "coverage_id",
    "run_id",
    "source_packet_hash",
    "inventory_unit_ids",
    "dispositions",
    "required_dependency_ids",
    "acquired_dependency_ids",
    "identified_family_ids",
    "explored_family_ids",
    "inventory_review_status",
    "review_decision_id"
  ],
  "additionalProperties": false
}
