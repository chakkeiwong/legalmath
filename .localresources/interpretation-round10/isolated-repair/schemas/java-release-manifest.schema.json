{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalmath.invalid/spec/0.1/java-release-manifest",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "JavaReleaseManifest"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_report_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "const": "RuleIR-0.1"
    },
    "applicability_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "record_type",
    "bundle_hash",
    "build_manifest_hash",
    "verification_report_hash",
    "profile",
    "applicability_hash",
    "valid_from",
    "valid_until"
  ],
  "additionalProperties": false
}
