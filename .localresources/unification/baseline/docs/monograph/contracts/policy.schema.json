{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalmath.invalid/interpretation/v1/policy",
  "title": "Proposed interpretation.v1 policy",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "interpretation.v1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
    },
    "use": {
      "enum": [
        "DETERMINISTIC_FIXTURE_ONLY",
        "PAID_RUN"
      ]
    },
    "max_initial_actions": {
      "type": "integer",
      "minimum": 1
    },
    "max_resolution_rounds": {
      "type": "integer",
      "minimum": 1
    },
    "max_actions_per_issue_root": {
      "type": "integer",
      "minimum": 1
    },
    "max_actions_total": {
      "type": "integer",
      "minimum": 1
    },
    "max_no_progress_rounds": {
      "type": "integer",
      "minimum": 1
    },
    "action_timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "run_deadline_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1
    },
    "max_argument_nodes": {
      "type": "integer",
      "minimum": 1
    },
    "max_dependency_depth": {
      "type": "integer",
      "minimum": 1
    },
    "token_cap": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_cap_minor_units": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "billing_currency": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "required_initial_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "mandatory_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "unknown_materiality_blocks": {
      "const": true
    },
    "provider_retries": {
      "const": "DISABLED_OR_SEPARATELY_RESERVED"
    },
    "production_default": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "use",
    "max_initial_actions",
    "max_resolution_rounds",
    "max_actions_per_issue_root",
    "max_actions_total",
    "max_no_progress_rounds",
    "action_timeout_seconds",
    "run_deadline_seconds",
    "max_candidates",
    "max_argument_nodes",
    "max_dependency_depth",
    "token_cap",
    "cost_cap_minor_units",
    "billing_currency",
    "required_initial_roles",
    "mandatory_checks",
    "unknown_materiality_blocks",
    "provider_retries",
    "production_default"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "use": {
            "const": "PAID_RUN"
          }
        }
      },
      "then": {
        "properties": {
          "token_cap": {
            "type": "integer",
            "minimum": 1
          },
          "cost_cap_minor_units": {
            "type": "integer",
            "minimum": 1
          },
          "billing_currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      }
    }
  ]
}
