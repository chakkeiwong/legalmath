.venv
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
*.egg-info/
/build/
/dist/
artifacts/workbench/

# Local execution environments and agent configuration.
.agents/
.codex/
.env
.env.*
!.env.example
.localresources/java-toolchain
.localresources/browser/
artifacts/interpretation/workbench/
artifacts/interpretation/round1/.lock
artifacts/interpretation/round11/.lock
.localresources/assurance-tools/
artifacts/interpretation/round11/**/work/
artifacts/interpretation/round1/**/package/installed/
artifacts/interpretation/multi-circular-round1/**/work/

# Rebuildable LaTeX scratch files; retain manuscripts, PDFs and review evidence.
/docs/**/*.aux
/docs/**/*.blg
/docs/**/*.fdb_latexmk
/docs/**/*.fls
/docs/**/*.log
/docs/**/*.toc
/docs/**/*.xdv
/docs/**/*.out
/docs/**/*.synctex.gz

# SQLite runtime journals are not portable evidence snapshots.
*.sqlite3-wal
*.sqlite3-shm

# Rebuildable isolated Catala toolchain.
.localresources/catala-toolchain

# Superseded Catala evidence drafts are inventoried, never used as results.
/artifacts/catala/gap-closure/drafts/
/artifacts/catala/modular-translation/drafts/

# Full regression scratch; selected compiler builds and exact checks are retained.
/artifacts/catala/translator-completion/regression-work*/

# The prospectus controller recreates this runtime lock locally.
/docs/implementation/prospectus-evidence-closure/.lock
/docs/implementation/prospectus-closure-2026-10-05/.lock
/docs/implementation/prospectus-closure-refresh-2026-10-05/.lock
/docs/implementation/prospectus-basf-continuation-2026-10-05/.lock

/docs/implementation/prospectus-successor-2026-10-06/controller.lock
/docs/implementation/prospectus-repair-2026-10-06/controller.lock
/docs/implementation/prospectus-adoption/controller.lock

# Hash-bound local input snapshots duplicate retained PDFs and model weights.
# Preserve them locally; the adoption snapshot manifest records reconstruction.
/docs/implementation/prospectus-adoption/snapshots/
!/docs/implementation/prospectus-adoption/**/*.log

# Phase logs are evidence inputs to receipts, unlike LaTeX scratch logs.
!/docs/implementation/prospectus-repair-2026-10-06/**/*.log

