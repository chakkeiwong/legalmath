# Rebuildable LaTeX scratch files; retain manuscripts, PDFs and review evidence.
/docs/**/*.aux
/docs/**/*.blg
/docs/**/*.fdb_latexmk
/docs/**/*.fls
/docs/**/*.log
/docs/**/*.toc
/docs/**/*.xdv
/docs/**/*.out
/docs/**/*.synctex.gz

# SQLite runtime journals are not portable evidence snapshots.
*.sqlite3-wal
*.sqlite3-shm

# Rebuildable isolated Catala toolchain.
.localresources/catala-toolchain/

# Superseded Catala evidence drafts are inventoried, never used as results.
/artifacts/catala/gap-closure/drafts/
/artifacts/catala/modular-translation/drafts/
